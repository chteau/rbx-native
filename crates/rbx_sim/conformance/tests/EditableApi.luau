-- EditableImage and EditableMesh on a server: creation and its limits,
-- pixels read, written and drawn, a mesh built and queried, Content
-- holding them.
return function(h)
	local AssetService = game:GetService("AssetService")
	local r = {}

	local function pixel(image, x, y)
		local b = image:ReadPixelsBuffer(Vector2.new(x, y), Vector2.new(1, 1))
		return string.format("%d,%d,%d,%d", buffer.readu8(b, 0), buffer.readu8(b, 1), buffer.readu8(b, 2), buffer.readu8(b, 3))
	end
	local function sum(image)
		local size = image.Size
		local b = image:ReadPixelsBuffer(Vector2.zero, size)
		local total = 0
		for i = 0, buffer.len(b) - 1 do
			total += buffer.readu8(b, i)
		end
		return total
	end

	r.image_new = h.try(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(16, 16) })
	end)
	r.image_default = h.try(function()
		return AssetService:CreateEditableImage().Size
	end)
	r.image_huge = h.try(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(2048, 16) })
	end)
	r.image_zero = h.try(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(0, 16) })
	end)
	local ok, image = pcall(function()
		return AssetService:CreateEditableImage({ Size = Vector2.new(16, 16) })
	end)
	if ok and image then
		r.size = h.show(image.Size)
		r.blank = pixel(image, 0, 0)
		r.buffer_len = buffer.len(image:ReadPixelsBuffer(Vector2.zero, Vector2.new(16, 16)))
		r.read_outside = h.try(function()
			return image:ReadPixelsBuffer(Vector2.new(10, 10), Vector2.new(10, 10))
		end)
		r.write_short = h.try(function()
			image:WritePixelsBuffer(Vector2.zero, Vector2.new(4, 4), buffer.create(10))
		end)
		local b = buffer.create(4 * 4 * 4)
		for i = 0, 15 do
			buffer.writeu8(b, i * 4, 10 * i)
			buffer.writeu8(b, i * 4 + 1, 20)
			buffer.writeu8(b, i * 4 + 2, 30)
			buffer.writeu8(b, i * 4 + 3, 255)
		end
		r.write = h.try(function()
			image:WritePixelsBuffer(Vector2.new(2, 2), Vector2.new(4, 4), b)
		end)
		r.written = pixel(image, 5, 2)
		r.rect = h.try(function()
			image:DrawRectangle(Vector2.new(8, 8), Vector2.new(4, 4), Color3.new(1, 0, 0), 0, Enum.ImageCombineType.Overwrite)
		end)
		r.rect_in = pixel(image, 9, 9)
		r.rect_edge = pixel(image, 12, 12)
		r.rect_blend = h.try(function()
			image:DrawRectangle(Vector2.new(8, 8), Vector2.new(2, 2), Color3.new(0, 0, 1), 0.5, Enum.ImageCombineType.BlendSourceOver)
		end)
		r.rect_blended = pixel(image, 8, 8)
		r.rect_alpha = h.try(function()
			image:DrawRectangle(Vector2.new(0, 12), Vector2.new(2, 2), Color3.new(0, 1, 0), 0.5, Enum.ImageCombineType.AlphaBlend)
		end)
		r.rect_alphad = pixel(image, 0, 12)
		r.circle = h.try(function()
			image:DrawCircle(Vector2.new(4, 12), 2, Color3.new(1, 1, 1), 0, Enum.ImageCombineType.Overwrite)
		end)
		r.circle_center = pixel(image, 4, 12)
		r.circle_edge = pixel(image, 6, 12)
		r.circle_out = pixel(image, 7, 12)
		r.line = h.try(function()
			image:DrawLine(Vector2.new(0, 0), Vector2.new(15, 0), Color3.new(0, 1, 1), 0, Enum.ImageCombineType.Overwrite)
		end)
		r.line_mid = pixel(image, 7, 0)
		r.line_end = pixel(image, 15, 0)
		r.line_off = pixel(image, 7, 1)
		r.sum = sum(image)
		local small = AssetService:CreateEditableImage({ Size = Vector2.new(2, 2) })
		small:DrawRectangle(Vector2.zero, Vector2.new(2, 2), Color3.new(1, 1, 0), 0, Enum.ImageCombineType.Overwrite)
		r.draw_image = h.try(function()
			image:DrawImage(Vector2.new(14, 14), small, Enum.ImageCombineType.Overwrite)
		end)
		r.drawn_image = pixel(image, 15, 15)
		r.draw_image_clipped = h.try(function()
			image:DrawImage(Vector2.new(15, 7), small, Enum.ImageCombineType.Overwrite)
		end)
		r.sum_after = sum(image)
		r.content = h.try(function()
			return Content.fromObject(image).SourceType
		end)
		r.label = h.try(function()
			local label = Instance.new("ImageLabel")
			label.ImageContent = Content.fromObject(image)
			return label.ImageContent.SourceType
		end)
		image:Destroy()
		r.destroyed_read = h.try(function()
			return image:ReadPixelsBuffer(Vector2.zero, Vector2.one)
		end)
	end

	-- EditableMesh.
	r.mesh_new = h.try(function()
		return AssetService:CreateEditableMesh()
	end)
	local okMesh, mesh = pcall(function()
		return AssetService:CreateEditableMesh()
	end)
	if okMesh and mesh then
		r.fixed = h.show(mesh.FixedSize)
		local v = {}
		for i, p in { Vector3.new(0, 0, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(1, 0, 1) } do
			v[i] = mesh:AddVertex(p)
		end
		r.vertex_type = typeof(v[1])
		r.vertex_distinct = v[1] ~= v[2] and v[2] ~= v[3]
		local f1 = mesh:AddTriangle(v[1], v[3], v[2])
		local f2 = mesh:AddTriangle(v[2], v[3], v[4])
		r.face_type = typeof(f1)
		r.faces = #mesh:GetFaces()
		r.vertices = #mesh:GetVertices()
		r.normals = #mesh:GetNormals()
		r.uvs = #mesh:GetUVs()
		r.colors = #mesh:GetColors()
		r.face_normals = h.try(function()
			return #mesh:GetFaceNormals(f1)
		end)
		r.face_uvs = h.try(function()
			return #mesh:GetFaceUVs(f1)
		end)
		r.position = h.show(mesh:GetPosition(v[4]))
		r.mesh_size = h.try(function()
			return mesh:GetSize()
		end)
		r.center = h.try(function()
			return mesh:GetCenter()
		end)
		r.bad_triangle = h.try(function()
			return mesh:AddTriangle(v[1], v[2], 123456)
		end)
		r.bad_position = h.try(function()
			return mesh:GetPosition(987654)
		end)
		local n = mesh:AddNormal(Vector3.new(0, 1, 0))
		local uv = mesh:AddUV(Vector2.new(0.5, 0.5))
		local c = mesh:AddColor(Color3.new(1, 0, 0), 0.5)
		r.normal_type = typeof(n)
		r.set_face_normals = h.try(function()
			mesh:SetFaceNormals(f1, { n, n, n })
			return mesh:GetNormal(mesh:GetFaceNormals(f1)[1])
		end)
		r.set_face_uvs = h.try(function()
			mesh:SetFaceUVs(f1, { uv, uv, uv })
			return mesh:GetUV(mesh:GetFaceUVs(f1)[2])
		end)
		r.set_face_colors = h.try(function()
			mesh:SetFaceColors(f2, { c, c, c })
			return mesh:GetColor(mesh:GetFaceColors(f2)[3])
		end)
		r.color_alpha = h.try(function()
			return mesh:GetColorAlpha(c)
		end)
		r.vertex_faces = h.try(function()
			return #mesh:GetVertexFaces(v[2])
		end)
		r.adjacent = h.try(function()
			return #mesh:GetAdjacentVertices(v[1])
		end)
		r.closest = h.try(function()
			local face, point, bary = mesh:FindClosestPointOnSurface(Vector3.new(0.25, 2, 0.25))
			return string.format("%s %s %s", tostring(face == f1), h.vec(point, 3), h.vec(bary, 3))
		end)
		r.closest_vertex = h.try(function()
			return mesh:FindClosestVertex(Vector3.new(0.9, 0, 0.9)) == v[4]
		end)
		r.within = h.try(function()
			return #mesh:FindVerticesWithinSphere(Vector3.zero, 1.01)
		end)
		r.ray = h.try(function()
			local point, face, bary = mesh:RaycastLocal(Vector3.new(0.75, 5, 0.75), Vector3.new(0, -10, 0))
			return string.format("%s %s %s", point and h.vec(point, 3) or "nil", tostring(face == f2), bary and h.vec(bary, 3) or "nil")
		end)
		r.ray_miss = h.try(function()
			return mesh:RaycastLocal(Vector3.new(5, 5, 5), Vector3.new(0, -10, 0))
		end)
		r.remove_face = h.try(function()
			mesh:RemoveFace(f2)
			return #mesh:GetFaces()
		end)
		r.remove_unused = h.try(function()
			mesh:RemoveUnused()
			return #mesh:GetVertices()
		end)
		r.meshpart = h.try(function()
			local part = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))
			return part.Size
		end)
		r.mesh_content = h.try(function()
			return Content.fromObject(mesh).SourceType
		end)
		r.fixed_mesh = h.try(function()
			local fixed = AssetService:CreateEditableMesh({ FixedSize = true })
			return fixed.FixedSize
		end)
	end
	return r
end
