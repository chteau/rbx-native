-- Path2D's control points and curve maths on a live server, in offsets
-- only so the parent's size doesn't matter.
return function(h)
	local r = {}
	local gui = Instance.new("ScreenGui")
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromOffset(400, 300)
	frame.Parent = gui
	local path = Instance.new("Path2D")
	path.Parent = frame
	gui.Parent = workspace
	local P = Path2DControlPoint.new
	local changed = 0
	path.ControlPointChanged:Connect(function(...)
		changed += 1
		r.changed_args = select("#", ...)
	end)
	r.point_default = h.try(function()
		return tostring(P())
	end)
	r.point_fields = h.try(function()
		local p = P(UDim2.fromOffset(1, 2), UDim2.fromOffset(3, 4), UDim2.fromOffset(5, 6))
		return tostring(p.Position) .. " | " .. tostring(p.LeftTangent) .. " | " .. tostring(p.RightTangent)
	end)
	r.max = h.try(function()
		return path:GetMaxControlPoints()
	end)
	r.empty_length = h.try(function()
		return path:GetLength()
	end)
	r.empty_pos = h.try(function()
		return tostring(path:GetPositionOnCurve(0.5))
	end)
	path:SetControlPoints({
		P(UDim2.fromOffset(0, 0), UDim2.fromOffset(0, 0), UDim2.fromOffset(50, 0)),
		P(UDim2.fromOffset(100, 100), UDim2.fromOffset(0, -50), UDim2.fromOffset(0, 50)),
		P(UDim2.fromOffset(200, 100)),
	})
	task.wait()
	r.changed_set = changed
	r.count = #path:GetControlPoints()
	r.get1 = h.try(function()
		return tostring(path:GetControlPoint(1).Position)
	end)
	r.get0 = h.try(function()
		return tostring(path:GetControlPoint(0).Position)
	end)
	r.get9 = h.try(function()
		return tostring(path:GetControlPoint(9))
	end)
	r.length = h.try(function()
		return h.round(path:GetLength(), 2)
	end)
	for _, t in { 0, 0.25, 0.5, 0.75, 1 } do
		r["pos_" .. t] = h.try(function()
			return tostring(path:GetPositionOnCurve(t))
		end)
		r["arc_" .. t] = h.try(function()
			return tostring(path:GetPositionOnCurveArcLength(t))
		end)
		r["tan_" .. t] = h.try(function()
			local v = path:GetTangentOnCurve(t)
			return h.round(v.X, 3) .. "," .. h.round(v.Y, 3)
		end)
		r["arctan_" .. t] = h.try(function()
			local v = path:GetTangentOnCurveArcLength(t)
			return h.round(v.X, 3) .. "," .. h.round(v.Y, 3)
		end)
	end
	r.pos_over = h.try(function()
		return tostring(path:GetPositionOnCurve(1.5))
	end)
	r.rect = h.try(function()
		local rect = path:GetBoundingRect()
		return string.format("%s,%s %s,%s", h.round(rect.Min.X, 2), h.round(rect.Min.Y, 2), h.round(rect.Max.X, 2), h.round(rect.Max.Y, 2))
	end)
	r.insert = h.try(function()
		path:InsertControlPoint(1, P(UDim2.fromOffset(-10, 0)))
		return tostring(path:GetControlPoint(1).Position) .. " " .. tostring(path:GetControlPoint(2).Position)
	end)
	r.insert_end = h.try(function()
		path:InsertControlPoint(5, P(UDim2.fromOffset(300, 0)))
		return #path:GetControlPoints()
	end)
	r.insert_bad = h.try(function()
		path:InsertControlPoint(9, P())
	end)
	r.update = h.try(function()
		path:UpdateControlPoint(2, P(UDim2.fromOffset(7, 7)))
		return tostring(path:GetControlPoint(2).Position)
	end)
	r.update_bad = h.try(function()
		path:UpdateControlPoint(0, P())
	end)
	r.remove = h.try(function()
		path:RemoveControlPoint(1)
		return #path:GetControlPoints() .. " " .. tostring(path:GetControlPoint(1).Position)
	end)
	r.remove_bad = h.try(function()
		path:RemoveControlPoint(20)
	end)
	r.closed_length = h.try(function()
		path:SetControlPoints({ P(UDim2.fromOffset(0, 0)), P(UDim2.fromOffset(100, 0)), P(UDim2.fromOffset(100, 100)) })
		local open = path:GetLength()
		path.Closed = true
		return h.round(open, 2) .. " " .. h.round(path:GetLength(), 2) .. " " .. tostring(path:GetPositionOnCurve(0.75))
	end)
	r.scale_pos = h.try(function()
		path.Closed = false
		path:SetControlPoints({ P(UDim2.new(0, 0, 0, 0)), P(UDim2.new(0.5, 10, 1, 0)) })
		return tostring(path:GetPositionOnCurve(0.5)) .. " " .. h.round(path:GetLength(), 2)
	end)
	task.wait()
	r.changed_total = changed
	gui:Destroy()
	return r
end
