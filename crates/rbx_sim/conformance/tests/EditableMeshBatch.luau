-- EditableMesh's batch methods on a server: adding, reading and writing
-- many elements per call, and how a bad id or a length mismatch fails.
return function(h)
	local AssetService = game:GetService("AssetService")
	local MA = Enum.MeshAttribute
	local r = {}
	local mesh = AssetService:CreateEditableMesh()
	local function names(ids)
		local out = {}
		for i, id in ids do
			out[i] = if type(id) == "table" then "{" .. names(id) .. "}" else mesh:IdDebugString(id)
		end
		return table.concat(out, " ")
	end
	local function shows(values)
		local out = {}
		for i, v in values do
			out[i] = h.show(v)
		end
		return table.concat(out, " ")
	end

	local v = mesh:BatchAdd(MA.Vertex, { Vector3.new(0, 0, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(1, 0, 1) })
	r.add_vertices = names(v)
	r.counts_after_vertices = string.format("%d %d %d %d", #mesh:GetVertices(), #mesh:GetNormals(), #mesh:GetUVs(), #mesh:GetColors())
	local f = mesh:BatchAdd(MA.Face, { { v[1], v[3], v[2] }, { v[2], v[3], v[4] } })
	r.add_faces = names(f)
	r.add_quad = h.try(function()
		return names(mesh:BatchAdd(MA.Face, { { v[1], v[2], v[4], v[3] } }))
	end)
	local n = mesh:BatchAdd(MA.Normal, { Vector3.new(0, 1, 0), Vector3.new(1, 0, 0) })
	r.add_normals = names(n)
	local uv = mesh:BatchAdd(MA.UV, { Vector2.new(0, 0), Vector2.new(1, 1) })
	r.add_uvs = names(uv)
	r.add_colors = h.try(function()
		return names(mesh:BatchAdd(MA.Color, { Color3.new(1, 0, 0), Color3.new(0, 1, 0) }))
	end)
	r.add_colors_alpha = h.try(function()
		return names(mesh:BatchAdd(MA.Color, { { Color3.new(1, 0, 0), 0.5 } }))
	end)
	r.add_empty = h.try(function()
		return #mesh:BatchAdd(MA.Vertex, {})
	end)
	r.add_wrong_type = h.try(function()
		return mesh:BatchAdd(MA.Vertex, { Vector2.new(1, 1) })
	end)
	r.add_bad_face = h.try(function()
		return mesh:BatchAdd(MA.Face, { { v[1], v[2], v[3] }, { v[1], v[2], 77 } })
	end)
	r.after_bad_face = #mesh:GetFaces()

	r.get_positions = h.try(function()
		return shows(mesh:BatchGetValues(v))
	end)
	r.get_normals = h.try(function()
		return shows(mesh:BatchGetValues(n))
	end)
	r.get_uvs = h.try(function()
		return shows(mesh:BatchGetValues(uv))
	end)
	r.get_colors = h.try(function()
		local colors, alphas = mesh:BatchGetValues(mesh:GetFaceColors(f[1]))
		return shows(colors) .. " | " .. table.concat(alphas, " ")
	end)
	r.get_empty = h.try(function()
		return select("#", mesh:BatchGetValues({}))
	end)
	r.get_mixed = h.try(function()
		return mesh:BatchGetValues({ v[1], n[1] })
	end)
	r.get_bad = h.try(function()
		return mesh:BatchGetValues({ v[1], 55 })
	end)

	r.set_positions = h.try(function()
		mesh:BatchSetValues({ v[1], v[2] }, { Vector3.new(0, 1, 0), Vector3.new(2, 1, 0) })
		return h.show(mesh:GetPosition(v[2]))
	end)
	r.set_alphas = h.try(function()
		local c = mesh:GetFaceColors(f[1])
		mesh:BatchSetValues({ c[1] }, { 0.25 })
		return mesh:GetColorAlpha(c[1])
	end)
	r.set_colors = h.try(function()
		local c = mesh:GetFaceColors(f[1])
		mesh:BatchSetValues({ c[2] }, { Color3.new(0, 0, 1) })
		return h.show(mesh:GetColor(c[2]))
	end)
	r.set_reset_normals = h.try(function()
		mesh:BatchSetValues({ n[1] }, nil)
		return h.show(mesh:GetNormal(n[1]))
	end)
	r.set_length = h.try(function()
		mesh:BatchSetValues({ v[1], v[2] }, { Vector3.zero })
	end)
	r.set_partial = h.try(function()
		mesh:BatchSetValues({ v[3], 999, v[4] }, { Vector3.new(9, 9, 9), Vector3.zero, Vector3.new(8, 8, 8) })
	end)
	r.after_partial = h.show(mesh:GetPosition(v[3])) .. " " .. h.show(mesh:GetPosition(v[4]))
	r.set_mixed_colors = h.try(function()
		local c = mesh:GetFaceColors(f[1])
		mesh:BatchSetValues({ c[1], c[2] }, { Color3.new(), 0.5 })
	end)

	r.face_attrs_vertex = h.try(function()
		return names(mesh:BatchGetFaceAttributes(MA.Vertex, f))
	end)
	r.face_attrs_normal = h.try(function()
		return #mesh:BatchGetFaceAttributes(MA.Normal, f)[2]
	end)
	r.face_attrs_face = h.try(function()
		return mesh:BatchGetFaceAttributes(MA.Face, f)
	end)
	r.set_face_attrs = h.try(function()
		mesh:BatchSetFaceAttributes({ f[1] }, { { n[2], n[2], n[2] } })
		return names(mesh:GetFaceNormals(f[1]))
	end)
	r.set_face_attrs_vertices = h.try(function()
		mesh:BatchSetFaceAttributes({ f[2] }, { { v[2], v[4], v[3] } })
		return names(mesh:GetFaceVertices(f[2]))
	end)
	r.set_face_attrs_short = h.try(function()
		mesh:BatchSetFaceAttributes({ f[1] }, { { n[1] } })
	end)
	r.vertex_attrs_face = h.try(function()
		return names(mesh:BatchGetVertexAttributes(MA.Face, { v[2], v[1] }))
	end)
	r.vertex_attrs_uv = h.try(function()
		return names(mesh:BatchGetVertexAttributes(MA.UV, { v[3] }))
	end)
	r.vertex_attrs_vertex = h.try(function()
		return names(mesh:BatchGetVertexAttributes(MA.Vertex, { v[2] }))
	end)
	r.vertex_face_attrs = h.try(function()
		return names(mesh:BatchGetVertexFaceAttributes(MA.Normal, { v[1], v[3] }, { f[1], f[1] }))
	end)
	r.set_vertex_face_attrs = h.try(function()
		mesh:BatchSetVertexFaceAttributes({ v[3] }, { f[2] }, { uv[2] })
		return h.show(mesh:GetUV(mesh:GetVertexFaceUV(v[3], f[2])))
	end)
	r.set_vertex_face_attrs_off = h.try(function()
		mesh:BatchSetVertexFaceAttributes({ v[1] }, { f[2] }, { uv[2] })
	end)
	r.remove = h.try(function()
		mesh:BatchRemove({ f[1] })
		return #mesh:GetFaces()
	end)
	r.remove_bad = h.try(function()
		mesh:BatchRemove({ f[2], v[1] })
		return #mesh:GetFaces()
	end)
	r.after_remove_bad = #mesh:GetFaces()
	r.remove_vertices = h.try(function()
		mesh:BatchRemove({ v[1] })
	end)
	r.add_limit = h.try(function()
		local big = AssetService:CreateEditableMesh()
		local points = table.create(60001, Vector3.zero)
		big:BatchAdd(MA.Vertex, points)
		return #big:GetVertices()
	end)
	r.fixed_batch_add = h.try(function()
		local fixed = AssetService:CreateEditableMeshAsync(Content.fromObject(mesh))
		return fixed:BatchAdd(MA.Vertex, { Vector3.zero })
	end)
	r.fixed_batch_set = h.try(function()
		local fixed = AssetService:CreateEditableMeshAsync(Content.fromObject(mesh))
		local ids = fixed:GetVertices()
		fixed:BatchSetValues({ ids[1] }, { Vector3.new(4, 4, 4) })
		return h.show(fixed:GetPosition(ids[1]))
	end)
	return r
end
