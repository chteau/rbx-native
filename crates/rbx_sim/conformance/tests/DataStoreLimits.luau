-- DataStoreService's argument checks, value rules and limits on a server:
-- the message of every error a bad call gives (empty and long keys, names
-- and scopes, values JSON can't hold, too big a value, bad metadata and
-- user ids, a non-integer increment, ordered stores' integer rule, bad
-- page sizes) and the request budgets a fresh server starts with. Calls
-- that write go to keys prefixed `localrun_m12_` in a scope of their own,
-- removed at the end.
return function(h)
	local DataStoreService = game:GetService("DataStoreService")
	local HttpService = game:GetService("HttpService")
	local result = {}
	local function err(f)
		local ok, message = pcall(f)
		return ok and "ok" or (tostring(message):gsub("^.-:%d+: ", ""))
	end
	for _, kind in Enum.DataStoreRequestType:GetEnumItems() do
		local ok, budget = pcall(DataStoreService.GetRequestBudgetForRequestType, DataStoreService, kind)
		result["_budget_" .. kind.Name] = ok and budget or -1
	end
	local scope = "localrun_m12_" .. HttpService:GenerateGUID(false):sub(1, 8)
	local store = DataStoreService:GetDataStore("localrun_m12_limits", scope)
	local ordered = DataStoreService:GetOrderedDataStore("localrun_m12_limits_ordered", scope)
	local key = "localrun_m12_value"

	result.name_empty = err(function()
		DataStoreService:GetDataStore("")
	end)
	result.name_long = err(function()
		DataStoreService:GetDataStore(string.rep("n", 51))
	end)
	result.name_50 = err(function()
		DataStoreService:GetDataStore(string.rep("n", 50))
	end)
	result.scope_long = err(function()
		DataStoreService:GetDataStore("localrun_m12_x", string.rep("s", 51))
	end)
	result.scope_empty = err(function()
		DataStoreService:GetDataStore("localrun_m12_x", "")
	end)
	result.name_number = err(function()
		DataStoreService:GetDataStore(5)
	end)
	result.name_nil = err(function()
		DataStoreService:GetDataStore(nil)
	end)
	result.ordered_name_long = err(function()
		DataStoreService:GetOrderedDataStore(string.rep("n", 51))
	end)
	result.key_empty = err(function()
		store:GetAsync("")
	end)
	result.key_long = err(function()
		store:GetAsync(string.rep("k", 51))
	end)
	result.key_50 = err(function()
		store:GetAsync("localrun_m12_" .. string.rep("k", 37))
	end)
	result.key_nil = err(function()
		store:GetAsync(nil)
	end)
	result.key_number = err(function()
		store:GetAsync(12)
	end)
	result.set_key_long = err(function()
		store:SetAsync(string.rep("k", 51), 1)
	end)
	result.set_function = err(function()
		store:SetAsync(key, function() end)
	end)
	result.set_instance = err(function()
		store:SetAsync(key, workspace)
	end)
	result.set_vector3 = err(function()
		store:SetAsync(key, Vector3.new(1, 2, 3))
	end)
	result.set_nested_vector3 = err(function()
		store:SetAsync(key, { pos = Vector3.new(1, 2, 3) })
	end)
	result.set_nan = err(function()
		store:SetAsync(key, 0 / 0)
	end)
	result.set_inf = err(function()
		store:SetAsync(key, math.huge)
	end)
	result.set_mixed = err(function()
		store:SetAsync(key, { 1, 2, x = 3 })
	end)
	result.set_bool_key = err(function()
		store:SetAsync(key, { [true] = 1 })
	end)
	result.set_bad_utf8 = err(function()
		store:SetAsync(key, "\255\254")
	end)
	result.set_cycle = err(function()
		local t = {}
		t.self = t
		store:SetAsync(key, t)
	end)
	result.set_too_big = err(function()
		store:SetAsync(key, string.rep("a", 4194304))
	end)
	result.set_userids_5 = err(function()
		store:SetAsync(key, 1, { 1, 2, 3, 4, 5 })
	end)
	result.set_userids_string = err(function()
		store:SetAsync(key, 1, { "x" })
	end)
	result.set_userids_float = err(function()
		store:SetAsync(key, 1, { 1.5 })
	end)
	result.metadata_big = err(function()
		local options = Instance.new("DataStoreSetOptions")
		options:SetMetadata({ big = string.rep("m", 400) })
		store:SetAsync(key, 1, nil, options)
	end)
	result.metadata_nested = err(function()
		local options = Instance.new("DataStoreSetOptions")
		options:SetMetadata({ inner = { 1 } })
		store:SetAsync(key, 1, nil, options)
	end)
	result.metadata_array = err(function()
		local options = Instance.new("DataStoreSetOptions")
		options:SetMetadata({ 1, 2 })
	end)
	result.set_string = err(function()
		store:SetAsync(key, "text")
	end)
	result.increment_string = err(function()
		store:IncrementAsync(key, 1)
	end)
	result.increment_float = err(function()
		store:IncrementAsync("localrun_m12_counter", 1.5)
	end)
	local ok, after = pcall(function()
		return store:GetAsync("localrun_m12_counter")
	end)
	result.increment_float_value = tostring(after)
	result.increment_bad_delta = err(function()
		store:IncrementAsync("localrun_m12_counter", "x")
	end)
	result.update_bad_return = err(function()
		store:UpdateAsync(key, function()
			return function() end
		end)
	end)
	result.update_not_function = err(function()
		store:UpdateAsync(key, 5)
	end)
	result.ordered_float = err(function()
		ordered:SetAsync("localrun_m12_a", 1.5)
	end)
	result.ordered_string = err(function()
		ordered:SetAsync("localrun_m12_a", "x")
	end)
	result.ordered_table = err(function()
		ordered:SetAsync("localrun_m12_a", {})
	end)
	result.ordered_page_0 = err(function()
		ordered:GetSortedAsync(true, 0)
	end)
	result.ordered_page_101 = err(function()
		ordered:GetSortedAsync(true, 101)
	end)
	result.ordered_min_float = err(function()
		ordered:GetSortedAsync(true, 10, 1.5)
	end)
	result.ordered_min_above_max = err(function()
		local pages = ordered:GetSortedAsync(true, 10, 5, 1)
		return #pages:GetCurrentPage()
	end)
	result.list_keys_page_0 = err(function()
		store:ListKeysAsync("", 0)
	end)
	result.version_bogus = err(function()
		store:GetVersionAsync(key, "bogus")
	end)
	result.version_at_negative = err(function()
		store:GetVersionAtTimeAsync(key, -1)
	end)
	result.list_versions_page_0 = err(function()
		store:ListVersionsAsync(key, Enum.SortDirection.Ascending, 0, 0, 0)
	end)
	result.budget_bad = err(function()
		DataStoreService:GetRequestBudgetForRequestType(5)
	end)
	result.global_name = err(function()
		return DataStoreService:GetGlobalDataStore().Name
	end)
	result.global_class = DataStoreService:GetGlobalDataStore().ClassName
	result.store_class = store.ClassName
	result.store_name = store.Name
	result.ordered_class = ordered.ClassName
	result.store_new = err(function()
		Instance.new("GlobalDataStore")
	end)
	result.options_new = err(function()
		Instance.new("DataStoreOptions")
	end)
	result.all_scopes_with_scope = err(function()
		local options = Instance.new("DataStoreOptions")
		options.AllScopes = true
		DataStoreService:GetDataStore("localrun_m12_x", "scope", options)
	end)
	pcall(store.RemoveAsync, store, key)
	pcall(store.RemoveAsync, store, "localrun_m12_counter")
	return result
end
