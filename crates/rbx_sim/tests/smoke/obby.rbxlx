      </Properties>
      <Item class="LocalScript" referent="RBX17">
        <Properties>
          <string name="Name">Jumps</string>
          <ProtectedString name="Source"><![CDATA[local player = game:GetService("Players").LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
character:WaitForChild("Humanoid").StateChanged:Connect(function(_, new)
	if new == Enum.HumanoidStateType.Jumping then
		print("jumped")
	end
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
