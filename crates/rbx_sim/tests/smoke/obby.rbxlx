  <Item class="ServerScriptService" referent="RBX16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX15">
      <Properties>
        <string name="Name">Obby</string>
        <ProtectedString name="Source"><![CDATA[local function leaderstats(player, values)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, entry in values do
		local value = Instance.new("IntValue")
		value.Name = entry[1]
		value.Value = entry[2]
		value.Parent = folder
	end
	folder.Parent = player
	return folder
end

local Players = game:GetService("Players")
local store = game:GetService("DataStoreService"):GetDataStore("ObbyProgress")

Players.PlayerAdded:Connect(function(player)
	local ok, saved = pcall(store.GetAsync, store, "stage_" .. player.UserId)
	print("loaded stage", ok, saved or 0)
	leaderstats(player, { { "Stage", saved or 0 } })
end)

for _, pad in workspace.Checkpoints:GetDescendants() do
	if pad:IsA("BasePart") then
		local n = tonumber(pad.Parent.Name)
		pad.Touched:Connect(function(hit)
			local player = Players:GetPlayerFromCharacter(hit.Parent)
			local stats = player and player:FindFirstChild("leaderstats")
			if stats and stats.Stage.Value == n - 1 then
				stats.Stage.Value = n
				store:SetAsync("stage_" .. player.UserId, n)
				print("checkpoint", n, "saved", store:GetAsync("stage_" .. player.UserId))
			end
		end)
	end
end
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX19">
