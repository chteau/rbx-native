      <Item class="LocalScript" referent="RBX10">
        <Properties>
          <string name="Name">Streamed</string>
          <ProtectedString name="Source"><![CDATA[print("streaming", workspace.StreamingEnabled)
local tower = workspace:WaitForChild("Tower", 10)
print("persistent", tower and tower.Name)
local zone = workspace:WaitForChild("FarZone", 10)
local coin = zone and zone:WaitForChild("FarCoin", 10)
print("streamed", coin and coin.Name)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
