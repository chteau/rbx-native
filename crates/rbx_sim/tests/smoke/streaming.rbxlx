  <Item class="ServerScriptService" referent="RBX9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX8">
      <Properties>
        <string name="Name">Zones</string>
        <ProtectedString name="Source"><![CDATA[local function leaderstats(player, values)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, entry in values do
		local value = Instance.new("IntValue")
		value.Name = entry[1]
		value.Value = entry[2]
		value.Parent = folder
	end
	folder.Parent = player
	return folder
end

game:GetService("Players").PlayerAdded:Connect(function(player)
	local stats = leaderstats(player, { { "Visits", 0 } })
	local character = player.Character or player.CharacterAdded:Wait()
	player:RequestStreamAroundAsync(Vector3.new(0, 3, 1500))
	print("requested stream")
	character:PivotTo(CFrame.new(0, 6, 1490))
	stats.Visits.Value += 1
end)
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX12">
