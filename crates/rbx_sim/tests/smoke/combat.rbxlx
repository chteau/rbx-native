  <Item class="ServerScriptService" referent="RBX14">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX13">
      <Properties>
        <string name="Name">Combat</string>
        <ProtectedString name="Source"><![CDATA[local function leaderstats(player, values)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	for _, entry in values do
		local value = Instance.new("IntValue")
		value.Name = entry[1]
		value.Value = entry[2]
		value.Parent = folder
	end
	folder.Parent = player
	return folder
end

local Players = game:GetService("Players")
local dummy = workspace.Dummy.Humanoid

Players.PlayerAdded:Connect(function(player)
	leaderstats(player, { { "Hits", 0 }, { "KOs", 0 } })
end)

game:GetService("ReplicatedStorage").Hit.OnServerEvent:Connect(function(player, target)
	local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
	if not tool or typeof(target) ~= "Instance" or target ~= dummy.Parent then
		warn("rejected hit from", player.Name)
		return
	end
	if dummy.Health <= 0 then
		return
	end
	dummy:TakeDamage(40)
	player.leaderstats.Hits.Value += 1
	print("hit", target.Name, dummy.Health)
	if dummy.Health <= 0 then
		player.leaderstats.KOs.Value += 1
	end
end)

dummy.Died:Connect(function()
	print("dummy down")
end)
]]></ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
