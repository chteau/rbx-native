      <Item class="LocalScript" referent="RBX10">
        <Properties>
          <string name="Name">Swing</string>
          <ProtectedString name="Source"><![CDATA[local tool = script.Parent
local hit = game:GetService("ReplicatedStorage"):WaitForChild("Hit")
tool.Equipped:Connect(function()
	print("equipped", tool.Name)
end)
tool.Activated:Connect(function()
	hit:FireServer(workspace.Dummy)
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
