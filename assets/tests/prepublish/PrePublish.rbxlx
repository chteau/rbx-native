    <Item class="Script" referent="RBX7">
      <Properties>
        <string name="Name">Deprecated</string>
        <ProtectedString name="Source">-- Pre-publish fixture: deprecated API. Every flagged line carries an expect
-- marker naming its check id; the others must stay quiet.
local Players = game:GetService(&quot;Players&quot;)

wait(1) -- expect: deprecated-api
spawn(function() end) -- expect: deprecated-api
delay(1, function() end) -- expect: deprecated-api
task.wait(1)
task.spawn(function() end)

local part = Instance.new(&quot;Part&quot;, workspace) -- expect: deprecated-api
local other = Instance.new(&quot;Part&quot;)
other.Parent = workspace

Players.PlayerAdded:connect(function() end) -- expect: deprecated-api
Players.PlayerAdded:Connect(function() end)

local base = game.Workspace.Baseplate -- expect: deprecated-api
local same = workspace.Baseplate

local hit = workspace:FindPartOnRay(Ray.new(Vector3.zero, Vector3.yAxis)) -- expect: deprecated-api
local result = workspace:Raycast(Vector3.zero, Vector3.yAxis)
local copy = part:clone() -- expect: deprecated-api
local fine = part:Clone()

-- A method the place's own code defines isn't Roblox's deprecated one.
local Mover = {}
function Mover:move() end
Mover:move()
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX8">
      <Properties>
        <string name="Name">Shadowed</string>
        <ProtectedString name="Source">-- Pre-publish fixture: globals the script declares itself aren't Roblox's.
local wait = task.wait
wait(1)

local function spawn(f)
	task.spawn(f)
end
spawn(print)

local game = { Workspace = {} }
local w = game.Workspace
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX9">
      <Properties>
        <string name="Name">Data</string>
        <ProtectedString name="Source">-- Pre-publish fixture: DataStore and MemoryStore calls outside pcall.
local DataStoreService = game:GetService(&quot;DataStoreService&quot;)
local HttpService = game:GetService(&quot;HttpService&quot;)
local store = DataStoreService:GetDataStore(&quot;Players&quot;)
local ordered = DataStoreService:GetOrderedDataStore(&quot;Wins&quot;)
local map = game:GetService(&quot;MemoryStoreService&quot;):GetSortedMap(&quot;Queue&quot;)
local Profiles = {}
Profiles.store = DataStoreService:GetDataStore(&quot;Profiles&quot;)

local data = store:GetAsync(&quot;key&quot;) -- expect: datastore-without-pcall
store:SetAsync(&quot;key&quot;, 1) -- expect: datastore-without-pcall
ordered:GetSortedAsync(false, 10) -- expect: datastore-without-pcall
map:SetAsync(&quot;k&quot;, 1, 60) -- expect: datastore-without-pcall
DataStoreService:GetDataStore(&quot;Other&quot;):IncrementAsync(&quot;k&quot;) -- expect: datastore-without-pcall
