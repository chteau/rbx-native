    <Item class="ModuleScript" referent="RBX9">
      <Properties>
        <string name="Name">CoeditCollect</string>
        <ProtectedString name="Source">-- Turns what changed in Studio since the last flush into ops: deletes,
-- adds (only what differs from a fresh instance of the class), property
-- sets (renames and moves at the path peers still know) and script text.

local Apply = require(script.Parent.CoeditApply)
local Json = require(script.Parent.Json)
local Paths = require(script.Parent.Paths)

local Collect = {}

local function freshId(): string
	return string.lower((string.gsub(game:GetService(&quot;HttpService&quot;):GenerateGUID(false), &quot;-&quot;, &quot;&quot;)))
end

local function depth(inst: Instance): number
	local n = 0
	local current = inst.Parent
	while current ~= nil do
		n += 1
		current = current.Parent
	end
	return n
end

-- Each class's scripting properties as a fresh `Instance.new` has them
-- (encoded), so an add only carries what differs: a part is a handful of
-- properties instead of a hundred, which matters when thousands are added.
local defaults: { [string]: { [string]: string } } = {}

local function defaultsOf(state: any, className: string): { [string]: string }
	local found = defaults[className]
	if found ~= nil then
		return found
	end
	local made: { [string]: string } = {}
	local ok, fresh = pcall(Instance.new, className)
	if ok then
		for prop in Apply.propsOf(className) do
			local okEnc, encoded = pcall(Apply.encodeProp, state, fresh, prop)
			if okEnc and encoded ~= nil then
				made[prop] = encoded
			end
		end
		fresh:Destroy()
	end
	defaults[className] = made
	return made
end

function Collect.collect(self: any): { any }
	local state = self.state
	local ops: { any } = {}
	local targetOf = function(i: Instance)
		return Apply.targetOf(state, i)
	end

	for _, entry in self.removed do
		local inst = entry.inst
		if inst.Parent ~= nil and self:isTracked(inst) then
			-- Moved between tracked roots: a reparent, not a delete.
			self:watch(inst)
			local props = self.dirty[inst] or {}
			props.Parent = true
			self.dirty[inst] = props
		else
			table.insert(ops, { k = &quot;del&quot;, id = entry.id, p = entry.p, c = self:clock() })
		end
	end
	self.removed = {}

	local adds: { Instance } = {}
	for inst in self.added do
		if inst.Parent ~= nil and self:isTracked(inst) then
			table.insert(adds, inst)
		end
	end
	self.added = {}
	table.sort(adds, function(a, b)
		return depth(a) &lt; depth(b)
	end)
	for _, inst in adds do
		local id = state.idOf[inst]
		if id == nil then
			id = freshId()
			state.idOf[inst] = id
			state.byId[id] = inst
		end
		local props = {}
		local default = defaultsOf(state, inst.ClassName)
		for prop in Apply.propsOf(inst.ClassName) do
			if prop ~= &quot;Parent&quot; then
				local okEnc, encoded = pcall(Apply.encodeProp, state, inst, prop)
				if okEnc and encoded ~= nil and encoded ~= default[prop] then
					props[prop] = Json.decode(encoded)
				end
			end
		end
		for name in inst:GetAttributes() do
			local encoded = Apply.encodeProp(state, inst, &quot;@&quot; .. name)
			if encoded ~= nil and encoded ~= &quot;null&quot; then
				props[&quot;@&quot; .. name] = Json.decode(encoded)
			end
		end
		for _, tag in inst:GetTags() do
			props[&quot;#&quot; .. tag] = { t = &quot;Bool&quot;, v = true }
		end
		props.Name = { t = &quot;String&quot;, v = inst.Name }
		if inst:IsA(&quot;LuaSourceContainer&quot;) then
			local text = Apply.editorSource(inst)
			props.Source = { t = &quot;String&quot;, v = text }
			state.log:hash(id, text)
		end
		self.dirty[inst] = nil
		self.dirtySrc[inst] = nil
		self.paths[inst] = Paths.pathOf(inst)
		table.insert(ops, {
			k = &quot;add&quot;,
			id = id,
			p = Paths.pathOf(inst) or &quot;&quot;,
			cls = inst.ClassName,
			parent = targetOf(inst.Parent :: Instance),
			props = props,
			c = self:clock(),
		})
	end

	for inst, props in self.dirty do
		if inst.Parent == nil or not self:isTracked(inst) then
			continue
		end
		local at = targetOf(inst)
		local function emit(prop: string, path: string)
			local encoded = Apply.encodeProp(state, inst, prop)
			if encoded ~= nil then
				table.insert(ops, { k = &quot;set&quot;, id = at.id, p = path, n = prop, v = Json.decode(encoded), c = self:clock() })
			end
		end
		-- Name, then Parent, each at the path the peers still have.
		local before = self.moved[inst]
		if before ~= nil then
			if props.Name then
				props.Name = nil
				emit(&quot;Name&quot;, before)
				local names = Paths.split(before)
				if names ~= nil and #names &gt; 0 then
					names[#names] = inst.Name
					before = Paths.join(names)
				end
			end
			if props.Parent then
				props.Parent = nil
				emit(&quot;Parent&quot;, before)
			end
		end
		for prop in props do
			emit(prop, at.p)
		end
	end
	self.dirty = {}
	self.moved = setmetatable({}, { __mode = &quot;k&quot; })

	for inst in self.dirtySrc do
		if inst.Parent == nil or not self:isTracked(inst) then
			continue
		end
		local text = Apply.editorSource(inst)
		local marks = state.marks[inst]
		if marks ~= nil and marks.Source ~= nil then
			local mark = marks.Source
			marks.Source = nil
			if mark == text then
				continue
			end
		end
		local at = targetOf(inst)
		local key = Apply.keyOf(at)
		local logged = state.log.texts[key]
		if logged ~= nil and logged == text then
			continue
		end
		local base = state.log:hash(key, text)
		table.insert(ops, { k = &quot;src&quot;, id = at.id, p = at.p, base = base, text = text, c = self:clock() })
	end
	self.dirtySrc = {}

	for _, op in self.resend do
		op.c = self:clock()
		table.insert(ops, op)
	end
	self.resend = {}
	return ops
end

return Collect
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX10">
      <Properties>
        <string name="Name">CoeditCore</string>
        <ProtectedString name="Source">--!strict
-- The pure parts of live co-editing, mirroring crates/rbx_presence/src/coedit
-- (chunk.rs, merge.rs and the engine's script-text rules). Nothing here touches
-- a Roblox service, so it runs in plain Luau and is pinned by
-- fixtures/coedit_vectors.json.

local Crypto = require(script.Parent.Crypto)
local Sha256 = require(script.Parent.Sha256)

local CHUNK_BYTES = 7000
local STALE_AFTER = 4096
local MAX_KNOWN_TEXTS = 64

local CoeditCore = {}

function CoeditCore.textHash(text: string): string
	return string.sub(Sha256.hex(text), 1, 16)
end

-- Three-way merge -------------------------------------------------------------

local function splitLines(text: string): {string}
	local lines: {string} = {}
	local pos = 1
	local len = #text
	while pos &lt;= len do
		local nl = string.find(text, &quot;\n&quot;, pos, true)
		if nl == nil then
			table.insert(lines, string.sub(text, pos))
			break
		end
		table.insert(lines, string.sub(text, pos, nl))
		pos = nl + 1
	end
	return lines
end

-- For each line of `a`, the index of the line of `b` it is matched with in a
-- longest common subsequence, or nil.
local function matchLines(a: {string}, b: {string}): {[number]: number}
	local map: {[number]: number} = {}
	local na, nb = #a, #b
	local lo = 0
	while lo &lt; na and lo &lt; nb and a[lo + 1] == b[lo + 1] do
		lo += 1
		map[lo] = lo
	end
	local ea, eb = na, nb
	while ea &gt; lo and eb &gt; lo and a[ea] == b[eb] do
		map[ea] = eb
		ea -= 1
		eb -= 1
	end
	local rows = ea - lo
	local cols = eb - lo
	if rows == 0 or cols == 0 then
		return map
	end
	local table2: {{number}} = {}
	for i = 0, rows do
		local row: {number} = table.create(cols + 1, 0)
		table2[i + 1] = row
	end
	for i = rows - 1, 0, -1 do
		local row, below = table2[i + 1], table2[i + 2]
		local ai = a[lo + i + 1]
		for j = cols - 1, 0, -1 do
			if ai == b[lo + j + 1] then
				row[j + 1] = below[j + 2] + 1
			else
				row[j + 1] = math.max(below[j + 1], row[j + 2])
			end
		end
	end
	local i, j = 0, 0
	while i &lt; rows and j &lt; cols do
		if a[lo + i + 1] == b[lo + j + 1] then
			map[lo + i + 1] = lo + j + 1
			i += 1
			j += 1
		elseif table2[i + 2][j + 1] &gt;= table2[i + 1][j + 2] then
			i += 1
		else
			j += 1
		end
	end
	return map
end

local function sameLines(a: {string}, b: {string}): boolean
	if #a ~= #b then
		return false
	end
	for i = 1, #a do
		if a[i] ~= b[i] then
			return false
		end
	end
	return true
end

local function slice(lines: {string}, from: number, to: number): {string}
	local out: {string} = {}
	for i = from, to do
		table.insert(out, lines[i])
	end
	return out
end

local function emit(out: {string}, lines: {string})
	for _, line in lines do
		table.insert(out, line)
	end
end

local function emitTerminated(out: {string}, lines: {string})
	emit(out, lines)
	local last = lines[#lines]
	if last ~= nil and string.sub(last, -1) ~= &quot;\n&quot; then
		table.insert(out, &quot;\n&quot;)
	end
end

function CoeditCore.merge3(base: string, ours: string, theirs: string): {text: string, conflicted: boolean}
	local b, o, t = splitLines(base), splitLines(ours), splitLines(theirs)
	local mapO, mapT = matchLines(b, o), matchLines(b, t)
	local out: {string} = {}
	local conflicted = false
	local prevB, prevO, prevT = 0, 0, 0

	local function region(nextB: number, nextO: number, nextT: number)
		local baseChunk = slice(b, prevB + 1, nextB - 1)
		local oursChunk = slice(o, prevO + 1, nextO - 1)
		local theirsChunk = slice(t, prevT + 1, nextT - 1)
		if sameLines(oursChunk, baseChunk) then
			emit(out, theirsChunk)
		elseif sameLines(theirsChunk, baseChunk) or sameLines(oursChunk, theirsChunk) then
			emit(out, oursChunk)
		else
			conflicted = true
			table.insert(out, &quot;&lt;&lt;&lt;&lt;&lt;&lt;&lt; ours\n&quot;)
			emitTerminated(out, oursChunk)
			table.insert(out, &quot;=======\n&quot;)
			emitTerminated(out, theirsChunk)
			table.insert(out, &quot;&gt;&gt;&gt;&gt;&gt;&gt;&gt; theirs\n&quot;)
		end
	end

	for i = 1, #b do
		local oi, ti = mapO[i], mapT[i]
		if oi ~= nil and ti ~= nil then
			region(i, oi, ti)
			table.insert(out, o[oi])
			prevB, prevO, prevT = i, oi, ti
		end
	end
	region(#b + 1, #o + 1, #t + 1)
	return { text = table.concat(out), conflicted = conflicted }
end

-- Chunks ----------------------------------------------------------------------

export type Chunk = { b: string, i: number, n: number, d: string }

function CoeditCore.split(id: string, batchJson: string): {Chunk}
	local len = #batchJson
	if len == 0 then
		return { { b = id, i = 0, n = 1, d = &quot;&quot; } }
	end
	local n = math.ceil(len / CHUNK_BYTES)
	local chunks: {Chunk} = {}
	for i = 0, n - 1 do
		local part = string.sub(batchJson, i * CHUNK_BYTES + 1, (i + 1) * CHUNK_BYTES)
		chunks[i + 1] = { b = id, i = i, n = n, d = Crypto.b64encode(part) }
	end
	return chunks
end

local Reassembler = {}
Reassembler.__index = Reassembler

function Reassembler.new()
	return setmetatable({ pending = {} :: {[string]: any} }, Reassembler)
end

function Reassembler.push(self: any, seq: number, sender: string, chunk: Chunk): string?
	local pending = self.pending :: {[string]: any}
	for key, entry in pending do
		if seq - entry.first &gt;= STALE_AFTER then
			pending[key] = nil
		end
	end
	local n, i = chunk.n, chunk.i
	if type(n) ~= &quot;number&quot; or type(i) ~= &quot;number&quot; or n % 1 ~= 0 or i % 1 ~= 0 then
		return nil
	end
	if n == 0 or n &gt; STALE_AFTER or i &lt; 0 or i &gt;= n then
		return nil
	end
	local data = Crypto.b64decode(chunk.d)
	if data == nil then
		return nil
	end
	local key = sender .. &quot;\0&quot; .. tostring(chunk.b)
	local entry = pending[key]
	if entry == nil then
		entry = { first = seq, n = n, slots = {}, filled = 0 }
		pending[key] = entry
	end
	if entry.n ~= n then
		return nil
	end
	if entry.slots[i + 1] == nil then
		entry.filled += 1
	end
	entry.slots[i + 1] = data
	if entry.filled &lt; n then
		return nil
	end
	pending[key] = nil
	local text = table.concat(entry.slots)
	if utf8.len(text) == nil then
		return nil
	end
	return text
end

CoeditCore.Reassembler = Reassembler

-- Clocks and registers --------------------------------------------------------

export type Clock = { any }

function CoeditCore.clockLess(a: Clock, b: Clock): boolean
	local ca, cb = a[1] :: number, b[1] :: number
	if ca ~= cb then
		return ca &lt; cb
	end
	return (a[2] :: string) &lt; (b[2] :: string)
end

local Registers = {}
Registers.__index = Registers

function Registers.new()
	return setmetatable({ clocks = {} :: {[string]: Clock} }, Registers)
end

function Registers.claim(self: any, key: string, clock: Clock): boolean
	local clocks = self.clocks :: {[string]: Clock}
	local stored = clocks[key]
	if stored ~= nil and not CoeditCore.clockLess(stored, clock) then
		return false
	end
	clocks[key] = clock
	return true
end

CoeditCore.Registers = Registers

-- Script text log -------------------------------------------------------------

local Log = {}
Log.__index = Log

function Log.new()
	return setmetatable({ texts = {} :: {[string]: string}, known = {} :: {[string]: {[string]: string}} }, Log)
end

local function remember(self: any, key: string, text: string): string
	local hash = CoeditCore.textHash(text)
	local known = self.known[key]
	if known == nil then
		known = { count = 0 }
		self.known[key] = known
	end
	if known[hash] == nil then
		if known.count &gt;= MAX_KNOWN_TEXTS then
			known = { count = 0 }
			self.known[key] = known
		end
		known[hash] = text
		known.count += 1
	end
	return hash
end

local function logText(self: any, key: string, current: string): string
	local text = self.texts[key]
	if text == nil then
		text = current
		self.texts[key] = current
		remember(self, key, current)
	end
	return text
end

-- Hash of the log's text for `key` (seeded from `current` when nothing has
-- been logged yet): the `base` a new Src op names.
function Log.hash(self: any, key: string, current: string): string
	return remember(self, key, logText(self, key, current))
end

export type SrcResult = { accepted: boolean, write: string?, conflicted: boolean, resend: string? }

-- Applies a Src op in log order. `current` is the editor's text now.
function Log.src(self: any, key: string, current: string, op: { base: string, text: string }, own: boolean): SrcResult
	local old = logText(self, key, current)
	if op.base ~= CoeditCore.textHash(old) then
		-- Our own op on text the log has moved past. What moved it was merged
		-- into the editor's text when it arrived (or was our own earlier op),
		-- so the editor already holds both: resend that, never merge twice.
		if own then
			local resend: string? = if current ~= old then current else nil
			return { accepted = false, write = nil, conflicted = false, resend = resend }
		end
		return { accepted = false, write = nil, conflicted = false, resend = nil }
	end
	self.texts[key] = op.text
	remember(self, key, op.text)
	if own or current == op.text then
		return { accepted = true, write = nil, conflicted = false, resend = nil }
	end
	if current == old then
		return { accepted = true, write = op.text, conflicted = false, resend = nil }
	end
	local merged = CoeditCore.merge3(old, current, op.text)
	local write: string? = nil
	if merged.text ~= current then
		write = merged.text
	end
	return { accepted = true, write = write, conflicted = merged.conflicted, resend = nil }
end

CoeditCore.Log = Log

function CoeditCore.session(): string
	local digits: {string} = {}
	for i = 1, 8 do
		digits[i] = string.format(&quot;%x&quot;, math.random(0, 15))
	end
	return table.concat(digits)
end

return CoeditCore
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX11">
      <Properties>
        <string name="Name">CoeditKept</string>
        <ProtectedString name="Source">--!strict
-- What this peer keeps of the op log it reads, mirroring
-- crates/rbx_presence/src/coedit/keep.rs: entries exactly as logged, the
-- log's id, so a relay that lacks the log (a new host) is handed it and
-- everyone carries on at the same seqs. Pure Luau, run by the test suite.

-- Most ciphertext kept, the relay's own cap; the oldest goes first.
local KEPT_BYTES = 64 * 1024 * 1024
-- Most ciphertext per request when posting or filling.
local REQUEST_CT_BYTES = 512 * 1024

export type Entry = { seq: number, userId: number, client: string, ct: string }

local Kept = {}
Kept.__index = Kept
Kept.REQUEST_CT_BYTES = REQUEST_CT_BYTES

function Kept.new(cap: number?)
	return setmetatable({ log = &quot;&quot;, entries = {} :: { [number]: Entry }, first = 1, last = 0, bytes = 0, cap = cap or KEPT_BYTES }, Kept)
end

-- The newest seq kept; 0 for none.
function Kept.head(self: any): number
	-- Kept as a window `first..last` over the table, so trimming the front
	-- never leaves holes for `#` to trip on.
	return if self.last &gt;= self.first then self.entries[self.last].seq else 0
end

function Kept.restart(self: any, log: string)
	self.log = log
	self.entries = {}
	self.first = 1
	self.last = 0
	self.bytes = 0
end

-- Keeps an entry of log `log` (the reply's), in order.
function Kept.record(self: any, log: string, entry: Entry)
	if self.log ~= log then
		self:restart(log)
	end
	self.last += 1
	self.entries[self.last] = { seq = entry.seq, userId = entry.userId, client = entry.client, ct = entry.ct }
	self.bytes += #entry.ct
	while self.bytes &gt; self.cap and self.first &lt;= self.last do
		self.bytes -= #self.entries[self.first].ct
		self.entries[self.first] = nil :: any
		self.first += 1
	end
end

local function from(self: any, after: number): { Entry }
	local out = {}
	for i = self.first, self.last do
		local entry = self.entries[i]
		if entry.seq &gt; after then
			table.insert(out, entry)
		end
	end
	return out
end

-- What to do with a reply: &quot;read&quot; its entries, &quot;fill&quot; the relay with the
-- returned entries it lacks, or &quot;restart&quot; on the other log it runs.
function Kept.step(self: any, reply: any): (string, { Entry }?)
	local log = if type(reply.log) == &quot;string&quot; then reply.log else &quot;&quot;
	local head = tonumber(reply.head) or 0
	if log == &quot;&quot; then
		if head == 0 and self:head() &gt; 0 then
			return &quot;fill&quot;, from(self, 0)
		end
		return &quot;read&quot;, nil
	end
	if self.log == &quot;&quot; then
		return &quot;read&quot;, nil
	end
	if log ~= self.log then
		return &quot;restart&quot;, nil
	end
	local tail = from(self, head)
	if tail[1] ~= nil and tail[1].seq == head + 1 then
		return &quot;fill&quot;, tail
	end
	return &quot;read&quot;, nil
end

-- `items` cut into runs of at most `max` bytes each (by `size`), never
-- empty, so one request each.
function Kept.groups&lt;T&gt;(items: { T }, max: number, size: (T) -&gt; number): { { T } }
	local out: { { T } } = {}
	local used = 0
	for _, item in items do
		local n = size(item)
		local last = out[#out]
		if last ~= nil and used + n &lt;= max then
			table.insert(last, item)
		else
			table.insert(out, { item })
			used = 0
		end
		used += n
	end
	return out
end

return Kept
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX12">
      <Properties>
        <string name="Name">CoeditSync</string>
        <ProtectedString name="Source">-- Co-editing's traffic with the relay: sends batches to the op log (sealed
-- chunks, as many per request as fit: Studio allows a plugin 500 HTTP
-- requests a minute) and reads the log back, keeping a copy of it
-- (CoeditKept) that a relay lacking the log is handed.

local CoeditCore = require(script.Parent.CoeditCore)
local Crypto = require(script.Parent.Crypto)
local Json = require(script.Parent.Json)
local Kept = require(script.Parent.CoeditKept)

local POST_TRIES = 5

local Sync = {}

local rng = Random.new()

-- Plugins have no CSPRNG; a v4 GUID mixed with a Random stream gives a nonce
-- that does not repeat.
local function nonceFor(): string
	local hex = string.gsub(game:GetService(&quot;HttpService&quot;):GenerateGUID(false), &quot;[^%x]&quot;, &quot;&quot;)
	local bytes = table.create(12)
	for i = 1, 12 do
		local guidByte = tonumber(string.sub(hex, i * 2 - 1, i * 2), 16) or 0
		bytes[i] = string.char(bit32.bxor(guidByte, rng:NextInteger(0, 255)))
	end
	return table.concat(bytes)
end

-- Posts `body` to the op log (or its fill route), retrying with backoff.
local function post(self: any, body: string, fill: boolean): (boolean, string?)
	local relay = self.options.relay
	local lastError: string? = nil
	for attempt = 1, POST_TRIES do
		if not self.running then
			return false, nil
		end
		local okPost, ok, err = pcall(relay.postOps, relay, body, fill)
		if okPost and ok then
			return true, nil
		end
		lastError = if okPost then err else tostring(ok)
		task.wait(0.5 * 2 ^ (attempt - 1))
	end
	return false, lastError
end

function Sync.send(self: any, ops: { any }): boolean
	local options = self.options
	local okJson, batchJson = pcall(Json.encode, { a = self.actor, ops = ops })
	if not okJson then
		self:note(&quot;Co-edit: could not encode an edit batch&quot;)
		return false
	end
	self.batchCount += 1
	local id = CoeditCore.session() .. string.format(&quot;%x&quot;, self.batchCount)
	local aad = Crypto.opsAad(options.room, options.userId, &quot;studio&quot;)
	local sealed: { string } = {}
	for _, chunk in CoeditCore.split(id, batchJson) do
		table.insert(sealed, Crypto.sealB64(options.encKey, nonceFor(), aad, Json.encode(chunk)))
	end
	for _, cts in Kept.groups(sealed, Kept.REQUEST_CT_BYTES, string.len) do
		local body = Json.encode({ v = 2, userId = options.userId, client = &quot;studio&quot;, cts = cts })
		local sent, why = post(self, body, false)
		if not sent then
			if why ~= nil then
				self:note(&quot;Co-edit: could not send edits (&quot; .. why .. &quot;)&quot;)
			end
			return false
		end
	end
	return true
end

-- Hands the relay entries of the kept log it lacks.
local function handOver(self: any, entries: { any }): boolean
	for _, group in Kept.groups(entries, Kept.REQUEST_CT_BYTES, function(e)
		return #e.ct
	end) do
		local body = Json.encode({ v = 2, log = self.kept.log, entries = group })
		local sent, why = post(self, body, true)
		if not sent then
			if why ~= nil then
				self:note(&quot;Co-edit: could not hand the edit log to the new host (&quot; .. why .. &quot;)&quot;)
			end
			return false
		end
	end
	return true
end

function Sync.flush(self: any)
	local ops = self:collect()
	-- Unsent edits go out again with the next flush, to whichever host the
	-- room has by then.
	if #ops &gt; 0 and not self:send(ops) then
		for _, op in ops do
			table.insert(self.resend, op)
		end
	end
end

function Sync.authorOf(_self: any, actor: any): string
	if type(actor) ~= &quot;string&quot; then
		return &quot;a collaborator&quot;
	end
	local userId, client = string.match(actor, &quot;^(%d+):([^:]+)&quot;)
	if userId == nil then
		return actor
	end
	return &quot;user &quot; .. userId .. &quot; (&quot; .. client .. &quot;)&quot;
end

function Sync.poll(self: any)
	local options = self.options
	local okPoll, result, err = pcall(options.relay.pollOps, options.relay, self.since)
	if not okPoll or result == nil then
		if not okPoll or err ~= nil then
			self:note(&quot;Co-edit: could not read edits (&quot; .. tostring(if okPoll then err else result) .. &quot;)&quot;)
		end
		return
	end
	-- A relay may carry on the log we read, lack some or all of it (a new
	-- host: hand it over), or run another (read that from its start; what
	-- the old one decided, last writer per property, is in the place).
	local step, missing = self.kept:step(result)
	if step == &quot;fill&quot; then
		handOver(self, missing :: { any })
		return
	elseif step == &quot;restart&quot; then
		self.kept:restart(result.log)
		self.since = 0
		self.reassembler = CoeditCore.Reassembler.new()
		self.state.registers = CoeditCore.Registers.new()
		return
	end
	local log = if type(result.log) == &quot;string&quot; then result.log else &quot;&quot;
	local entries = type(result.entries) == &quot;table&quot; and result.entries or {}
	table.sort(entries, function(a, b)
		return (a.seq or 0) &lt; (b.seq or 0)
	end)
	if type(result.floor) == &quot;number&quot; and result.floor &gt; self.since + 1 and self.since &gt; 0 then
		self:note(&quot;Co-edit: the relay dropped older edits; some changes may be missing&quot;)
	end
	for _, entry in entries do
		if type(entry) ~= &quot;table&quot; or type(entry.seq) ~= &quot;number&quot; or type(entry.ct) ~= &quot;string&quot; then
			continue
		end
		if entry.seq &lt;= self.since then
			continue
		end
		self.since = entry.seq
		local client = tostring(entry.client)
		local userId = tonumber(entry.userId) or 0
		self.kept:record(log, { seq = entry.seq, userId = userId, client = client, ct = entry.ct })
		local plain = Crypto.openB64(options.encKey, Crypto.opsAad(options.room, userId, client), entry.ct)
		if plain == nil then
			continue
		end
		local okChunk, chunk = pcall(Json.decode, plain)
		if not okChunk or type(chunk) ~= &quot;table&quot; then
			continue
		end
		local text = self.reassembler:push(entry.seq, string.format(&quot;%.0f&quot;, userId) .. &quot;:&quot; .. client, chunk)
		if text == nil then
			continue
		end
		local okBatch, batch = pcall(Json.decode, text)
		if okBatch and type(batch) == &quot;table&quot; then
			local outcome = self.apply:batch(batch, batch.a == self.actor, self:authorOf(batch.a))
			for _, line in outcome.notes do
				self:note(line)
			end
			for _, op in outcome.resend do
				table.insert(self.resend, op)
			end
		end
	end
end

return Sync
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX13">
      <Properties>
        <string name="Name">CoeditValue</string>
        <ProtectedString name="Source">--!strict
-- Roblox values &lt;-&gt; value.rs JSON (`{t = &quot;&lt;Type&gt;&quot;, v = ...}`). A JSON null
-- `v` arrives in Luau as a missing key, so an absent `v` reads as null.

local CoeditValue = {}

type TargetJson = { id: string, p: string }

local function wrap(t: string, v: any): any
	return { t = t, v = v }
end

local function seqNums(ks: { any }, f: (any) -&gt; { number }): { { number } }
	local out = {}
	for _, k in ks do
		table.insert(out, f(k))
	end
	return out
end

local function encodeInner(value: any, valueType: string?, targetOf: (Instance) -&gt; TargetJson): any?
	local kind = typeof(value)
	if value == nil then
		if valueType == &quot;Ref&quot; or valueType == &quot;Instance&quot; then
			return { t = &quot;Ref&quot; }
		elseif valueType == &quot;PhysicalProperties&quot; then
			return wrap(&quot;PhysicalProperties&quot;, &quot;Default&quot;)
		elseif valueType == &quot;OptionalCFrame&quot; then
			return { t = &quot;OptionalCFrame&quot; }
		end
		return nil
	elseif kind == &quot;string&quot; then
		return wrap(&quot;String&quot;, value)
	elseif kind == &quot;boolean&quot; then
		return wrap(&quot;Bool&quot;, value)
	elseif kind == &quot;number&quot; then
		if valueType == &quot;float&quot; or valueType == &quot;Float32&quot; then
			return wrap(&quot;Float32&quot;, value)
		elseif valueType == &quot;int&quot; or valueType == &quot;Int32&quot; then
			return wrap(&quot;Int32&quot;, math.floor(value))
		elseif valueType == &quot;int64&quot; or valueType == &quot;Int64&quot; then
			return wrap(&quot;Int64&quot;, math.floor(value))
		end
		return wrap(&quot;Float64&quot;, value)
	elseif kind == &quot;EnumItem&quot; then
		if valueType == &quot;Attribute&quot; then
			return wrap(&quot;EnumItem&quot;, { tostring(value.EnumType), value.Value })
		end
		return wrap(&quot;Enum&quot;, value.Value)
	elseif kind == &quot;BrickColor&quot; then
		return wrap(&quot;BrickColor&quot;, value.Number)
	elseif kind == &quot;Color3&quot; then
		if valueType == &quot;Color3uint8&quot; then
			return wrap(&quot;Color3uint8&quot;, {
				math.clamp(math.floor(value.R * 255 + 0.5), 0, 255),
				math.clamp(math.floor(value.G * 255 + 0.5), 0, 255),
				math.clamp(math.floor(value.B * 255 + 0.5), 0, 255),
			})
		end
		return wrap(&quot;Color3&quot;, { value.R, value.G, value.B })
	elseif kind == &quot;Vector2&quot; then
		return wrap(&quot;Vector2&quot;, { value.X, value.Y })
	elseif kind == &quot;Vector3&quot; then
		return wrap(&quot;Vector3&quot;, { value.X, value.Y, value.Z })
	elseif kind == &quot;Vector3int16&quot; then
		return wrap(&quot;Vector3int16&quot;, { value.X, value.Y, value.Z })
	elseif kind == &quot;Ray&quot; then
		local o, d = value.Origin, value.Direction
		return wrap(&quot;Ray&quot;, { o.X, o.Y, o.Z, d.X, d.Y, d.Z })
	elseif kind == &quot;Faces&quot; then
		return wrap(&quot;Faces&quot;, { value.Front, value.Bottom, value.Left, value.Back, value.Top, value.Right })
	elseif kind == &quot;Axes&quot; then
		return wrap(&quot;Axes&quot;, { value.X, value.Y, value.Z })
	elseif kind == &quot;CFrame&quot; then
		return wrap(if valueType == &quot;OptionalCFrame&quot; then &quot;OptionalCFrame&quot; else &quot;CFrame&quot;, { value:GetComponents() })
	elseif kind == &quot;NumberSequence&quot; then
		return wrap(&quot;NumberSequence&quot;, seqNums(value.Keypoints, function(k)
			return { k.Time, k.Value, k.Envelope }
		end))
	elseif kind == &quot;ColorSequence&quot; then
		return wrap(&quot;ColorSequence&quot;, seqNums(value.Keypoints, function(k)
			return { k.Time, k.Value.R, k.Value.G, k.Value.B, 0 }
		end))
	elseif kind == &quot;NumberRange&quot; then
		return wrap(&quot;NumberRange&quot;, { value.Min, value.Max })
	elseif kind == &quot;Rect&quot; then
		return wrap(&quot;Rect&quot;, { value.Min.X, value.Min.Y, value.Max.X, value.Max.Y })
	elseif kind == &quot;PhysicalProperties&quot; then
		return wrap(&quot;PhysicalProperties&quot;, {
			value.Density,
			value.Friction,
			value.Elasticity,
			value.FrictionWeight,
			value.ElasticityWeight,
		})
	elseif kind == &quot;UDim&quot; then
		return wrap(&quot;UDim&quot;, { value.Scale, value.Offset })
	elseif kind == &quot;UDim2&quot; then
		return wrap(&quot;UDim2&quot;, { value.X.Scale, value.X.Offset, value.Y.Scale, value.Y.Offset })
	elseif kind == &quot;Font&quot; then
		return wrap(&quot;Font&quot;, { family = value.Family, weight = value.Weight.Value, style = value.Style.Value })
	elseif kind == &quot;Instance&quot; then
		local t = targetOf(value)
		return wrap(&quot;Ref&quot;, { id = t.id, p = t.p })
	end
	return nil
end

function CoeditValue.encode(value: any, valueType: string?, targetOf: (Instance) -&gt; TargetJson): any?
	local ok, result = pcall(encodeInner, value, valueType, targetOf)
	if ok then
		return result
	end
	return nil
end

local function enumByValue(enum: any, n: number): EnumItem?
	for _, item in enum:GetEnumItems() do
		if item.Value == n then
			return item
		end
	end
	return nil
end

local function decodeInner(json: any, current: any, valueType: string?, resolve: (TargetJson) -&gt; Instance?): (boolean, any)
	if type(json) ~= &quot;table&quot; or type(json.t) ~= &quot;string&quot; then
		return false, nil
	end
	local t, v = json.t, json.v
	if t == &quot;Ref&quot; then
		if type(v) ~= &quot;table&quot; then
			return true, nil
		end
		return true, resolve({ id = tostring(v.id or &quot;&quot;), p = tostring(v.p or &quot;&quot;) })
	elseif t == &quot;OptionalCFrame&quot; and v == nil then
		return true, nil
	elseif t == &quot;String&quot; then
		return type(v) == &quot;string&quot;, if type(v) == &quot;string&quot; then v else nil
	elseif t == &quot;Bool&quot; then
		return type(v) == &quot;boolean&quot;, if type(v) == &quot;boolean&quot; then v else nil
	elseif t == &quot;Int32&quot; or t == &quot;Int64&quot; or t == &quot;Float32&quot; or t == &quot;Float64&quot; then
		return type(v) == &quot;number&quot;, if type(v) == &quot;number&quot; then v else nil
	elseif t == &quot;Enum&quot; then
		local enum: any = nil
		if typeof(current) == &quot;EnumItem&quot; then
			enum = current.EnumType
		elseif valueType and string.sub(valueType, 1, 5) == &quot;Enum:&quot; then
			enum = (Enum :: any)[string.sub(valueType, 6)]
		end
		if enum == nil or type(v) ~= &quot;number&quot; then
			return false, nil
		end
		local item = enumByValue(enum, v)
		return item ~= nil, item
	elseif t == &quot;EnumItem&quot; then
		local item = if type(v) == &quot;table&quot; then enumByValue((Enum :: any)[v[1]], v[2]) else nil
		return item ~= nil, item
	elseif t == &quot;BrickColor&quot; then
		return true, BrickColor.new(v)
	elseif t == &quot;PhysicalProperties&quot; then
		if v == &quot;Default&quot; then
			return true, nil
		end
		return true, PhysicalProperties.new(v[1], v[2], v[3], v[4], v[5])
	elseif t == &quot;Font&quot; then
		local weight = enumByValue(Enum.FontWeight, v.weight)
		local style = enumByValue(Enum.FontStyle, v.style)
		if weight == nil or style == nil then
			return false, nil
		end
		return true, Font.new(v.family, weight :: any, style :: any)
	end
	if type(v) ~= &quot;table&quot; then
		return false, nil
	end
	if t == &quot;Color3&quot; then
		return true, Color3.new(v[1], v[2], v[3])
	elseif t == &quot;Color3uint8&quot; then
		return true, Color3.fromRGB(v[1], v[2], v[3])
	elseif t == &quot;Vector2&quot; then
		return true, Vector2.new(v[1], v[2])
	elseif t == &quot;Vector3&quot; then
		return true, Vector3.new(v[1], v[2], v[3])
	elseif t == &quot;Vector3int16&quot; then
		return true, Vector3int16.new(v[1], v[2], v[3])
	elseif t == &quot;Ray&quot; then
		return true, Ray.new(Vector3.new(v[1], v[2], v[3]), Vector3.new(v[4], v[5], v[6]))
	elseif t == &quot;Faces&quot; then
		local ids = {}
		local names = { &quot;Front&quot;, &quot;Bottom&quot;, &quot;Left&quot;, &quot;Back&quot;, &quot;Top&quot;, &quot;Right&quot; }
		for i, name in names do
			if v[i] == true then
				table.insert(ids, (Enum.NormalId :: any)[name])
			end
		end
		return true, Faces.new(table.unpack(ids))
	elseif t == &quot;Axes&quot; then
		local ids = {}
		local names = { &quot;X&quot;, &quot;Y&quot;, &quot;Z&quot; }
		for i, name in names do
			if v[i] == true then
				table.insert(ids, (Enum.Axis :: any)[name])
			end
		end
		return true, Axes.new(table.unpack(ids))
	elseif t == &quot;CFrame&quot; or t == &quot;OptionalCFrame&quot; then
		if #v ~= 12 then
			return false, nil
		end
		return true, CFrame.new(table.unpack(v, 1, 12))
	elseif t == &quot;NumberSequence&quot; then
		local ks = {}
		for _, k in v do
			table.insert(ks, NumberSequenceKeypoint.new(k[1], k[2], k[3] or 0))
		end
		return true, NumberSequence.new(ks)
	elseif t == &quot;ColorSequence&quot; then
		local ks = {}
		for _, k in v do
			table.insert(ks, ColorSequenceKeypoint.new(k[1], Color3.new(k[2], k[3], k[4])))
		end
		return true, ColorSequence.new(ks)
	elseif t == &quot;NumberRange&quot; then
		return true, NumberRange.new(v[1], v[2])
	elseif t == &quot;Rect&quot; then
		return true, Rect.new(v[1], v[2], v[3], v[4])
	elseif t == &quot;UDim&quot; then
		return true, UDim.new(v[1], v[2])
	elseif t == &quot;UDim2&quot; then
		return true, UDim2.new(v[1], v[2], v[3], v[4])
	end
	return false, nil
end

function CoeditValue.decode(json: any, current: any, valueType: string?, resolve: (TargetJson) -&gt; Instance?): (boolean, any)
	local ok, good, result = pcall(decodeInner, json, current, valueType, resolve)
	if ok and good then
		return true, result
	end
	return false, nil
end

return CoeditValue
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX14">
      <Properties>
        <string name="Name">Crypto</string>
        <ProtectedString name="Source">--!strict
-- Payload encryption, mirroring crates/rbx_presence/src/crypt.rs:
-- HKDF-SHA256 key derivation and ChaCha20-Poly1305 (RFC 8439), using only
-- bit32 so it runs in Studio and in plain Luau alike. Both sides are pinned
-- by fixtures/crypto_vectors.json.

local Sha256 = require(script.Parent.Sha256)

local Crypto = {}

local NONCE_LEN = 12
local TAG_LEN = 16
local BLOCK = 64

local function hmacRaw(key: string, msg: string): string
	if #key &gt; BLOCK then
		key = Sha256.raw(key)
	end
	key = key .. string.rep(&quot;\0&quot;, BLOCK - #key)
	local inner: {string} = table.create(BLOCK)
	local outer: {string} = table.create(BLOCK)
	for i = 1, BLOCK do
		local b = string.byte(key, i)
		inner[i] = string.char(bit32.bxor(b, 0x36))
		outer[i] = string.char(bit32.bxor(b, 0x5c))
	end
	return Sha256.raw(table.concat(outer) .. Sha256.raw(table.concat(inner) .. msg))
end

function Crypto.hex(s: string): string
	return (string.gsub(s, &quot;.&quot;, function(c: string)
		return string.format(&quot;%02x&quot;, string.byte(c))
	end))
end

function Crypto.unhex(s: string): string?
	if #s % 2 ~= 0 or string.find(s, &quot;[^0-9a-fA-F]&quot;) then
		return nil
	end
	return (string.gsub(s, &quot;..&quot;, function(pair: string)
		return string.char(tonumber(pair, 16) :: number)
	end))
end

function Crypto.hkdf(ikm: string, salt: string, info: string, len: number): string
	if salt == &quot;&quot; then
		salt = string.rep(&quot;\0&quot;, 32)
	end
	local prk = hmacRaw(salt, ikm)
	local out: {string} = {}
	local prev = &quot;&quot;
	local have = 0
	local i = 1
	while have &lt; len do
		prev = hmacRaw(prk, prev .. info .. string.char(i))
		table.insert(out, prev)
		have += #prev
		i += 1
	end
	return string.sub(table.concat(out), 1, len)
end

function Crypto.encKey(secret: string, placeId: number): string
	return Crypto.hkdf(secret, &quot;&quot;, &quot;rbx-presence/enc/v1/&quot; .. string.format(&quot;%.0f&quot;, placeId), 32)
end

-- ChaCha20 -------------------------------------------------------------------

local function leWord(s: string, i: number): number
	local a, b, c, d = string.byte(s, i, i + 3)
	return a + b * 0x100 + c * 0x10000 + d * 0x1000000
end

local function chachaBlock(key: string, counter: number, nonce: string): {number}
	local s: {number} = {
		0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
		leWord(key, 1), leWord(key, 5), leWord(key, 9), leWord(key, 13),
		leWord(key, 17), leWord(key, 21), leWord(key, 25), leWord(key, 29),
		counter, leWord(nonce, 1), leWord(nonce, 5), leWord(nonce, 9),
	}
	local x0, x1, x2, x3, x4, x5, x6, x7 = s[1], s[2], s[3], s[4], s[5], s[6], s[7], s[8]
	local x8, x9, x10, x11, x12, x13, x14, x15 = s[9], s[10], s[11], s[12], s[13], s[14], s[15], s[16]
	local band, bxor, rot = bit32.band, bit32.bxor, bit32.lrotate
	local M = 0xffffffff
	for _ = 1, 10 do
		-- columns
		x0 = band(x0 + x4, M); x12 = rot(bxor(x12, x0), 16); x8 = band(x8 + x12, M); x4 = rot(bxor(x4, x8), 12)
		x0 = band(x0 + x4, M); x12 = rot(bxor(x12, x0), 8); x8 = band(x8 + x12, M); x4 = rot(bxor(x4, x8), 7)
		x1 = band(x1 + x5, M); x13 = rot(bxor(x13, x1), 16); x9 = band(x9 + x13, M); x5 = rot(bxor(x5, x9), 12)
		x1 = band(x1 + x5, M); x13 = rot(bxor(x13, x1), 8); x9 = band(x9 + x13, M); x5 = rot(bxor(x5, x9), 7)
		x2 = band(x2 + x6, M); x14 = rot(bxor(x14, x2), 16); x10 = band(x10 + x14, M); x6 = rot(bxor(x6, x10), 12)
		x2 = band(x2 + x6, M); x14 = rot(bxor(x14, x2), 8); x10 = band(x10 + x14, M); x6 = rot(bxor(x6, x10), 7)
		x3 = band(x3 + x7, M); x15 = rot(bxor(x15, x3), 16); x11 = band(x11 + x15, M); x7 = rot(bxor(x7, x11), 12)
		x3 = band(x3 + x7, M); x15 = rot(bxor(x15, x3), 8); x11 = band(x11 + x15, M); x7 = rot(bxor(x7, x11), 7)
		-- diagonals
		x0 = band(x0 + x5, M); x15 = rot(bxor(x15, x0), 16); x10 = band(x10 + x15, M); x5 = rot(bxor(x5, x10), 12)
		x0 = band(x0 + x5, M); x15 = rot(bxor(x15, x0), 8); x10 = band(x10 + x15, M); x5 = rot(bxor(x5, x10), 7)
		x1 = band(x1 + x6, M); x12 = rot(bxor(x12, x1), 16); x11 = band(x11 + x12, M); x6 = rot(bxor(x6, x11), 12)
		x1 = band(x1 + x6, M); x12 = rot(bxor(x12, x1), 8); x11 = band(x11 + x12, M); x6 = rot(bxor(x6, x11), 7)
		x2 = band(x2 + x7, M); x13 = rot(bxor(x13, x2), 16); x8 = band(x8 + x13, M); x7 = rot(bxor(x7, x8), 12)
		x2 = band(x2 + x7, M); x13 = rot(bxor(x13, x2), 8); x8 = band(x8 + x13, M); x7 = rot(bxor(x7, x8), 7)
		x3 = band(x3 + x4, M); x14 = rot(bxor(x14, x3), 16); x9 = band(x9 + x14, M); x4 = rot(bxor(x4, x9), 12)
		x3 = band(x3 + x4, M); x14 = rot(bxor(x14, x3), 8); x9 = band(x9 + x14, M); x4 = rot(bxor(x4, x9), 7)
	end
	local x = { x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15 }
	for i = 1, 16 do
		x[i] = band(x[i] + s[i], M)
	end
	return x
end

local function chachaXor(key: string, counter: number, nonce: string, data: string): string
	local out: {string} = {}
	local bytes: {number} = table.create(BLOCK, 0)
	local n = #data
	local pos = 1
	while pos &lt;= n do
		local ks = chachaBlock(key, counter, nonce)
		local count = math.min(BLOCK, n - pos + 1)
		for j = 0, count - 1 do
			local w = ks[bit32.rshift(j, 2) + 1]
			bytes[j + 1] = bit32.bxor(string.byte(data, pos + j), bit32.extract(w, (j % 4) * 8, 8))
		end
		table.insert(out, string.char(table.unpack(bytes, 1, count)))
		pos += BLOCK
		counter += 1
	end
	return table.concat(out)
end

-- Poly1305 with ten 13-bit limbs (130 bits), so every product sum stays far
-- below 2^53 in a double.

local LIMB = 8192

local function limbsOf(bytes: {number}): {number}
	local limbs: {number} = table.create(10, 0)
	for i = 0, 9 do
		local off = i * 13
		local bi = bit32.rshift(off, 3) + 1
		local v = (bytes[bi] or 0) + (bytes[bi + 1] or 0) * 256 + (bytes[bi + 2] or 0) * 65536
		limbs[i + 1] = bit32.extract(v, off % 8, 13)
	end
	return limbs
end

local function poly1305(key: string, msg: string): string
	local rb = { string.byte(key, 1, 16) }
	rb[4] = bit32.band(rb[4], 15)
	rb[8] = bit32.band(rb[8], 15)
	rb[12] = bit32.band(rb[12], 15)
	rb[16] = bit32.band(rb[16], 15)
	rb[5] = bit32.band(rb[5], 252)
	rb[9] = bit32.band(rb[9], 252)
	rb[13] = bit32.band(rb[13], 252)
	local r = limbsOf(rb)
	local r5: {number} = table.create(10, 0)
	for i = 1, 10 do
		r5[i] = r[i] * 5
	end
	local h: {number} = table.create(10, 0)
	local d: {number} = table.create(10, 0)
	local n = #msg
	local pos = 1
	while pos &lt;= n do
		local count = math.min(16, n - pos + 1)
		local blk = { string.byte(msg, pos, pos + count - 1) }
		blk[count + 1] = 1
		for k = count + 2, 17 do
			blk[k] = 0
		end
		local m = limbsOf(blk)
		for i = 1, 10 do
			h[i] += m[i]
		end
		for k = 0, 9 do
			local sum = 0
			for i = 0, k do
				sum += h[i + 1] * r[k - i + 1]
			end
			for i = k + 1, 9 do
				sum += h[i + 1] * r5[k - i + 11]
			end
			d[k + 1] = sum
		end
		local c = 0
		for i = 1, 10 do
			local v = d[i] + c
			c = math.floor(v / LIMB)
			h[i] = v - c * LIMB
		end
		h[1] += c * 5
		c = math.floor(h[1] / LIMB)
		h[1] -= c * LIMB
		h[2] += c
		pos += 16
	end
	-- Fully carry, then subtract p once if h &gt;= p.
	for _ = 1, 2 do
		local c = 0
		for i = 1, 10 do
			local v = h[i] + c
			c = math.floor(v / LIMB)
			h[i] = v - c * LIMB
		end
		h[1] += c * 5
	end
	local g: {number} = table.create(10, 0)
	local c = 5
	for i = 1, 10 do
		local v = h[i] + c
		c = math.floor(v / LIMB)
		g[i] = v - c * LIMB
	end
	if c &gt; 0 then
		h = g
	end
	local hb: {number} = {}
	local acc, bits = 0, 0
	for i = 1, 10 do
		acc += h[i] * 2 ^ bits
		bits += 13
		while bits &gt;= 8 do
			table.insert(hb, acc % 256)
			acc = math.floor(acc / 256)
			bits -= 8
		end
	end
	local out: {number} = table.create(16, 0)
	local carry = 0
	for i = 1, 16 do
		local v = hb[i] + string.byte(key, 16 + i) + carry
		out[i] = v % 256
		carry = math.floor(v / 256)
	end
	return string.char(table.unpack(out))
end

local function pad16(len: number): string
	return string.rep(&quot;\0&quot;, (16 - len % 16) % 16)
end

local function le64(n: number): string
	local t: {number} = table.create(8, 0)
	for i = 1, 8 do
		t[i] = n % 256
		n = math.floor(n / 256)
	end
	return string.char(table.unpack(t))
end

local function tagFor(key: string, nonce: string, aad: string, ct: string): string
	local polyKey = string.sub(chachaXor(key, 0, nonce, string.rep(&quot;\0&quot;, 32)), 1, 32)
	return poly1305(polyKey, aad .. pad16(#aad) .. ct .. pad16(#ct) .. le64(#aad) .. le64(#ct))
end

function Crypto.seal(key: string, nonce: string, aad: string, plaintext: string): string
	local ct = chachaXor(key, 1, nonce, plaintext)
	return nonce .. ct .. tagFor(key, nonce, aad, ct)
end

function Crypto.open(key: string, aad: string, sealed: string): string?
	if #sealed &lt; NONCE_LEN + TAG_LEN then
		return nil
	end
	local nonce = string.sub(sealed, 1, NONCE_LEN)
	local ct = string.sub(sealed, NONCE_LEN + 1, #sealed - TAG_LEN)
	local tag = string.sub(sealed, #sealed - TAG_LEN + 1)
	local expect = tagFor(key, nonce, aad, ct)
	local diff = 0
	for i = 1, TAG_LEN do
		diff = bit32.bor(diff, bit32.bxor(string.byte(tag, i), string.byte(expect, i)))
	end
	if diff ~= 0 then
		return nil
	end
	return chachaXor(key, 1, nonce, ct)
end

-- Base64 ---------------------------------------------------------------------

local ALPHABET = &quot;ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/&quot;
local DECODE: {[number]: number} = {}
for i = 1, 64 do
	DECODE[string.byte(ALPHABET, i)] = i - 1
end

function Crypto.b64encode(s: string): string
	local out: {string} = {}
	for i = 1, #s, 3 do
		local a, b, c = string.byte(s, i, i + 2)
		local v = a * 65536 + (b or 0) * 256 + (c or 0)
		local q1 = bit32.extract(v, 18, 6) + 1
		local q2 = bit32.extract(v, 12, 6) + 1
		local q3 = bit32.extract(v, 6, 6) + 1
		local q4 = bit32.extract(v, 0, 6) + 1
		table.insert(
			out,
			string.sub(ALPHABET, q1, q1)
				.. string.sub(ALPHABET, q2, q2)
				.. (if b then string.sub(ALPHABET, q3, q3) else &quot;=&quot;)
				.. (if c then string.sub(ALPHABET, q4, q4) else &quot;=&quot;)
		)
	end
	return table.concat(out)
end

function Crypto.b64decode(s: string): string?
	local n = #s
	if n % 4 ~= 0 then
		return nil
	end
	local out: {string} = {}
	for i = 1, n, 4 do
		local c1, c2, c3, c4 = string.byte(s, i, i + 3)
		local last = i + 3 == n
		local v1, v2 = DECODE[c1], DECODE[c2]
		if v1 == nil or v2 == nil then
			return nil
		end
		local pad = 0
		local v3, v4
		if last and c4 == 61 then
			pad = 1
			v4 = 0
			if c3 == 61 then
				pad = 2
				v3 = 0
			else
				v3 = DECODE[c3]
			end
		else
			v3, v4 = DECODE[c3], DECODE[c4]
		end
		if v3 == nil or v4 == nil then
			return nil
		end
		-- Non-zero bits under the padding are rejected, as the Rust decoder does.
		if (pad == 2 and v2 % 16 ~= 0) or (pad == 1 and v3 % 4 ~= 0) then
			return nil
		end
		local v = v1 * 262144 + v2 * 4096 + v3 * 64 + v4
		local a, b, c = bit32.extract(v, 16, 8), bit32.extract(v, 8, 8), bit32.extract(v, 0, 8)
		if pad == 0 then
			table.insert(out, string.char(a, b, c))
		elseif pad == 1 then
			table.insert(out, string.char(a, b))
		else
			table.insert(out, string.char(a))
		end
	end
	return table.concat(out)
end

function Crypto.sealB64(key: string, nonce: string, aad: string, plaintext: string): string
	return Crypto.b64encode(Crypto.seal(key, nonce, aad, plaintext))
end

function Crypto.openB64(key: string, aad: string, b64: string): string?
	local bytes = Crypto.b64decode(b64)
	if bytes == nil then
		return nil
	end
	return Crypto.open(key, aad, bytes)
end

-- AADs and journal tag -------------------------------------------------------

local function int(n: number): string
	return string.format(&quot;%.0f&quot;, n)
end

function Crypto.stateAad(room: string, userId: number, client: string): string
	return &quot;rbx-presence/state/v2\n&quot; .. room .. &quot;\n&quot; .. int(userId) .. &quot;\n&quot; .. client
end

function Crypto.journalAad(room: string, userId: number, at: number): string
	return &quot;rbx-presence/journal/v2\n&quot; .. room .. &quot;\n&quot; .. int(userId) .. &quot;\n&quot; .. int(at)
end

function Crypto.opsAad(room: string, userId: number, client: string): string
	return &quot;rbx-presence/ops/v2\n&quot; .. room .. &quot;\n&quot; .. int(userId) .. &quot;\n&quot; .. client
end

function Crypto.journalTag(key: string, path: string, property: string, at: number): string
	return string.sub(Crypto.hex(hmacRaw(key, path .. &quot;\n&quot; .. property .. &quot;\n&quot; .. int(at))), 1, 16)
end

return Crypto
