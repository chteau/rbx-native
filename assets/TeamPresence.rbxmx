    <Item class="ModuleScript" referent="RBX28">
      <Properties>
        <string name="Name">Ui</string>
        <ProtectedString name="Source">--!strict
--// The plugin's look: rbx-native's own palette (the generated Theme module,
--// written from assets/themes/default/theme.json) and the few pieces the
--// editor's docks are built from, so the widget and the diff window read as
--// part of rbx-native rather than as stock Studio UI.

local Theme = require(script.Parent.Theme)

local Ui = {}

-- Studio has neither Manrope nor JetBrains Mono; Builder Sans and Builder
-- Mono are its closest.
Ui.FONT = Font.new(&quot;rbxasset://fonts/families/BuilderSans.json&quot;)
Ui.FONT_SEMIBOLD = Font.new(&quot;rbxasset://fonts/families/BuilderSans.json&quot;, Enum.FontWeight.SemiBold)
Ui.FONT_BOLD = Font.new(&quot;rbxasset://fonts/families/BuilderSans.json&quot;, Enum.FontWeight.Bold)
Ui.FONT_MONO = Font.new(&quot;rbxasset://fonts/families/BuilderMono.json&quot;)

-- Studio sizes text in whole points; these round rbx-native's sizes.
Ui.TEXT_LG = 14
Ui.TEXT_MD = 13
Ui.TEXT_SM = 12
Ui.TEXT_XS = 11
Ui.TEXT_XXS = 10

-- The spacing step: edge insets, gaps between blocks, card padding.
Ui.GAP = 8

Ui.RADIUS = Theme.sizes.radius or 5
Ui.RADIUS_BADGE = Theme.sizes.radius_badge or 4
Ui.RADIUS_TILE = Theme.sizes.radius_tile or 6

-- A theme colour as Color3 and as the Transparency that carries its alpha.
function Ui.color(name: string): Color3
	local c = Theme.colors[name]
	if not c then
		return Color3.new(1, 0, 1)
	end
	return Color3.fromRGB(c[1], c[2], c[3])
end

function Ui.alpha(name: string): number
	local c = Theme.colors[name]
	return if c then 1 - c[4] else 0
end

-- `#rrggbb` as Color3 (a collaborator's colour).
function Ui.hex(hex: string): Color3
	local r, g, b = string.match(hex, &quot;^#(%x%x)(%x%x)(%x%x)$&quot;)
	if not r then
		return Ui.color(&quot;text2&quot;)
	end
	return Color3.fromRGB(tonumber(r, 16) :: number, tonumber(g, 16) :: number, tonumber(b, 16) :: number)
end

function Ui.fill(object: GuiObject, name: string)
	object.BackgroundColor3 = Ui.color(name)
	object.BackgroundTransparency = Ui.alpha(name)
	object.BorderSizePixel = 0
end

function Ui.corner(parent: Instance, radius: number?)
	local corner = Instance.new(&quot;UICorner&quot;)
	corner.CornerRadius = UDim.new(0, radius or Ui.RADIUS)
	corner.Parent = parent
end

function Ui.stroke(parent: Instance, name: string?)
	local stroke = Instance.new(&quot;UIStroke&quot;)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = Ui.color(name or &quot;border&quot;)
	stroke.Transparency = Ui.alpha(name or &quot;border&quot;)
	stroke.Thickness = 1
	stroke.Parent = parent
	return stroke
end

function Ui.pad(parent: Instance, top: number, right: number?, bottom: number?, left: number?)
	local padding = Instance.new(&quot;UIPadding&quot;)
	padding.PaddingTop = UDim.new(0, top)
	padding.PaddingRight = UDim.new(0, right or top)
	padding.PaddingBottom = UDim.new(0, bottom or top)
	padding.PaddingLeft = UDim.new(0, left or right or top)
	padding.Parent = parent
end

function Ui.list(parent: Instance, gap: number, horizontal: boolean?): UIListLayout
	local layout = Instance.new(&quot;UIListLayout&quot;)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, gap)
	if horizontal then
		layout.FillDirection = Enum.FillDirection.Horizontal
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
	end
	layout.Parent = parent
	return layout
end

-- A transparent box that sizes to its content (vertical stack by default).
function Ui.frame(parent: Instance?, order: number?): Frame
	local frame = Instance.new(&quot;Frame&quot;)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.LayoutOrder = order or 0
	frame.Size = UDim2.fromScale(1, 0)
	frame.AutomaticSize = Enum.AutomaticSize.Y
	frame.Parent = parent
	return frame
end

export type TextOptions = {
	size: number?,
	color: string?,
	font: Font?,
	order: number?,
	wrap: boolean?,
	width: UDim?,
}

-- A label: full width and wrapping by default, sized to its text.
function Ui.text(parent: Instance?, text: string, options: TextOptions?): TextLabel
	local o: TextOptions = options or {}
	local label = Instance.new(&quot;TextLabel&quot;)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.LayoutOrder = o.order or 0
	label.FontFace = o.font or Ui.FONT
	label.TextSize = o.size or Ui.TEXT_SM
	label.TextColor3 = Ui.color(o.color or &quot;text&quot;)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.RichText = false
	label.Text = text
	if o.wrap == false then
		label.TextWrapped = false
		label.TextTruncate = Enum.TextTruncate.AtEnd
		label.Size = UDim2.new(o.width or UDim.new(1, 0), UDim.new(0, label.TextSize + 4))
	else
		label.TextWrapped = true
		label.Size = UDim2.new(o.width or UDim.new(1, 0), UDim.new(0, 0))
		label.AutomaticSize = Enum.AutomaticSize.Y
	end
	label.Parent = parent
	return label
end

-- A text link: `accent_line` until hovered.
function Ui.link(parent: Instance?, text: string, order: number?): TextButton
	local button = Instance.new(&quot;TextButton&quot;)
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.LayoutOrder = order or 0
	button.FontFace = Ui.FONT_SEMIBOLD
	button.TextSize = Ui.TEXT_XS
	button.TextColor3 = Ui.color(&quot;check_on&quot;)
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Text = text
	button.AutomaticSize = Enum.AutomaticSize.XY
	button.Size = UDim2.fromOffset(0, 16)
	button.Parent = parent
	button.MouseEnter:Connect(function()
		button.TextColor3 = Ui.color(&quot;accent_hover&quot;)
	end)
	button.MouseLeave:Connect(function()
		button.TextColor3 = Ui.color(&quot;check_on&quot;)
	end)
	return button
end

-- rbx-native's buttons: primary is `check_on` with dark bold text, secondary
-- is `field_select` on a `border2` stroke.
function Ui.button(parent: Instance?, text: string, primary: boolean, order: number?): TextButton
	local button = Instance.new(&quot;TextButton&quot;)
	button.AutoButtonColor = false
	button.LayoutOrder = order or 0
	button.Size = UDim2.new(0, 96, 0, 30)
	button.FontFace = if primary then Ui.FONT_BOLD else Ui.FONT_SEMIBOLD
	button.TextSize = Ui.TEXT_SM
	button.Text = text
	local idle = if primary then &quot;check_on&quot; else &quot;field_select&quot;
	local hover = if primary then &quot;accent_hover&quot; else &quot;secondary_hover&quot;
	Ui.fill(button, idle)
	button.TextColor3 = Ui.color(if primary then &quot;black&quot; else &quot;text&quot;)
	Ui.corner(button)
	if not primary then
		Ui.stroke(button, &quot;border2&quot;)
	end
	button.MouseEnter:Connect(function()
		Ui.fill(button, hover)
	end)
	button.MouseLeave:Connect(function()
		Ui.fill(button, idle)
	end)
	button.Parent = parent
	return button
end

-- A bordered rounded box with its own vertical stack (`gap` apart).
function Ui.card(parent: Instance?, order: number?, gap: number?): Frame
	local card = Ui.frame(parent, order)
	Ui.corner(card)
	Ui.stroke(card, &quot;border&quot;)
	Ui.pad(card, Ui.GAP)
	Ui.list(card, gap or 4)
	return card
end

-- The 6px (or `size`) round dot a kind or a collaborator is marked with.
function Ui.dot(parent: Instance?, color: Color3, size: number?): Frame
	local dot = Instance.new(&quot;Frame&quot;)
	dot.Size = UDim2.fromOffset(size or 6, size or 6)
	dot.BackgroundColor3 = color
	dot.BorderSizePixel = 0
	Ui.corner(dot, 999)
	dot.Parent = parent
	return dot
end

export type Switch = {
	frame: TextButton,
	set: (boolean) -&gt; (),
}

-- The dock's on/off switch: a 28x16 track, `check_on` when on, with a white
-- knob; clicking calls `onClick` (the caller sets the state).
function Ui.switch(parent: Instance?, onClick: () -&gt; (), order: number?): Switch
	local track = Instance.new(&quot;TextButton&quot;)
	track.AutoButtonColor = false
	track.Text = &quot;&quot;
	track.LayoutOrder = order or 0
	track.Size = UDim2.fromOffset(28, 16)
	Ui.corner(track, 999)
	local knob = Instance.new(&quot;Frame&quot;)
	knob.Size = UDim2.fromOffset(12, 12)
	knob.AnchorPoint = Vector2.new(0, 0.5)
	knob.BorderSizePixel = 0
	knob.BackgroundColor3 = Ui.color(&quot;knob&quot;)
	Ui.corner(knob, 999)
	knob.Parent = track
	local function set(on: boolean)
		Ui.fill(track, if on then &quot;check_on&quot; else &quot;track&quot;)
		knob.Position = if on then UDim2.new(1, -14, 0.5, 0) else UDim2.new(0, 2, 0.5, 0)
	end
	set(false)
	track.Activated:Connect(onClick)
	track.Parent = parent
	return { frame = track, set = set }
end

-- A mono value chip, as the diff table's: `diff_add_soft` behind `text`, a
-- 10x10 swatch first when `swatch` is given.
function Ui.chip(parent: Instance?, text: string, swatch: Color3?, order: number?): Frame
	local chip = Instance.new(&quot;Frame&quot;)
	chip.LayoutOrder = order or 0
	chip.AutomaticSize = Enum.AutomaticSize.X
	chip.Size = UDim2.fromOffset(0, 22)
	Ui.fill(chip, &quot;diff_add_soft&quot;)
	Ui.corner(chip, Ui.RADIUS_BADGE)
	Ui.pad(chip, 0, 7, 0, 7)
	Ui.list(chip, 6, true)
	if swatch then
		local box = Instance.new(&quot;Frame&quot;)
		box.Size = UDim2.fromOffset(10, 10)
		box.BackgroundColor3 = swatch
		box.BorderSizePixel = 0
		Ui.corner(box, 2)
		Ui.stroke(box, &quot;border2&quot;)
		box.Parent = chip
	end
	local label = Ui.text(chip, text, { font = Ui.FONT_MONO, size = Ui.TEXT_SM, wrap = false, order = 1 })
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, 22)
	label.TextTruncate = Enum.TextTruncate.None
	chip.Parent = parent
	return chip
end

-- A small rounded pill: `bg` behind `ink` text, a dot first.
function Ui.pill(parent: Instance?, text: string, bg: string, ink: string, order: number?): Frame
	local pill = Instance.new(&quot;Frame&quot;)
	pill.LayoutOrder = order or 0
	pill.AutomaticSize = Enum.AutomaticSize.X
	pill.Size = UDim2.fromOffset(0, 20)
	Ui.fill(pill, bg)
	Ui.corner(pill, Ui.RADIUS_BADGE)
	Ui.pad(pill, 0, 8, 0, 8)
	Ui.list(pill, 6, true)
	Ui.dot(pill, Ui.color(ink))
	local label = Ui.text(pill, text, { font = Ui.FONT_SEMIBOLD, size = Ui.TEXT_XS, color = ink, wrap = false, order = 1 })
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, 20)
	label.TextTruncate = Enum.TextTruncate.None
	pill.Parent = parent
	return pill
end

-- A collaborator as Studio shows one in a Team Create session: their round
-- Roblox headshot in a ring of their presence colour (the colour behind it
-- until the headshot loads).
function Ui.avatar(parent: Instance?, userId: number, color: Color3, size: number?, order: number?): ImageLabel
	local s = size or 22
	local image = Instance.new(&quot;ImageLabel&quot;)
	image.LayoutOrder = order or 0
	image.Size = UDim2.fromOffset(s, s)
	image.BackgroundColor3 = color
	image.BorderSizePixel = 0
	image.Image = string.format(&quot;rbxthumb://type=AvatarHeadShot&amp;id=%.0f&amp;w=48&amp;h=48&quot;, userId)
	Ui.corner(image, 999)
	local ring = Instance.new(&quot;UIStroke&quot;)
	ring.Color = color
	ring.Thickness = 2
	ring.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	ring.Parent = image
	image.Parent = parent
	return image
end

-- The Explorer's own icon for `class`, from StudioService.
function Ui.classIcon(parent: Instance?, class: string, size: number?): ImageLabel
	local image = Instance.new(&quot;ImageLabel&quot;)
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromOffset(size or 16, size or 16)
	local ok, icon = pcall(function()
		return game:GetService(&quot;StudioService&quot;):GetClassIcon(class)
	end)
	if ok and type(icon) == &quot;table&quot; then
		for key, value in icon :: any do
			pcall(function()
				(image :: any)[key] = value
			end)
		end
	end
	image.Parent = parent
	return image
end

return Ui
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX29">
      <Properties>
        <string name="Name">Widget</string>
        <ProtectedString name="Source">--!strict
--// Dock widget, laid out like rbx-native's own Collaborators dock and drawn
--// in its palette (see Ui): the note, a &quot;Share my presence&quot; switch, the
--// status line, an &quot;Advanced&quot; reveal holding the owner's relay setup, the
--// &quot;While you were away&quot; card, then one row per rbx-native collaborator.

local Catchup = require(script.Parent.Catchup)
local Ui = require(script.Parent.Ui)

local Widget = {}
Widget.__index = Widget

local NOTE = &quot;Presence only works for collaborators who have Studio open with the rbx-native &quot;
	.. &quot;presence plugin running, or rbx-native itself.&quot;

local HTTP_NOTE = &quot;Presence sends your selection, camera and open script to the relay. &quot;
	.. &quot;Studio asks once whether this plugin may reach that domain; allow it.&quot;

type Callbacks = {
	onToggle: () -&gt; (),
	onSaveRelay: (string, string) -&gt; (),
	onViewChanges: () -&gt; (),
}

export type Widget = typeof(setmetatable({} :: {
	gui: DockWidgetPluginGui,
	enabled: boolean,
	relayKind: string,
	switch: Ui.Switch,
	status: TextLabel,
	faces: Frame,
	advanced: TextButton,
	owner: Frame,
	kindHosted: TextButton,
	kindWorker: TextButton,
	kindNtfy: TextButton,
	urlBox: TextBox,
	resolved: TextLabel,
	httpNote: Frame,
	catchup: Frame,
	catchupBody: Frame,
	rows: Frame,
	onViewChanges: () -&gt; (),
	connections: { RBXScriptConnection },
}, Widget))

-- One half of the Worker/ntfy segmented control.
local function segment(parent: Instance, text: string, order: number): TextButton
	local button = Instance.new(&quot;TextButton&quot;)
	button.AutoButtonColor = false
	button.LayoutOrder = order
	button.Size = UDim2.fromOffset(0, 22)
	button.AutomaticSize = Enum.AutomaticSize.X
	button.FontFace = Ui.FONT
	button.TextSize = Ui.TEXT_XS
	button.Text = text
	Ui.pad(button, 0, 10, 0, 10)
	Ui.corner(button, 3)
	button.Parent = parent
	return button
end

function Widget.new(plugin: Plugin, callbacks: Callbacks): Widget
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Right, false, false, 300, 420, 240, 260)
	local gui = plugin:CreateDockWidgetPluginGuiAsync(&quot;RbxNativePresence&quot;, info)
	gui.Title = &quot;Collaborators&quot;
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local scroll = Instance.new(&quot;ScrollingFrame&quot;)
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.CanvasSize = UDim2.new()
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.ScrollBarThickness = 6
	scroll.ScrollBarImageColor3 = Ui.color(&quot;text3&quot;)
	scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	Ui.fill(scroll, &quot;dock&quot;)
	scroll.Parent = gui
	-- One 8 px step everywhere: the edge inset, the gap between blocks and
	-- the cards' own padding, as the editor's docks are spaced. The bar sits
	-- in its own lane so it never covers the content.
	scroll.VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar
	Ui.pad(scroll, Ui.GAP)
	Ui.list(scroll, Ui.GAP)

	-- The note.
	local noteCard = Ui.card(scroll, 1)
	Ui.text(noteCard, NOTE, { size = Ui.TEXT_XS, color = &quot;text2&quot; })

	-- &quot;Share my presence&quot;, with the status under its label: the switch, then
	-- a column holding the label and what the switch is doing.
	local shareRow = Ui.frame(scroll, 2)
	Ui.list(shareRow, Ui.GAP, true).VerticalAlignment = Enum.VerticalAlignment.Top
	local self: Widget
	-- The switch is centred on the label's 18 px line.
	local switchLane = Instance.new(&quot;Frame&quot;)
	switchLane.BackgroundTransparency = 1
	switchLane.Size = UDim2.fromOffset(28, 18)
	switchLane.LayoutOrder = 1
	switchLane.Parent = shareRow
	local switch = Ui.switch(switchLane, function()
		callbacks.onToggle()
	end)
	switch.frame.AnchorPoint = Vector2.new(0, 0.5)
	switch.frame.Position = UDim2.fromScale(0, 0.5)
	local shareText = Ui.frame(shareRow, 2)
	shareText.Size = UDim2.new(1, -(28 + Ui.GAP), 0, 0)
	Ui.list(shareText, 2)
	local toggleLabel = Ui.text(shareText, &quot;Share my presence&quot;, { size = Ui.TEXT_SM, order = 1, wrap = false })
	toggleLabel.Size = UDim2.new(1, 0, 0, 18)
	local status = Ui.text(shareText, &quot;Off&quot;, { size = Ui.TEXT_XS, color = &quot;text2&quot;, order = 2 })

	-- Everyone in rbx-native, as faces, like Studio's own row of collaborators.
	local faces = Ui.frame(scroll, 3)
	faces.Visible = false
	local facesList = Ui.list(faces, 4, true)
	facesList.Padding = UDim.new(0, -4)

	local advanced = Ui.link(scroll, &quot;Show advanced&quot;, 4)
	advanced.TextColor3 = Ui.color(&quot;text3&quot;)
	advanced.FontFace = Ui.FONT

	-- Owner setup, behind the reveal: the transport, its URL, and saving both
	-- into the place for every collaborator.
	local owner = Ui.frame(scroll, 5)
	owner.Visible = false
	Ui.list(owner, 6)
	Ui.text(owner, &quot;Owner setup — saved into the place for everyone&quot;, { size = Ui.TEXT_XS, color = &quot;text3&quot;, order = 1 })

	local kinds = Instance.new(&quot;Frame&quot;)
	kinds.LayoutOrder = 2
	kinds.AutomaticSize = Enum.AutomaticSize.X
	kinds.Size = UDim2.fromOffset(0, 26)
	Ui.fill(kinds, &quot;field_select&quot;)
	Ui.corner(kinds)
	Ui.pad(kinds, 2)
	Ui.list(kinds, 2, true)
	kinds.Parent = owner
	local kindHosted = segment(kinds, &quot;Auto&quot;, 1)
	local kindWorker = segment(kinds, &quot;Worker&quot;, 2)
	local kindNtfy = segment(kinds, &quot;ntfy&quot;, 3)

	local urlBox = Instance.new(&quot;TextBox&quot;)
	urlBox.LayoutOrder = 3
	urlBox.Size = UDim2.new(1, 0, 0, 28)
	urlBox.ClearTextOnFocus = false
	urlBox.PlaceholderText = &quot;Relay URL (blank = Auto, no account needed)&quot;
	urlBox.PlaceholderColor3 = Ui.color(&quot;text3&quot;)
	urlBox.Text = &quot;&quot;
	urlBox.TextXAlignment = Enum.TextXAlignment.Left
	urlBox.FontFace = Ui.FONT
	urlBox.TextSize = Ui.TEXT_SM
	urlBox.TextColor3 = Ui.color(&quot;text&quot;)
	urlBox.TextTruncate = Enum.TextTruncate.AtEnd
	Ui.fill(urlBox, &quot;field_select&quot;)
	Ui.corner(urlBox)
	local urlStroke = Ui.stroke(urlBox, &quot;border&quot;)
	Ui.pad(urlBox, 0, 9, 0, 9)
	urlBox.Parent = owner
	urlBox.Focused:Connect(function()
		urlStroke.Color = Ui.color(&quot;check_on&quot;)
		urlStroke.Transparency = 0.45
	end)
	urlBox.FocusLost:Connect(function()
		urlStroke.Color = Ui.color(&quot;border&quot;)
		urlStroke.Transparency = Ui.alpha(&quot;border&quot;)
	end)

	local saveButton = Ui.button(owner, &quot;Save to place&quot;, false, 4)
	saveButton.Size = UDim2.fromOffset(110, 28)
	local resolved = Ui.text(owner, &quot;&quot;, { size = Ui.TEXT_XS, color = &quot;text3&quot;, order = 5 })

	local httpNote = Ui.card(scroll, 6)
	httpNote.Visible = false
	Ui.text(httpNote, HTTP_NOTE, { size = Ui.TEXT_XS, color = &quot;text2&quot; })

	-- &quot;While you were away&quot;, hidden until something changed.
	local catchup = Ui.card(scroll, 7, 4)
	catchup.Name = &quot;Catchup&quot;
	catchup.Visible = false
	local head = Ui.frame(catchup, 1)
	local title = Ui.text(head, &quot;While you were away&quot;, { size = Ui.TEXT_XS, font = Ui.FONT_SEMIBOLD, wrap = false })
	title.Size = UDim2.new(1, -60, 0, 16)
	local dismiss = Ui.link(head, &quot;Dismiss&quot;)
	dismiss.TextColor3 = Ui.color(&quot;text3&quot;)
	dismiss.FontFace = Ui.FONT
	dismiss.AnchorPoint = Vector2.new(1, 0)
	dismiss.Position = UDim2.fromScale(1, 0)
	local catchupBody = Ui.frame(catchup, 2)
	Ui.list(catchupBody, 3)

	local rows = Ui.frame(scroll, 8)
	Ui.list(rows, Ui.GAP)

	self = setmetatable({
		gui = gui,
		enabled = false,
		relayKind = &quot;hosted&quot;,
		switch = switch,
		status = status,
		faces = faces,
		advanced = advanced,
		owner = owner,
		kindHosted = kindHosted,
		kindWorker = kindWorker,
		kindNtfy = kindNtfy,
		urlBox = urlBox,
		resolved = resolved,
		httpNote = httpNote,
		catchup = catchup,
		catchupBody = catchupBody,
		rows = rows,
		onViewChanges = callbacks.onViewChanges,
		connections = {},
	}, Widget)
	self:showKind()

	table.insert(
		self.connections,
		advanced.Activated:Connect(function()
			owner.Visible = not owner.Visible
			advanced.Text = if owner.Visible then &quot;Hide advanced&quot; else &quot;Show advanced&quot;
		end)
	)
	table.insert(
		self.connections,
		kindHosted.Activated:Connect(function()
			self.relayKind = &quot;hosted&quot;
			self:showKind()
		end)
	)
	table.insert(
		self.connections,
		kindWorker.Activated:Connect(function()
			self.relayKind = &quot;worker&quot;
			self:showKind()
		end)
	)
	table.insert(
		self.connections,
		kindNtfy.Activated:Connect(function()
			self.relayKind = &quot;ntfy&quot;
			self:showKind()
		end)
	)
	table.insert(
		self.connections,
		saveButton.Activated:Connect(function()
			callbacks.onSaveRelay(self.relayKind, (string.gsub(urlBox.Text, &quot;^%s*(.-)%s*$&quot;, &quot;%1&quot;)))
		end)
	)
	table.insert(
		self.connections,
		dismiss.Activated:Connect(function()
			self.catchup.Visible = false
		end)
	)
	return self
end

-- The segmented control's active half: `accent_soft` behind `check_on`.
function Widget.showKind(self: Widget)
	for _, pair in { { self.kindHosted, &quot;hosted&quot; }, { self.kindWorker, &quot;worker&quot; }, { self.kindNtfy, &quot;ntfy&quot; } } do
		local button, kind = pair[1] :: TextButton, pair[2] :: string
		local active = self.relayKind == kind
		Ui.fill(button, if active then &quot;accent_soft&quot; else &quot;field_select&quot;)
		button.TextColor3 = Ui.color(if active then &quot;check_on&quot; else &quot;text2&quot;)
		button.FontFace = if active then Ui.FONT_SEMIBOLD else Ui.FONT
	end
end

function Widget.setEnabled(self: Widget, on: boolean)
	self.enabled = on
	self.switch.set(on)
end

function Widget.setStatus(self: Widget, text: string, failed: boolean?)
	self.status.Text = text
	self.status.TextColor3 = Ui.color(if failed then &quot;text_error&quot; else &quot;text2&quot;)
end

-- Owner setup: show the kind, prefill the URL, and say which relay is in use.
function Widget.setRelay(self: Widget, kind: string, url: string, isCommunity: boolean)
	self.relayKind = kind
	self:showKind()
	if not isCommunity then
		self.urlBox.Text = url
		self.resolved.Text = `Relay: {url} ({kind})`
	else
		self.resolved.Text = &quot;Relay: Auto — hosted by whoever opens the place in rbx-native, no account needed&quot;
	end
end

function Widget.showHttpNote(self: Widget, show: boolean)
	self.httpNote.Visible = show
end

-- &quot;While you were away&quot;: one line per author (value-less, as rbx-native's
-- dock words it), then how many instances changed and &quot;View changes&quot; when
-- there is anything to show. `nil` or an empty summary hides the card.
function Widget.setCatchup(self: Widget, summary: any?)
	for _, child in self.catchupBody:GetChildren() do
		if not child:IsA(&quot;UIListLayout&quot;) then
			child:Destroy()
		end
	end
	if not summary or #summary.authors == 0 then
		self.catchup.Visible = false
		return
	end
	self.catchup.Visible = true
	local order = 0
	for _, author in summary.authors do
		order += 1
		Ui.text(self.catchupBody, Catchup.authorLine(author), { size = Ui.TEXT_XS, color = &quot;text2&quot;, order = order })
	end
	local view = Ui.link(self.catchupBody, &quot;View changes&quot;, order + 1)
	view.Activated:Connect(function()
		self.onViewChanges()
	end)
end

local function detailLines(user: any): { string }
	local lines: { string } = {}
	if #user.selection &gt; 0 then
		table.insert(lines, `Selected: {#user.selection}`)
	end
	if user.script then
		table.insert(lines, `Has {user.script} open`)
	end
	local newest: any = nil
	for _, edit in user.edits do
		if not newest or edit.at &gt;= newest.at then
			newest = edit
		end
	end
	if newest then
		table.insert(lines, `{newest.property} of {newest.path} -&gt; {tostring(newest.value)}`)
	end
	return lines
end

-- One row per rbx-native collaborator: their colour's dot, the name, &quot;Sending
-- presence&quot;, then what they have selected, open and last edited.
function Widget.setUsers(self: Widget, users: { any })
	for _, holder in { self.rows, self.faces } do
		for _, child in holder:GetChildren() do
			if not child:IsA(&quot;UIListLayout&quot;) then
				child:Destroy()
			end
		end
	end
	local shown = 0
	for _, user in users do
		if user.client == &quot;rbx-native&quot; and shown &lt; 8 then
			shown += 1
			local face = Ui.avatar(self.faces, user.userId, Ui.hex(user.color), 26, shown)
			face.Name = user.name
		end
	end
	self.faces.Visible = shown &gt; 0
	for index, user in users do
		if user.client == &quot;rbx-native&quot; then
			local row = Ui.frame(self.rows, index)
			Ui.list(row, 3)
			local line = Ui.frame(row, 1)
			Ui.list(line, 8, true)
			Ui.avatar(line, user.userId, Ui.hex(user.color), 22, 1)
			local name = Ui.text(line, user.name, { size = Ui.TEXT_XS, order = 2, wrap = false })
			name.AutomaticSize = Enum.AutomaticSize.X
			name.Size = UDim2.fromOffset(0, 16)
			local state = Ui.text(line, &quot;Sending presence&quot;, { size = Ui.TEXT_XS, color = &quot;text3&quot;, order = 3, wrap = false })
			state.AutomaticSize = Enum.AutomaticSize.X
			state.Size = UDim2.fromOffset(0, 16)
			for i, text in detailLines(user) do
				local detail = Ui.text(row, text, { size = Ui.TEXT_XS, color = &quot;text2&quot;, order = 1 + i })
				local pad = Instance.new(&quot;UIPadding&quot;)
				pad.PaddingLeft = UDim.new(0, 30)
				pad.Parent = detail
			end
		end
	end
end

function Widget.destroy(self: Widget)
	for _, connection in self.connections do
		connection:Disconnect()
	end
	table.clear(self.connections)
	self.gui:Destroy()
end

return Widget
</ProtectedString>
      </Properties>
    </Item>
  </Item>
</roblox>
