    <Item class="ModuleScript" referent="RBX16">
      <Properties>
        <string name="Name">DiffWindow</string>
        <ProtectedString name="Source">--!strict
--// &quot;Changes while you were away&quot;, drawn like rbx-native's diff window: a
--// header with the change counts as filters and a search, the changed
--// instances on the left (their Explorer icons, grouped as rbx-native
--// groups them), and the selected one on the right, its class, its path,
--// and a table of the properties collaborators edited, with each one's
--// current value, who edited it and when.
--//
--// &quot;Value&quot; is the one the newest edit set, as the editor showed it (sealed
--// in the journal), so an edit a collaborator never saved still shows what
--// they set; an older peer's entry has none, and the place's own value is
--// shown. An instance that no longer resolves (renamed or deleted since) is
--// listed as &quot;Not found&quot;.

local Changes = require(script.Parent.Changes)
local Paths = require(script.Parent.Paths)
local Ui = require(script.Parent.Ui)

local DiffWindow = {}
DiffWindow.__index = DiffWindow

local LIST_WIDTH = 300
local FOOTER_NOTE = &quot;Values are the ones collaborators set; who edited what comes from the presence journal.&quot;

type Filter = &quot;all&quot; | &quot;updated&quot; | &quot;missing&quot;

export type DiffWindow = typeof(setmetatable({} :: {
	gui: DockWidgetPluginGui,
	changes: { Changes.Change },
	found: { [string]: Instance },
	filter: Filter,
	query: string,
	selected: string?,
	subtitle: TextLabel,
	segments: { [Filter]: TextButton },
	counts: { [Filter]: TextLabel },
	searchBox: TextBox,
	list: ScrollingFrame,
	detail: Frame,
}, DiffWindow))

-- A value as the Properties panel words it, and a swatch for a colour.
local function format(value: any): (string, Color3?)
	local kind = typeof(value)
	if value == nil then
		return &quot;—&quot;, nil
	elseif kind == &quot;boolean&quot; then
		return tostring(value), nil
	elseif kind == &quot;number&quot; then
		local text = string.format(&quot;%.3f&quot;, value)
		text = string.gsub(text, &quot;0+$&quot;, &quot;&quot;)
		text = string.gsub(text, &quot;%.$&quot;, &quot;&quot;)
		return text, nil
	elseif kind == &quot;string&quot; then
		local first = string.match(value, &quot;^[^\n]*&quot;) or &quot;&quot;
		if #first &gt; 60 or #first &lt; #value then
			return `&quot;{string.sub(first, 1, 60)}…&quot;`, nil
		end
		return `&quot;{value}&quot;`, nil
	elseif kind == &quot;Vector3&quot; then
		local v = value :: Vector3
		return `({format(v.X)}, {format(v.Y)}, {format(v.Z)})`, nil
	elseif kind == &quot;Vector2&quot; then
		local v = value :: Vector2
		return `({format(v.X)}, {format(v.Y)})`, nil
	elseif kind == &quot;CFrame&quot; then
		local p = (value :: CFrame).Position
		return `pos=({format(p.X)}, {format(p.Y)}, {format(p.Z)})`, nil
	elseif kind == &quot;Color3&quot; then
		local c = value :: Color3
		return `({math.round(c.R * 255)}, {math.round(c.G * 255)}, {math.round(c.B * 255)})`, c
	elseif kind == &quot;BrickColor&quot; then
		return (value :: BrickColor).Name, (value :: BrickColor).Color
	elseif kind == &quot;EnumItem&quot; then
		return (value :: EnumItem).Name, nil
	elseif kind == &quot;Instance&quot; then
		return (value :: Instance).Name, nil
	end
	return tostring(value), nil
end

local function read(instance: Instance?, property: string): (boolean, any)
	if not instance then
		return false, nil
	end
	return pcall(function()
		return (instance :: any)[property]
	end)
end

local function sectionLabel(parent: Instance, text: string, count: number?, order: number, ink: string?)
	local row = Ui.frame(parent, order)
	row.Size = UDim2.new(1, 0, 0, 14)
	row.AutomaticSize = Enum.AutomaticSize.None
	Ui.list(row, 6, true)
	if ink then
		Ui.dot(row, Ui.color(ink)).LayoutOrder = 0
	end
	local label = Ui.text(row, text, { size = Ui.TEXT_XXS, color = &quot;text3&quot;, font = Ui.FONT_BOLD, wrap = false, order = 1 })
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Size = UDim2.fromOffset(0, 14)
	if count then
		local n = Ui.text(row, tostring(count), { size = Ui.TEXT_XXS, color = &quot;text3&quot;, font = Ui.FONT_MONO, wrap = false, order = 2 })
		n.AutomaticSize = Enum.AutomaticSize.X
		n.Size = UDim2.fromOffset(0, 14)
	end
end

local function hairline(parent: Instance, vertical: boolean, position: UDim2, inset: number?)
	local line = Instance.new(&quot;Frame&quot;)
	line.Size = if vertical then UDim2.new(0, 1, 1, -(inset or 0)) else UDim2.new(1, 0, 0, 1)
	line.Position = position
	Ui.fill(line, &quot;border&quot;)
	line.Parent = parent
end

function DiffWindow.new(plugin: Plugin): DiffWindow
	local info = DockWidgetPluginGuiInfo.new(Enum.InitialDockState.Float, false, true, 1000, 640, 560, 420)
	local gui = plugin:CreateDockWidgetPluginGuiAsync(&quot;RbxNativePresenceChanges&quot;, info)
	gui.Title = &quot;Changes while you were away&quot;
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local root = Instance.new(&quot;Frame&quot;)
	root.Size = UDim2.fromScale(1, 1)
	Ui.fill(root, &quot;dock&quot;)
	root.Parent = gui

	-- Header: tile, title and subtitle, the filters, the search. 61 tall.
	local header = Instance.new(&quot;Frame&quot;)
	header.Size = UDim2.new(1, 0, 0, 60)
	header.BackgroundTransparency = 1
	header.Parent = root
	hairline(root, false, UDim2.fromOffset(0, 60))
	Ui.pad(header, 12, 16)

	local tile = Instance.new(&quot;TextLabel&quot;)
	tile.Size = UDim2.fromOffset(28, 28)
	tile.Position = UDim2.new(0, 0, 0.5, -14)
	Ui.fill(tile, &quot;accent_soft&quot;)
	Ui.corner(tile, Ui.RADIUS_TILE)
	tile.FontFace = Ui.FONT_BOLD
	tile.TextSize = 15
	tile.TextColor3 = Ui.color(&quot;check_on&quot;)
	tile.Text = &quot;Δ&quot;
	tile.Parent = header

	local titles = Instance.new(&quot;Frame&quot;)
	titles.BackgroundTransparency = 1
	titles.Position = UDim2.fromOffset(38, 0)
	titles.Size = UDim2.new(1, -38 - 470, 1, 0)
	titles.Parent = header
	Ui.list(titles, 1)
	local titleList = titles:FindFirstChildOfClass(&quot;UIListLayout&quot;) :: UIListLayout
	titleList.VerticalAlignment = Enum.VerticalAlignment.Center
	Ui.text(titles, &quot;Review changes&quot;, { size = Ui.TEXT_LG, font = Ui.FONT_BOLD, wrap = false, order = 1 })
	local subtitle = Ui.text(titles, &quot;&quot;, { size = Ui.TEXT_SM, color = &quot;text2&quot;, wrap = false, order = 2 })

	local controls = Instance.new(&quot;Frame&quot;)
	controls.BackgroundTransparency = 1
	controls.AnchorPoint = Vector2.new(1, 0.5)
	controls.Position = UDim2.fromScale(1, 0.5)
	controls.Size = UDim2.fromOffset(460, 28)
	controls.Parent = header
	local controlsList = Ui.list(controls, 12, true)
	controlsList.HorizontalAlignment = Enum.HorizontalAlignment.Right

	local segmentsFrame = Instance.new(&quot;Frame&quot;)
	segmentsFrame.LayoutOrder = 1
	segmentsFrame.AutomaticSize = Enum.AutomaticSize.X
	segmentsFrame.Size = UDim2.fromOffset(0, 26)
	Ui.fill(segmentsFrame, &quot;field_select&quot;)
	Ui.corner(segmentsFrame)
	Ui.pad(segmentsFrame, 2)
	Ui.list(segmentsFrame, 2, true)
	segmentsFrame.Parent = controls

	local search = Instance.new(&quot;Frame&quot;)
	search.LayoutOrder = 2
	search.Size = UDim2.fromOffset(200, 28)
	Ui.fill(search, &quot;field_select&quot;)
	Ui.corner(search)
	Ui.stroke(search, &quot;border&quot;)
	search.Parent = controls
	local searchBox = Instance.new(&quot;TextBox&quot;)
	searchBox.BackgroundTransparency = 1
	searchBox.Position = UDim2.fromOffset(10, 0)
	searchBox.Size = UDim2.new(1, -20, 1, 0)
	searchBox.ClearTextOnFocus = false
	searchBox.PlaceholderText = &quot;Filter changes&quot;
	searchBox.PlaceholderColor3 = Ui.color(&quot;text3&quot;)
	searchBox.Text = &quot;&quot;
	searchBox.TextXAlignment = Enum.TextXAlignment.Left
	searchBox.FontFace = Ui.FONT
	searchBox.TextSize = Ui.TEXT_SM
	searchBox.TextColor3 = Ui.color(&quot;text&quot;)
	searchBox.Parent = search

	-- Body: the list pane and the detail.
	local list = Instance.new(&quot;ScrollingFrame&quot;)
	list.Position = UDim2.fromOffset(0, 61)
	list.Size = UDim2.new(0, LIST_WIDTH, 1, -61 - 57)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 6
	list.ScrollBarImageColor3 = Ui.color(&quot;text3&quot;)
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.Parent = root
	-- Between the header's hairline and the footer's.
	hairline(root, true, UDim2.new(0, LIST_WIDTH, 0, 61), 61 + 57)

	local detail = Instance.new(&quot;Frame&quot;)
	detail.Position = UDim2.fromOffset(LIST_WIDTH + 1, 61)
	detail.Size = UDim2.new(1, -LIST_WIDTH - 1, 1, -61 - 57)
	detail.BackgroundTransparency = 1
	detail.Parent = root

	-- Footer: the note and Close. 57 tall with its hairline.
	local footer = Instance.new(&quot;Frame&quot;)
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position = UDim2.fromScale(0, 1)
	footer.Size = UDim2.new(1, 0, 0, 56)
	footer.BackgroundTransparency = 1
	footer.Parent = root
	hairline(root, false, UDim2.new(0, 0, 1, -57))
	Ui.pad(footer, 0, 16)
	local note = Ui.text(footer, FOOTER_NOTE, { size = Ui.TEXT_SM, color = &quot;text3&quot;, wrap = false })
	note.Size = UDim2.new(1, -120, 1, 0)
	local close = Ui.button(footer, &quot;Close&quot;, true)
	close.Size = UDim2.fromOffset(96, 34)
	close.AnchorPoint = Vector2.new(1, 0.5)
	close.Position = UDim2.fromScale(1, 0.5)
	close.Activated:Connect(function()
		gui.Enabled = false
	end)

	local self: DiffWindow = setmetatable({
		gui = gui,
		changes = {},
		found = {},
		filter = &quot;all&quot; :: Filter,
		query = &quot;&quot;,
		selected = nil,
		subtitle = subtitle,
		segments = {},
		counts = {},
		searchBox = searchBox,
		list = list,
		detail = detail,
	}, DiffWindow)

	for index, pair in { { &quot;all&quot;, &quot;All&quot; }, { &quot;updated&quot;, &quot;Updated&quot; }, { &quot;missing&quot;, &quot;Not found&quot; } } do
		local filter, label = pair[1] :: Filter, pair[2]
		local button = Instance.new(&quot;TextButton&quot;)
		button.AutoButtonColor = false
		button.LayoutOrder = index
		button.AutomaticSize = Enum.AutomaticSize.X
		button.Size = UDim2.fromOffset(0, 22)
		button.Text = &quot;&quot;
		Ui.corner(button, 3)
		Ui.pad(button, 0, 10, 0, 10)
		Ui.list(button, 5, true)
		local name = Ui.text(button, label, { size = Ui.TEXT_XS, wrap = false, order = 1 })
		name.AutomaticSize = Enum.AutomaticSize.X
		name.Size = UDim2.fromOffset(0, 22)
		name.Name = &quot;Label&quot;
		local count = Ui.text(button, &quot;0&quot;, { size = Ui.TEXT_XXS, font = Ui.FONT_MONO, color = &quot;text3&quot;, wrap = false, order = 2 })
		count.AutomaticSize = Enum.AutomaticSize.X
		count.Size = UDim2.fromOffset(0, 22)
		button.Parent = segmentsFrame
		button.Activated:Connect(function()
			self.filter = filter
			self:render()
		end)
		self.segments[filter] = button
		self.counts[filter] = count
	end

	searchBox:GetPropertyChangedSignal(&quot;Text&quot;):Connect(function()
		self.query = string.lower(searchBox.Text)
		self:render()
	end)
	return self
end

-- Shows `entries` (a journal) and raises the window.
function DiffWindow.show(self: DiffWindow, entries: { any })
	self.changes = Changes.fromJournal(entries)
	table.clear(self.found)
	for _, change in self.changes do
		local instance = Paths.resolve(game, change.path)
		if instance then
			self.found[change.path] = instance
		end
	end
	self.selected = nil
	self.gui.Enabled = true
	self:render()
end

function DiffWindow.visible(self: DiffWindow): { Changes.Change }
	local out = {}
	for _, change in self.changes do
		local missing = self.found[change.path] == nil
		local passes = self.filter == &quot;all&quot;
			or (self.filter == &quot;updated&quot; and not missing)
			or (self.filter == &quot;missing&quot; and missing)
		local matches = self.query == &quot;&quot;
			or string.find(string.lower(change.path), self.query, 1, true) ~= nil
		if passes and matches then
			table.insert(out, change)
		end
	end
	return out
end

function DiffWindow.render(self: DiffWindow)
	local updated, missing = 0, 0
	for _, change in self.changes do
		if self.found[change.path] then
			updated += 1
		else
			missing += 1
		end
	end
	local total = updated + missing
	self.subtitle.Text = `{total} {if total == 1 then &quot;change&quot; else &quot;changes&quot;} by collaborators since you were last here`

	local counts: { [Filter]: number } = { all = total, updated = updated, missing = missing }
	for filter, button in self.segments do
		local active = self.filter == filter
		local enabled = counts[filter] &gt; 0
		Ui.fill(button, if active then &quot;accent_soft&quot; else &quot;field_select&quot;)
		local label = button:FindFirstChild(&quot;Label&quot;) :: TextLabel
		label.TextColor3 = Ui.color(if active then &quot;check_on&quot; elseif enabled then &quot;text2&quot; else &quot;text3&quot;)
		label.FontFace = if active then Ui.FONT_SEMIBOLD else Ui.FONT
		self.counts[filter].Text = tostring(counts[filter])
		self.counts[filter].TextColor3 = Ui.color(if active then &quot;check_on&quot; else &quot;text3&quot;)
	end

	local visible = self:visible()
	local stillVisible = false
	for _, change in visible do
		if change.path == self.selected then
			stillVisible = true
		end
	end
	if not stillVisible then
		self.selected = if #visible &gt; 0 then visible[1].path else nil
	end
	self:renderList(visible)
	self:renderDetail()
end

function DiffWindow.renderList(self: DiffWindow, visible: { Changes.Change })
	for _, child in self.list:GetChildren() do
		child:Destroy()
	end
	Ui.pad(self.list, 10, 8, 12, 8)
	Ui.list(self.list, 2)

	local groups = {
		{ title = &quot;UPDATES&quot;, ink = &quot;check_on&quot;, marker = &quot;~&quot;, missing = false },
		{ title = &quot;NOT FOUND&quot;, ink = &quot;text_error&quot;, marker = &quot;−&quot;, missing = true },
	}
	local order = 0
	for _, group in groups do
		local members = {}
		for _, change in visible do
			if (self.found[change.path] == nil) == group.missing then
				table.insert(members, change)
			end
		end
		if #members &gt; 0 then
			order += 1
			local head = Ui.frame(self.list, order)
			Ui.pad(head, 6, 6, 4, 8)
			sectionLabel(head, group.title, #members, 1, group.ink)
			for _, change in members do
				order += 1
				self:listRow(change, group.marker, order)
			end
		end
	end
	if order == 0 then
		Ui.text(self.list, &quot;No changes match.&quot;, { size = Ui.TEXT_SM, color = &quot;text3&quot; })
	end
end

function DiffWindow.listRow(self: DiffWindow, change: Changes.Change, marker: string, order: number)
	local selected = self.selected == change.path
	local row = Instance.new(&quot;TextButton&quot;)
	row.AutoButtonColor = false
	row.Text = &quot;&quot;
	row.LayoutOrder = order
	row.Size = UDim2.new(1, 0, 0, 40)
	Ui.fill(row, if selected then &quot;ribbon_tab_active&quot; else &quot;dock&quot;)
	if not selected then
		row.BackgroundTransparency = 1
	end
	Ui.corner(row)
	row.Parent = self.list

	local mark = Ui.text(row, marker, { size = Ui.TEXT_SM, color = &quot;text3&quot;, font = Ui.FONT_MONO, wrap = false })
	mark.Position = UDim2.fromOffset(10, 0)
	mark.Size = UDim2.new(0, 10, 1, 0)
	local instance = self.found[change.path]
	local icon = Ui.classIcon(row, if instance then instance.ClassName else &quot;Folder&quot;, 16)
	icon.Position = UDim2.new(0, 26, 0.5, -8)

	local name = Ui.text(row, change.name, { size = Ui.TEXT_SM, font = if selected then Ui.FONT_SEMIBOLD else Ui.FONT, wrap = false })
	name.Position = UDim2.fromOffset(50, 4)
	name.Size = UDim2.new(1, -120, 0, 16)
	local path = Ui.text(row, change.parent, { size = Ui.TEXT_XS, color = &quot;text3&quot;, wrap = false })
	path.Position = UDim2.fromOffset(50, 21)
	path.Size = UDim2.new(1, -120, 0, 14)
	local n = #change.properties
	local count = Ui.text(row, `{n} {if n == 1 then &quot;prop&quot; else &quot;props&quot;}`, { size = Ui.TEXT_XS, color = &quot;text3&quot;, font = Ui.FONT_MONO, wrap = false })
	count.AnchorPoint = Vector2.new(1, 0)
	count.Position = UDim2.new(1, -10, 0, 0)
	count.Size = UDim2.new(0, 60, 1, 0)
	count.TextXAlignment = Enum.TextXAlignment.Right

	row.MouseEnter:Connect(function()
		if self.selected ~= change.path then
			Ui.fill(row, &quot;hover&quot;)
		end
	end)
	row.MouseLeave:Connect(function()
		if self.selected ~= change.path then
			row.BackgroundTransparency = 1
		end
	end)
	row.Activated:Connect(function()
		self.selected = change.path
		self:render()
	end)
end

function DiffWindow.renderDetail(self: DiffWindow)
	for _, child in self.detail:GetChildren() do
		child:Destroy()
	end
	local change: Changes.Change? = nil
	for _, c in self.changes do
		if c.path == self.selected then
			change = c
		end
	end
	if not change then
		local empty = Ui.text(self.detail, &quot;No change selected&quot;, { size = Ui.TEXT_MD, color = &quot;text3&quot;, wrap = false })
		empty.Size = UDim2.fromScale(1, 1)
		empty.TextXAlignment = Enum.TextXAlignment.Center
		return
	end
	local c = change :: Changes.Change
	local instance = self.found[c.path]

	-- Header: icon tile, name, class badge, kind pill, stats; the path under it.
	local head = Instance.new(&quot;Frame&quot;)
	head.Size = UDim2.new(1, 0, 0, 74)
	head.BackgroundTransparency = 1
	head.Parent = self.detail
	hairline(self.detail, false, UDim2.fromOffset(0, 74))
	Ui.pad(head, 16, 20, 14, 20)

	local top = Instance.new(&quot;Frame&quot;)
	top.Size = UDim2.new(1, 0, 0, 28)
	top.BackgroundTransparency = 1
	top.Parent = head
	Ui.list(top, 10, true)
	local tile = Instance.new(&quot;Frame&quot;)
	tile.Size = UDim2.fromOffset(28, 28)
	tile.LayoutOrder = 1
	Ui.fill(tile, &quot;field_select&quot;)
	Ui.corner(tile, Ui.RADIUS_TILE)
	tile.Parent = top
	local icon = Ui.classIcon(tile, if instance then instance.ClassName else &quot;Folder&quot;, 16)
	icon.Position = UDim2.fromOffset(6, 6)
	local name = Ui.text(top, c.name, { size = 15, font = Ui.FONT_BOLD, wrap = false, order = 2 })
	name.AutomaticSize = Enum.AutomaticSize.X
	name.Size = UDim2.fromOffset(0, 28)
	if instance then
		local badge = Instance.new(&quot;Frame&quot;)
		badge.LayoutOrder = 3
		badge.AutomaticSize = Enum.AutomaticSize.X
		badge.Size = UDim2.fromOffset(0, 20)
		badge.BackgroundTransparency = 1
		Ui.corner(badge, Ui.RADIUS_BADGE)
		Ui.stroke(badge, &quot;border2&quot;)
		Ui.pad(badge, 0, 6, 0, 6)
		local cls = Ui.text(badge, instance.ClassName, { size = Ui.TEXT_XS, color = &quot;text2&quot;, font = Ui.FONT_MONO, wrap = false })
		cls.AutomaticSize = Enum.AutomaticSize.X
		cls.Size = UDim2.fromOffset(0, 20)
		badge.Parent = top
		Ui.pill(top, &quot;Updated&quot;, &quot;accent_soft&quot;, &quot;check_on&quot;, 4)
	else
		Ui.pill(top, &quot;Not found&quot;, &quot;diff_remove_pill&quot;, &quot;text_error&quot;, 4)
	end

	local n = #c.properties
	local stats = Ui.text(head, `{n} {if n == 1 then &quot;property&quot; else &quot;properties&quot;}`, { size = Ui.TEXT_XS, color = &quot;text3&quot;, font = Ui.FONT_MONO, wrap = false })
	stats.AnchorPoint = Vector2.new(1, 0)
	stats.Position = UDim2.fromScale(1, 0)
	stats.Size = UDim2.fromOffset(120, 28)
	stats.TextXAlignment = Enum.TextXAlignment.Right

	local path = Ui.text(head, c.path, { size = Ui.TEXT_XS, color = &quot;text3&quot;, font = Ui.FONT_MONO, wrap = false })
	path.Position = UDim2.fromOffset(38, 34)
	path.Size = UDim2.new(1, -38 - 80, 0, 16)
	if instance then
		local select = Ui.link(head, &quot;Select&quot;)
		select.AnchorPoint = Vector2.new(1, 0)
		select.Position = UDim2.new(1, 0, 0, 34)
		select.Activated:Connect(function()
			game:GetService(&quot;Selection&quot;):Set({ instance :: Instance })
		end)
	end

	-- Body: PROPERTIES, then the table, scrolling when long.
	local body = Instance.new(&quot;ScrollingFrame&quot;)
	body.Position = UDim2.fromOffset(0, 75)
	body.Size = UDim2.new(1, 0, 1, -75)
	body.BackgroundTransparency = 1
	body.BorderSizePixel = 0
	body.CanvasSize = UDim2.new()
	body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.ScrollBarThickness = 6
	body.ScrollBarImageColor3 = Ui.color(&quot;text3&quot;)
	body.ScrollingDirection = Enum.ScrollingDirection.Y
	body.Parent = self.detail
	Ui.pad(body, 16, 20, 20, 20)
	Ui.list(body, 10)
	sectionLabel(body, &quot;PROPERTIES&quot;, nil, 1)

	local tableFrame = Ui.frame(body, 2)
	Ui.corner(tableFrame)
	Ui.stroke(tableFrame, &quot;border&quot;)
	Ui.list(tableFrame, 0)

	local function cells(row: Frame, height: number)
		local columns = {
			{ UDim2.new(0, 170, 0, height), 0 },
			{ UDim2.new(1, -170 - 150 - 90, 0, height), 1 },
			{ UDim2.new(0, 150, 0, height), 2 },
			{ UDim2.new(0, 90, 0, height), 3 },
		}
		local out = {}
		for _, col in columns do
			local cell = Instance.new(&quot;Frame&quot;)
			cell.BackgroundTransparency = 1
			cell.Size = col[1]
			cell.LayoutOrder = col[2]
			cell.Parent = row
			local layout = Ui.list(cell, 0, true)
			layout.VerticalAlignment = Enum.VerticalAlignment.Center
			table.insert(out, cell)
		end
		return out
	end

	local headRow = Instance.new(&quot;Frame&quot;)
	headRow.Size = UDim2.new(1, 0, 0, 28)
	headRow.BackgroundTransparency = 1
	headRow.LayoutOrder = 0
	headRow.Parent = tableFrame
	Ui.pad(headRow, 0, 12)
	Ui.list(headRow, 0, true)
	local headCells = cells(headRow, 28)
	for i, title in { &quot;PROPERTY&quot;, &quot;VALUE&quot;, &quot;EDITED BY&quot;, &quot;WHEN&quot; } do
		Ui.text(headCells[i], title, { size = Ui.TEXT_XXS, color = &quot;text3&quot;, font = Ui.FONT_BOLD, wrap = false })
	end

	local now = DateTime.now().UnixTimestampMillis
	for index, edit in c.properties do
		local line = Instance.new(&quot;Frame&quot;)
		line.Size = UDim2.new(1, 0, 0, 1)
		line.LayoutOrder = index * 2 - 1
		Ui.fill(line, &quot;border&quot;)
		line.Parent = tableFrame

		local row = Instance.new(&quot;Frame&quot;)
		row.Size = UDim2.new(1, 0, 0, 36)
		row.BackgroundTransparency = 1
		row.LayoutOrder = index * 2
		row.Parent = tableFrame
		Ui.pad(row, 0, 12)
		Ui.list(row, 0, true)
		local cols = cells(row, 36)
		Ui.text(cols[1], edit.property, { size = Ui.TEXT_SM, wrap = false })
		local ok, value = read(instance, edit.property)
		if edit.value ~= &quot;&quot; then
			Ui.chip(cols[2], edit.value)
		elseif ok then
			local text, swatch = format(value)
			Ui.chip(cols[2], text, swatch)
		else
			Ui.text(cols[2], &quot;—&quot;, { size = Ui.TEXT_SM, color = &quot;text3&quot;, wrap = false })
		end
		local by = table.concat(edit.authors, &quot;, &quot;)
		if edit.edits &gt; 1 then
			by ..= ` ({edit.edits} edits)`
		end
		Ui.text(cols[3], by, { size = Ui.TEXT_XS, color = &quot;text2&quot;, wrap = false })
		Ui.text(cols[4], Changes.ago(edit.at, now), { size = Ui.TEXT_XS, color = &quot;text3&quot;, font = Ui.FONT_MONO, wrap = false })
	end
end

function DiffWindow.destroy(self: DiffWindow)
	self.gui:Destroy()
end

return DiffWindow
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX17">
      <Properties>
        <string name="Name">Edits</string>
        <ProtectedString name="Source">--!strict
--! Tracks which property changes were made by the local user. Studio fires
--! property signals for replicated changes too, so only changes inside a
--! committed ChangeHistory recording (or just after an undo/redo) count.
--! Times are passed in, which keeps the logic testable without Studio.

local Schema = require(script.Parent.Schema)

local Edits = {}

Edits.UNDO_WINDOW_MS = 250
Edits.STALE_RECORDING_MS = 10000
Edits.KEEP_MS = 60000
Edits.MERGE_MS = 2000
local MAX_VALUE = 80

local Tracker = {}
Tracker.__index = Tracker

function Edits.new(): any
	return setmetatable({
		depth = 0,
		startedAt = 0,
		buffer = {},
		undoUntil = -math.huge,
		loose = {},
		noted = {},
	}, Tracker)
end

local function dropStale(self: any, now: number)
	if self.depth &gt; 0 and now - self.startedAt &gt; Edits.STALE_RECORDING_MS then
		self.depth = 0
		self.buffer = {}
	end
end

local function note(self: any, edit: any)
	local value = edit.value
	if type(value) ~= &quot;string&quot; then
		value = tostring(value)
	end
	local text: string = value
	if #text &gt; MAX_VALUE then
		text = text:sub(1, MAX_VALUE)
	end
	for _, existing in ipairs(self.noted) do
		if existing.path == edit.path and existing.property == edit.property and edit.at - existing.at &lt;= Edits.MERGE_MS then
			existing.value = text
			existing.at = edit.at
			return
		end
	end
	table.insert(self.noted, { path = edit.path, property = edit.property, value = text, at = edit.at })
	while #self.noted &gt; Schema.MAX_EDITS do
		table.remove(self.noted, 1)
	end
end

function Tracker.recordingStarted(self: any, now: number)
	dropStale(self, now)
	if self.depth == 0 then
		self.startedAt = now
		self.buffer = {}
	end
	self.depth += 1
end

function Tracker.recordingFinished(self: any, committed: boolean, now: number)
	dropStale(self, now)
	if self.depth == 0 then
		return
	end
	self.depth -= 1
	if self.depth &gt; 0 then
		return
	end
	local buffered = self.buffer
	self.buffer = {}
	if committed then
		for _, edit in ipairs(buffered) do
			note(self, edit)
		end
	end
end

-- Undo and redo apply their changes around the moment OnUndo/OnRedo fires,
-- and the order of the two signals is not documented, so changes from just
-- before it count as well as changes just after.
function Tracker.undoRedo(self: any, now: number)
	self.undoUntil = now + Edits.UNDO_WINDOW_MS
	for _, edit in ipairs(self.loose) do
		if now - edit.at &lt;= Edits.UNDO_WINDOW_MS then
			note(self, edit)
		end
	end
	self.loose = {}
end

function Tracker.changed(self: any, path: string, property: string, value: any, now: number)
	dropStale(self, now)
	local edit = { path = path, property = property, value = value, at = now }
	if self.depth &gt; 0 then
		table.insert(self.buffer, edit)
	elseif now &lt;= self.undoUntil then
		note(self, edit)
	else
		-- Unattributed for now; an undo or redo signalled just after claims it.
		local kept = {}
		for _, old in ipairs(self.loose) do
			if now - old.at &lt;= Edits.UNDO_WINDOW_MS then
				table.insert(kept, old)
			end
		end
		table.insert(kept, edit)
		self.loose = kept
	end
end

function Tracker.recent(self: any, now: number): {any}
	local out: {any} = {}
	for _, edit in ipairs(self.noted) do
		if now - edit.at &lt; Edits.KEEP_MS then
			table.insert(out, { path = edit.path, property = edit.property, value = edit.value, at = edit.at })
		end
	end
	return out
end

return Edits
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX18">
      <Properties>
        <string name="Name">Hmac</string>
        <ProtectedString name="Source">--!strict
-- HMAC-SHA256 (RFC 2104) with the 64-byte SHA-256 block size.

local Sha256 = require(script.Parent.Sha256)

local BLOCK = 64

local Hmac = {}

function Hmac.sha256Hex(key: string, msg: string): string
	if #key &gt; BLOCK then
		key = Sha256.raw(key)
	end
	key = key .. string.rep(&quot;\0&quot;, BLOCK - #key)
	local inner: {string} = {}
	local outer: {string} = {}
	for i = 1, BLOCK do
		local b = string.byte(key, i)
		inner[i] = string.char(bit32.bxor(b, 0x36))
		outer[i] = string.char(bit32.bxor(b, 0x5c))
	end
	local innerHash = Sha256.raw(table.concat(inner) .. msg)
	return Sha256.hex(table.concat(outer) .. innerHash)
end

return Hmac
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX19">
      <Properties>
        <string name="Name">Json</string>
        <ProtectedString name="Source">--!strict
--! Minimal deterministic JSON codec: sorted object keys and canonical number
--! formatting so both ends of the relay produce byte-identical text.

local Json = {}

Json.null = setmetatable({}, {
	__tostring = function()
		return &quot;null&quot;
	end,
})

local arrays: {[any]: boolean} = setmetatable({}, { __mode = &quot;k&quot; }) :: any

function Json.array(t: {any}?): {any}
	local result: {any} = t or {}
	arrays[result] = true
	return result
end

function Json.isArray(t: any): boolean
	if arrays[t] then
		return true
	end
	local n = #t
	if n == 0 then
		return false
	end
	local count = 0
	for _ in pairs(t) do
		count += 1
	end
	return count == n
end

local ESCAPES: {[string]: string} = {
	['&quot;'] = '\\&quot;',
	[&quot;\\&quot;] = &quot;\\\\&quot;,
	[&quot;\b&quot;] = &quot;\\b&quot;,
	[&quot;\f&quot;] = &quot;\\f&quot;,
	[&quot;\n&quot;] = &quot;\\n&quot;,
	[&quot;\r&quot;] = &quot;\\r&quot;,
	[&quot;\t&quot;] = &quot;\\t&quot;,
}

local function encodeString(s: string): string
	local escaped = s:gsub('[%c&quot;\\]', function(c: string): string
		return ESCAPES[c] or string.format(&quot;\\u%04x&quot;, string.byte(c))
	end)
	return '&quot;' .. escaped .. '&quot;'
end

local function encodeNumber(n: number): string
	if n ~= n or n == math.huge or n == -math.huge then
		error(&quot;cannot encode non-finite number&quot;)
	end
	if n == 0 then
		return &quot;0&quot;
	end
	if n % 1 == 0 and math.abs(n) &lt; 2 ^ 53 then
		return string.format(&quot;%.0f&quot;, n)
	end
	local short = string.format(&quot;%.14g&quot;, n)
	if tonumber(short) == n then
		return short
	end
	return string.format(&quot;%.17g&quot;, n)
end

local function encodeValue(value: any, out: {string})
	local kind = type(value)
	if value == Json.null or value == nil then
		table.insert(out, &quot;null&quot;)
	elseif kind == &quot;boolean&quot; then
		table.insert(out, if value then &quot;true&quot; else &quot;false&quot;)
	elseif kind == &quot;number&quot; then
		table.insert(out, encodeNumber(value))
	elseif kind == &quot;string&quot; then
		table.insert(out, encodeString(value))
	elseif kind == &quot;table&quot; then
		if Json.isArray(value) then
			table.insert(out, &quot;[&quot;)
			for i = 1, #value do
				if i &gt; 1 then
					table.insert(out, &quot;,&quot;)
				end
				encodeValue(value[i], out)
			end
			table.insert(out, &quot;]&quot;)
		else
			local keys: {string} = {}
			for k in pairs(value) do
				if type(k) ~= &quot;string&quot; then
					error(&quot;object keys must be strings&quot;)
				end
				table.insert(keys, k)
			end
			table.sort(keys)
			table.insert(out, &quot;{&quot;)
			for i, k in ipairs(keys) do
				if i &gt; 1 then
					table.insert(out, &quot;,&quot;)
				end
				table.insert(out, encodeString(k))
				table.insert(out, &quot;:&quot;)
				encodeValue(value[k], out)
			end
			table.insert(out, &quot;}&quot;)
		end
	else
		error(&quot;cannot encode value of type &quot; .. kind)
	end
end

function Json.encode(value: any): string
	local out: {string} = {}
	encodeValue(value, out)
	return table.concat(out)
end

local function fail(text: string, pos: number, what: string): never
	error(string.format(&quot;json: %s at byte %d&quot;, what, pos), 0)
end

local function skip(text: string, pos: number): number
	local _, e = text:find(&quot;^[ \t\r\n]*&quot;, pos)
	return (e :: number) + 1
end

local SIMPLE: {[string]: string} = {
	['&quot;'] = '&quot;',
	[&quot;\\&quot;] = &quot;\\&quot;,
	[&quot;/&quot;] = &quot;/&quot;,
	b = &quot;\b&quot;,
	f = &quot;\f&quot;,
	n = &quot;\n&quot;,
	r = &quot;\r&quot;,
	t = &quot;\t&quot;,
}

local function parseHex4(text: string, pos: number): number
	local hex = text:match(&quot;^%x%x%x%x&quot;, pos)
	if not hex then
		fail(text, pos, &quot;bad unicode escape&quot;)
	end
	return tonumber(hex, 16) :: number
end

local function parseString(text: string, pos: number): (string, number)
	local parts: {string} = {}
	local i = pos + 1
	while true do
		local s, e = text:find('^[^&quot;\\%c]+', i)
		if s then
			table.insert(parts, text:sub(s, e))
			i = (e :: number) + 1
		end
		local c = text:sub(i, i)
		if c == '&quot;' then
			return table.concat(parts), i + 1
		elseif c == &quot;\\&quot; then
			local esc = text:sub(i + 1, i + 1)
			if esc == &quot;u&quot; then
				local code = parseHex4(text, i + 2)
				i += 6
				if code &gt;= 0xD800 and code &lt;= 0xDBFF then
					if text:sub(i, i + 1) ~= &quot;\\u&quot; then
						fail(text, i, &quot;lone surrogate&quot;)
					end
					local low = parseHex4(text, i + 2)
					if low &lt; 0xDC00 or low &gt; 0xDFFF then
						fail(text, i, &quot;bad surrogate pair&quot;)
					end
					code = 0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)
					i += 6
				elseif code &gt;= 0xDC00 and code &lt;= 0xDFFF then
					fail(text, i, &quot;lone surrogate&quot;)
				end
				table.insert(parts, utf8.char(code))
			else
				local simple = SIMPLE[esc]
				if not simple then
					fail(text, i, &quot;bad escape&quot;)
				end
				table.insert(parts, simple)
				i += 2
			end
		else
			fail(text, i, &quot;unterminated or invalid string&quot;)
		end
	end
end

local parseValue

local function parseNumber(text: string, pos: number): (number, number)
	local literal = text:match(&quot;^-?%d+%.?%d*[eE]?[+-]?%d*&quot;, pos)
	local n = literal and tonumber(literal)
	if not literal or not n then
		fail(text, pos, &quot;bad number&quot;)
	end
	return n :: number, pos + #(literal :: string)
end

function parseValue(text: string, pos: number): (any, number)
	pos = skip(text, pos)
	local c = text:sub(pos, pos)
	if c == &quot;{&quot; then
		local obj: {[string]: any} = {}
		pos = skip(text, pos + 1)
		if text:sub(pos, pos) == &quot;}&quot; then
			return obj, pos + 1
		end
		while true do
			pos = skip(text, pos)
			if text:sub(pos, pos) ~= '&quot;' then
				fail(text, pos, &quot;expected object key&quot;)
			end
			local key
			key, pos = parseString(text, pos)
			pos = skip(text, pos)
			if text:sub(pos, pos) ~= &quot;:&quot; then
				fail(text, pos, &quot;expected ':'&quot;)
			end
			local value
			value, pos = parseValue(text, pos + 1)
			obj[key] = value
			pos = skip(text, pos)
			local d = text:sub(pos, pos)
			if d == &quot;}&quot; then
				return obj, pos + 1
			elseif d ~= &quot;,&quot; then
				fail(text, pos, &quot;expected ',' or '}'&quot;)
			end
			pos += 1
		end
	elseif c == &quot;[&quot; then
		local arr = Json.array()
		pos = skip(text, pos + 1)
		if text:sub(pos, pos) == &quot;]&quot; then
			return arr, pos + 1
		end
		while true do
			local value
			value, pos = parseValue(text, pos)
			table.insert(arr, value)
			pos = skip(text, pos)
			local d = text:sub(pos, pos)
			if d == &quot;]&quot; then
				return arr, pos + 1
			elseif d ~= &quot;,&quot; then
				fail(text, pos, &quot;expected ',' or ']'&quot;)
			end
			pos += 1
		end
	elseif c == '&quot;' then
		return parseString(text, pos)
	elseif text:sub(pos, pos + 3) == &quot;true&quot; then
		return true, pos + 4
	elseif text:sub(pos, pos + 4) == &quot;false&quot; then
		return false, pos + 5
	elseif text:sub(pos, pos + 3) == &quot;null&quot; then
		return Json.null, pos + 4
	elseif c == &quot;-&quot; or c:match(&quot;%d&quot;) then
		return parseNumber(text, pos)
	end
	fail(text, pos, &quot;unexpected character&quot;)
end

function Json.decode(text: string): any
	local value, pos = parseValue(text, 1)
	pos = skip(text, pos)
	if pos &lt;= #text then
		fail(text, pos, &quot;trailing data&quot;)
	end
	return value
end

return Json
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX20">
      <Properties>
        <string name="Name">Markers</string>
        <ProtectedString name="Source">--!strict
--// Renders rbx-native collaborators' selections and cameras inside Studio.
--// Only &quot;rbx-native&quot; users are drawn: Studio already shows Team Create peers.

local Paths = require(script.Parent.Paths)

local FOLDER_NAME = &quot;RbxNativePresence&quot;

local Markers = {}
Markers.__index = Markers

export type Markers = typeof(setmetatable({} :: {
	folder: Folder?,
	camera: Camera?,
	items: { [string]: Instance },
}, Markers))

local function parseColor(hex: string): Color3
	local r, g, b = string.match(hex, &quot;^#(%x%x)(%x%x)(%x%x)$&quot;)
	if not r then
		return Color3.new(1, 1, 1)
	end
	return Color3.fromRGB(tonumber(r, 16) :: number, tonumber(g, 16) :: number, tonumber(b, 16) :: number)
end

local function tag&lt;T&gt;(instance: T &amp; Instance): T
	instance.Archivable = false
	return instance
end

function Markers.new(): Markers
	return setmetatable({ folder = nil, camera = nil, items = {} }, Markers)
end

function Markers.ensureFolder(self: Markers): Folder?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	if self.camera ~= camera or not self.folder or self.folder.Parent ~= camera then
		self:clear()
		local folder = Instance.new(&quot;Folder&quot;)
		folder.Name = FOLDER_NAME
		folder.Archivable = false
		folder.Parent = camera
		self.folder = folder
		self.camera = camera
	end
	return self.folder
end

function Markers.clear(self: Markers)
	if self.folder then
		self.folder:Destroy()
	end
	self.folder = nil
	self.camera = nil
	table.clear(self.items)
end

local function makeCamera(folder: Folder, user: any): Part
	local part = Instance.new(&quot;Part&quot;)
	part.Archivable = false
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Locked = true
	part.Size = Vector3.new(1, 0.6, 1.5)
	part.Material = Enum.Material.Neon
	part.Transparency = 0.3
	part.Name = &quot;Camera&quot;

	local gui = Instance.new(&quot;BillboardGui&quot;)
	gui.Archivable = false
	gui.Size = UDim2.fromOffset(120, 24)
	gui.StudsOffset = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = true
	gui.Adornee = part
	gui.Parent = part

	local label = Instance.new(&quot;TextLabel&quot;)
	label.Archivable = false
	label.Name = &quot;Label&quot;
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.BuilderSansBold
	label.TextSize = 16
	label.TextStrokeTransparency = 0.5
	label.Parent = gui

	part.Parent = folder
	return part
end

function Markers.render(self: Markers, users: { any })
	local folder = self:ensureFolder()
	if not folder then
		return
	end
	local wanted: { [string]: boolean } = {}

	for _, user in users do
		-- Only rbx-native senders: Studio draws its own collaborators. The
		-- signed-in user in rbx-native is drawn too (another machine).
		if user.client == &quot;rbx-native&quot; then
			local color = parseColor(user.color)
			for index, path in user.selection do
				local target = Paths.resolve(game, path)
				if target then
					local key = `{user.userId}/sel/{index}`
					wanted[key] = true
					local box = self.items[key] :: SelectionBox?
					if not box then
						local created = Instance.new(&quot;SelectionBox&quot;)
						created.Archivable = false
						created.LineThickness = 0.05
						created.SurfaceTransparency = 1
						created.Parent = folder
						self.items[key] = created
						box = created
					end
					local b = box :: SelectionBox
					b.Adornee = target
					b.Color3 = color
				end
			end
			if user.camera then
				local key = `{user.userId}/cam`
				wanted[key] = true
				local part = self.items[key] :: Part?
				if not part then
					part = makeCamera(folder, user)
					self.items[key] = part :: Part
				end
				local p = part :: Part
				p.Color = color
				p.CFrame = CFrame.new(table.unpack(user.camera))
				local label = p:FindFirstChild(&quot;Label&quot;, true) :: TextLabel?
				if label then
					label.Text = user.name
					label.TextColor3 = color
				end
			end
		end
	end

	for key, instance in self.items do
		if not wanted[key] then
			instance:Destroy()
			self.items[key] = nil
		end
	end
end

function Markers.destroy(self: Markers)
	self:clear()
end

return Markers
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX21">
      <Properties>
        <string name="Name">Ntfy</string>
        <ProtectedString name="Source">--!strict
--! The ntfy wire format, mirrored from crates/rbx_presence/src/ntfy.rs: one
--! user's signed presence, wrapped for a plain ntfy pub/sub server and
--! verified by peers. ntfy does no auth of its own, so trust is entirely the
--! HMAC key both sides derive from the place secret. A receiver signs over
--! the message text exactly as received, so Studio and rbx-native senders
--! interoperate without agreeing on JSON byte order. Pure (no HttpService),
--! so it runs in the shared Luau golden tests.

local Auth = require(script.Parent.Auth)
local Json = require(script.Parent.Json)
local Schema = require(script.Parent.Schema)

local Ntfy = {}

Ntfy.CLOCK_SKEW_MS = 60000

-- The canonical path a topic's messages are signed under.
function Ntfy.signPath(topic: string): string
	return &quot;/&quot; .. topic
end

-- A signed envelope string for `state` published to `topic`.
function Ntfy.encode(
	key: string,
	encKey: string,
	room: string,
	topic: string,
	userId: number,
	ts: number,
	state: any,
	nonceFor: () -&gt; string
): string
	local d = Schema.sealState(encKey, room, state, nonceFor)
	local sig = Auth.sign(key, Auth.canonical(&quot;POST&quot;, Ntfy.signPath(topic), userId, ts, d))
	return Json.encode({ u = userId, t = ts, s = sig, d = d })
end

Ntfy.MAX_BODY = 4096

-- Like encode, but sheds detail until the envelope fits MAX_BODY: oldest
-- edits, then selection, then camera, then script. If even the identity is
-- too big, the smallest encoding is returned.
function Ntfy.fitEncode(
	key: string,
	encKey: string,
	room: string,
	topic: string,
	userId: number,
	ts: number,
	state: any,
	nonceFor: () -&gt; string
): string
	local copy = table.clone(state)
	copy.edits = table.clone(state.edits or {})
	copy.selection = table.clone(state.selection or {})
	while true do
		local body = Ntfy.encode(key, encKey, room, topic, userId, ts, copy, nonceFor)
		if #body &lt;= Ntfy.MAX_BODY then
			return body
		end
		if #copy.edits &gt; 0 then
			table.remove(copy.edits, 1)
		elseif #copy.selection &gt; 0 then
			table.remove(copy.selection)
		elseif copy.camera ~= nil then
			copy.camera = nil
		elseif copy.script ~= nil then
			copy.script = nil
		else
			return body
		end
	end
end

-- Verifies and decodes `body`, returning the UserState or nil for anything
-- that fails a check (bad JSON, stale time, bad signature, id mismatch).
function Ntfy.decode(key: string, encKey: string, room: string, topic: string, nowMs: number, body: string): any?
	local ok, envelope = pcall(Json.decode, body)
	if not ok or type(envelope) ~= &quot;table&quot; then
		return nil
	end
	local u = envelope.u
	local t = envelope.t
	local s = envelope.s
	local d = envelope.d
	if type(u) ~= &quot;number&quot; or type(t) ~= &quot;number&quot; or type(s) ~= &quot;string&quot; or type(d) ~= &quot;string&quot; then
		return nil
	end
	if math.abs(nowMs - t) &gt; Ntfy.CLOCK_SKEW_MS then
		return nil
	end
	if Auth.sign(key, Auth.canonical(&quot;POST&quot;, Ntfy.signPath(topic), u, t, d)) ~= s then
		return nil
	end
	local sealed
	ok, sealed = pcall(Json.decode, d)
	if not ok then
		return nil
	end
	local decoded = Schema.openState(encKey, room, sealed)
	if decoded == nil or decoded.userId ~= u then
		return nil
	end
	return decoded
end

-- The ntfy topic for a room: short, unguessable, derived from the room id.
function Ntfy.topic(room: string): string
	return &quot;rbxnp-&quot; .. room
end

return Ntfy
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX22">
      <Properties>
        <string name="Name">Paths</string>
        <ProtectedString name="Source">--!strict
--! Instance paths: names from the service down, joined by &quot;.&quot; with &quot;\&quot; and
--! &quot;.&quot; escaped inside a name, so a path is unambiguous and round-trips.

local Paths = {}

function Paths.escape(name: string): string
	local escaped = name:gsub(&quot;[\\.]&quot;, function(c: string): string
		return &quot;\\&quot; .. c
	end)
	return escaped
end

function Paths.join(names: {string}): string
	local parts: {string} = {}
	for _, name in ipairs(names) do
		table.insert(parts, Paths.escape(name))
	end
	return table.concat(parts, &quot;.&quot;)
end

function Paths.split(path: string): {string}?
	if path == &quot;&quot; then
		return nil
	end
	local names: {string} = {}
	local current: {string} = {}
	local i = 1
	local n = #path
	while i &lt;= n do
		local c = path:sub(i, i)
		if c == &quot;\\&quot; then
			local nextChar = path:sub(i + 1, i + 1)
			if nextChar ~= &quot;\\&quot; and nextChar ~= &quot;.&quot; then
				return nil
			end
			table.insert(current, nextChar)
			i += 2
		elseif c == &quot;.&quot; then
			table.insert(names, table.concat(current))
			current = {}
			i += 1
		else
			table.insert(current, c)
			i += 1
		end
	end
	table.insert(names, table.concat(current))
	return names
end

function Paths.pathOf(instance: any, root: any?): string?
	local top: any = root
	if top == nil then
		top = (game :: any)
	end
	if instance == top then
		return nil
	end
	local names: {string} = {}
	local current: any = instance
	while current ~= top do
		if current == nil then
			return nil
		end
		table.insert(names, current.Name)
		current = current.Parent
	end
	local ordered: {string} = {}
	for i = #names, 1, -1 do
		table.insert(ordered, names[i])
	end
	return Paths.join(ordered)
end

function Paths.resolve(root: any, path: string): any?
	local names = Paths.split(path)
	if not names then
		return nil
	end
	local current: any = root
	for _, name in ipairs(names) do
		current = current:FindFirstChild(name)
		if current == nil then
			return nil
		end
	end
	return current
end

return Paths
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX23">
      <Properties>
        <string name="Name">Relay</string>
        <ProtectedString name="Source">--!strict
--! The presence transport. Three kinds, all official:
--!  - &quot;hosted&quot; (the default): an rbx-native collaborator runs the relay
--!    behind a Cloudflare quick tunnel and announces its address on ntfy
--!    (see Announce); we read the address, then speak &quot;worker&quot; to it. Studio
--!    cannot host, so with nobody in rbx-native we wait.
--!  - &quot;worker&quot;: the signed-WebSocket relay in relay/ (here over HTTP long-poll,
--!    since Studio's HttpService cannot hold a socket), which keeps the room
--!    and answers with a snapshot.
--!  - &quot;ntfy&quot;: a plain ntfy pub/sub server, which keeps nothing for us: we
--!    publish our signed state to the room's topic, poll the topic for the
--!    others, and rebuild the room here. Peers trust each other by HMAC.

local HttpService = game:GetService(&quot;HttpService&quot;)

local Announce = require(script.Parent.Announce)
local Auth = require(script.Parent.Auth)
local Ntfy = require(script.Parent.Ntfy)
local Schema = require(script.Parent.Schema)

export type Config = { kind: string, url: string, key: string, encKey: string, room: string, userId: number }

local VERSION_MISMATCH =
	&quot;The relay runs a different Team Presence version; update the plugin, rbx-native and the relay together.&quot;

-- Plugins have no CSPRNG API. A v4 GUID is 122 random bits, so 12 of its 16
-- bytes, mixed with a Random stream, make a nonce that does not repeat.
local rng = Random.new()

local function nonceFor(): string
	local hex = string.gsub(HttpService:GenerateGUID(false), &quot;[^%x]&quot;, &quot;&quot;)
	local bytes = table.create(12)
	for i = 1, 12 do
		local guidByte = tonumber(string.sub(hex, i * 2 - 1, i * 2), 16) or 0
		bytes[i] = string.char(bit32.bxor(guidByte, rng:NextInteger(0, 255)))
	end
	return table.concat(bytes)
end

local EXPIRY_MS = 15000
-- How often a hosted room looks for its host while it has none.
local RESOLVE_EVERY = 15
local WAITING = &quot;Waiting for an rbx-native collaborator to open the place&quot;


local Relay = {}
Relay.__index = Relay

function Relay.new(config: Config)
	local url = string.gsub(config.url, &quot;/+$&quot;, &quot;&quot;)
	local hosted = config.kind == &quot;hosted&quot;
	local self = {
		kind = config.kind,
		-- hosted: the announce server; `base` is the host, once found.
		announceBase = if hosted then url else nil,
		base = if hosted then nil else url,
		lastResolve = -math.huge,
		key = config.key,
		encKey = config.encKey,
		room = config.room,
		topic = Ntfy.topic(config.room),
		userId = config.userId,
		sendKey = true,
		-- ntfy only: the room rebuilt from the stream, and the newest id seen.
		peers = {} :: { [number]: { state: any, seen: number } },
		cursor = 0,
		lastId = nil :: string?,
	}
	return setmetatable(self, Relay)
end

local function nowMs(): number
	return DateTime.now().UnixTimestampMillis
end

-- A short wait between ntfy polls, so the poll loop does not spin; a
-- hosted room with no host yet waits until it looks again.
function Relay:pollDelay(): number
	if self.kind == &quot;hosted&quot; and self.base == nil then
		return RESOLVE_EVERY
	end
	return if self.kind == &quot;ntfy&quot; then 1 else 0
end

-- Whether a hosted room is waiting for an rbx-native user to host it (not
-- an error: nothing is wrong, nobody is there yet).
function Relay:waiting(): boolean
	return self.kind == &quot;hosted&quot; and self.base == nil
end

-- hosted: finds the host from the newest announcement, at most once every
-- RESOLVE_EVERY seconds. True when there is one to talk to.
function Relay:_resolve(): (boolean, string?)
	if self.base ~= nil then
		return true, nil
	end
	if os.clock() - self.lastResolve &lt; RESOLVE_EVERY then
		return false, WAITING
	end
	self.lastResolve = os.clock()
	local url = string.format(&quot;%s/%s/json?poll=1&amp;since=12h&quot;, self.announceBase, Announce.topic(self.room))
	local ok, res = pcall(function()
		return HttpService:RequestAsync({ Url = url, Method = &quot;GET&quot; })
	end)
	if not ok then
		return false, tostring(res)
	end
	if not res.Success then
		return false, string.format(&quot;announce HTTP %d&quot;, res.StatusCode)
	end
	local texts = {}
	for line in string.gmatch(res.Body or &quot;&quot;, &quot;[^\n]+&quot;) do
		local decoded, parsed = pcall(function()
			return HttpService:JSONDecode(line)
		end)
		if decoded and type(parsed) == &quot;table&quot; and parsed.event == &quot;message&quot; and type(parsed.message) == &quot;string&quot; then
			table.insert(texts, parsed.message)
		end
	end
	local host = Announce.newest(self.key, self.room, nowMs(), texts)
	if not host then
		return false, WAITING
	end
	self.base = string.gsub(host, &quot;/+$&quot;, &quot;&quot;)
	self.sendKey = true
	return true, nil
end

-- hosted: the host stopped answering (left, crashed, or handed over); look
-- for it again on the next call.
function Relay:_lost()
	if self.kind == &quot;hosted&quot; then
		self.base = nil
		self.lastResolve = -math.huge
	end
end

-- ===== Worker (signed HTTP) =====

function Relay:_request(method: string, suffix: string, body: string): (any?, string?, any?)
	local path = &quot;/v1/rooms/&quot; .. self.room .. suffix
	local headers = Auth.headers(self.key, method, path, self.userId, nowMs(), body, self.sendKey)
	if body ~= &quot;&quot; then
		headers[&quot;Content-Type&quot;] = &quot;application/json&quot;
	end
	local request: { [string]: any } = { Url = self.base .. path, Method = method, Headers = headers }
	if body ~= &quot;&quot; then
		request.Body = body
	end
	local ok, res = pcall(function()
		return HttpService:RequestAsync(request)
	end)
	if not ok then
		return nil, tostring(res)
	end
	if not res.Success then
		if res.StatusCode == 400 and string.find(res.Body or &quot;&quot;, &quot;version&quot;, 1, true) then
			return nil, VERSION_MISMATCH, res
		end
		return nil, string.format(&quot;HTTP %d: %s&quot;, res.StatusCode, string.sub(res.Body or &quot;&quot;, 1, 120)), res
	end
	self.sendKey = false
	return res, nil
end

local function needsKey(res: any): boolean
	if res == nil or res.StatusCode ~= 401 then
		return false
	end
	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(res.Body)
	end)
	return ok and type(decoded) == &quot;table&quot; and decoded.error == &quot;key&quot;
end

function Relay:_send(method: string, suffix: string, body: string): (any?, string?)
	if self.kind == &quot;hosted&quot; then
		local found, why = self:_resolve()
		if not found then
			return nil, why
		end
	end
	local res, err, raw = self:_request(method, suffix, body)
	if res == nil and raw == nil and self.kind == &quot;hosted&quot; then
		-- No HTTP answer at all: the host may be gone, or its address not
		-- reachable yet; look again shortly.
		self:_lost()
		err = `Can't reach the rbx-native host yet ({err})`
	elseif res == nil and raw and self.kind == &quot;hosted&quot; and (raw.StatusCode == 404 or raw.StatusCode &gt;= 500) then
		-- A closed tunnel answers 404/502/530 from Cloudflare's edge (an
		-- HTML page: keep it out of the status line).
		self:_lost()
		err = `Can't reach the rbx-native host yet (HTTP {raw.StatusCode})`
	end
	if res == nil and needsKey(raw) and not self.sendKey then
		self.sendKey = true
		res, err = self:_request(method, suffix, body)
	end
	return res, err
end

-- ===== ntfy (plain pub/sub) =====

function Relay:_ntfyPublish(state: any): (boolean, string?)
	local body = Ntfy.fitEncode(self.key, self.encKey, self.room, self.topic, self.userId, nowMs(), state, nonceFor)
	local ok, res = pcall(function()
		return HttpService:RequestAsync({
			Url = self.base .. &quot;/&quot; .. self.topic,
			Method = &quot;POST&quot;,
			Headers = { [&quot;Content-Type&quot;] = &quot;text/plain&quot; },
			Body = body,
		})
	end)
	if not ok then
		return false, tostring(res)
	end
	if not res.Success then
		return false, string.format(&quot;ntfy publish HTTP %d&quot;, res.StatusCode)
	end
	return true, nil
end

function Relay:_ntfyPoll(): (any?, string?)
	local since = self.lastId or &quot;10s&quot;
	local url = string.format(&quot;%s/%s/json?poll=1&amp;since=%s&quot;, self.base, self.topic, HttpService:UrlEncode(since))
	local ok, res = pcall(function()
		return HttpService:RequestAsync({ Url = url, Method = &quot;GET&quot; })
	end)
	if not ok then
		return nil, tostring(res)
	end
	if not res.Success then
		return nil, string.format(&quot;ntfy poll HTTP %d&quot;, res.StatusCode)
	end
	local now = nowMs()
	local changed = false
	for line in string.gmatch(res.Body or &quot;&quot;, &quot;[^\n]+&quot;) do
		local parsed
		local decoded = pcall(function()
			parsed = HttpService:JSONDecode(line)
		end)
		if decoded and type(parsed) == &quot;table&quot; then
			if type(parsed.id) == &quot;string&quot; then
				self.lastId = parsed.id
			end
			if parsed.event == &quot;message&quot; and type(parsed.message) == &quot;string&quot; then
				local state = Ntfy.decode(self.key, self.encKey, self.room, self.topic, now, parsed.message)
				-- Our own echo is this user in Studio; the same user in
				-- rbx-native is another sender, keyed apart.
				if state and not (state.userId == self.userId and state.client == &quot;studio&quot;) then
					state.seen = now
					self.peers[`{state.userId}/{state.client}`] = { state = state, seen = now }
					changed = true
				end
			end
		end
	end
	for id, peer in self.peers do
		if now - peer.seen &gt; EXPIRY_MS then
			self.peers[id] = nil
			changed = true
		end
	end
	if changed then
		self.cursor += 1
	end
	local users = {}
	for _, peer in self.peers do
		table.insert(users, peer.state)
	end
	return { cursor = self.cursor, users = users }, nil
end

-- ===== Shared surface =====

function Relay:publish(state: any): (boolean, string?)
	if self.kind == &quot;ntfy&quot; then
		return self:_ntfyPublish(state)
	end
	local res, err = self:_send(&quot;POST&quot;, &quot;/state&quot;, Schema.sealState(self.encKey, self.room, state, nonceFor))
	if res == nil then
		return false, err
	end
	return true, nil
end

function Relay:poll(cursor: number): (any?, string?)
	if self.kind == &quot;ntfy&quot; then
		return self:_ntfyPoll()
	end
	local res, err = self:_send(&quot;GET&quot;, string.format(&quot;/poll?since=%.0f&quot;, cursor), &quot;&quot;)
	if res == nil then
		return nil, err
	end
	local ok, snapshot = pcall(Schema.openSnapshot, self.encKey, self.room, res.Body)
	if not ok then
		return nil, tostring(snapshot)
	end
	return snapshot, nil
end

-- The value-less edit journal since `sinceMs`, for the &quot;While you were
-- away&quot; catch-up. Worker: a signed GET of its bounded journal. ntfy: the
-- topic's retained messages, verified against each message's own time
-- (they predate now by more than the signing skew), edits lifted out,
-- filtered to after `sinceMs` and de-duplicated. Mirrors
-- crates/rbx_presence/src/catchup.rs.
function Relay:journal(sinceMs: number): (any?, string?)
	if self.kind == &quot;ntfy&quot; then
		local url = string.format(&quot;%s/%s/json?poll=1&amp;since=12h&quot;, self.base, self.topic)
		local ok, res = pcall(function()
			return HttpService:RequestAsync({ Url = url, Method = &quot;GET&quot; })
		end)
		if not ok then
			return nil, tostring(res)
		end
		if not res.Success then
			return nil, string.format(&quot;ntfy journal HTTP %d&quot;, res.StatusCode)
		end
		local now = nowMs()
		local seen: { [string]: boolean } = {}
		local entries = {}
		for line in string.gmatch(res.Body or &quot;&quot;, &quot;[^\n]+&quot;) do
			local parsed
			local decoded = pcall(function()
				parsed = HttpService:JSONDecode(line)
			end)
			if
				decoded
				and type(parsed) == &quot;table&quot;
				and parsed.event == &quot;message&quot;
				and type(parsed.message) == &quot;string&quot;
			then
				local checkAt = if type(parsed.time) == &quot;number&quot; then parsed.time * 1000 else now
				local state = Ntfy.decode(self.key, self.encKey, self.room, self.topic, checkAt, parsed.message)
				if state then
					for _, edit in state.edits or {} do
						if edit.at &gt; sinceMs then
							local dedupe =
								string.format(&quot;%.0f\0%s\0%s\0%.0f&quot;, state.userId, edit.path, edit.property, edit.at)
							if not seen[dedupe] then
								seen[dedupe] = true
								table.insert(entries, {
									userId = state.userId,
									name = state.name,
									path = edit.path,
									property = edit.property,
									at = edit.at,
								})
							end
						end
					end
				end
			end
		end
		return entries, nil
	end
	local res, err = self:_send(&quot;GET&quot;, string.format(&quot;/journal?since=%.0f&quot;, sinceMs), &quot;&quot;)
	if res == nil then
		return nil, err
	end
	local parsed
	local ok = pcall(function()
		parsed = HttpService:JSONDecode(res.Body)
	end)
	if not ok or type(parsed) ~= &quot;table&quot; then
		return nil, &quot;journal reply&quot;
	end
	local opened = {}
	local raw = parsed.entries
	if type(raw) == &quot;table&quot; then
		for _, entry in raw do
			local plain = Schema.openJournal(self.encKey, self.room, entry)
			if plain ~= nil then
				table.insert(opened, plain)
			end
		end
	end
	return opened, nil
end

local NEEDS_HOSTED = &quot;Co-editing needs the hosted relay or a Worker&quot;

-- `fill`: entries of the log handed to a relay that lacks them.
function Relay:postOps(body: string, fill: boolean?): (boolean, string?)
	if self.kind ~= &quot;hosted&quot; and self.kind ~= &quot;worker&quot; then
		return false, NEEDS_HOSTED
	end
	local res, err = self:_send(&quot;POST&quot;, if fill then &quot;/ops/fill&quot; else &quot;/ops&quot;, body)
	if res == nil then
		return false, err
	end
	return true, nil
end

function Relay:pollOps(since: number): (any?, string?)
	if self.kind ~= &quot;hosted&quot; and self.kind ~= &quot;worker&quot; then
		return nil, NEEDS_HOSTED
	end
	local res, err = self:_send(&quot;GET&quot;, string.format(&quot;/ops?since=%.0f&quot;, since), &quot;&quot;)
	if res == nil then
		return nil, err
	end
	local parsed
	local ok = pcall(function()
		parsed = HttpService:JSONDecode(res.Body)
	end)
	if not ok or type(parsed) ~= &quot;table&quot; then
		return nil, &quot;ops reply&quot;
	end
	return parsed, nil
end

function Relay:leave()
	if self.kind == &quot;ntfy&quot; or self:waiting() then
		-- Nothing to delete on a dumb pub/sub (peers expire us), or no host.
		return
	end
	self:_send(&quot;DELETE&quot;, &quot;/state&quot;, &quot;&quot;)
end

return Relay
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX24">
      <Properties>
        <string name="Name">Schema</string>
        <ProtectedString name="Source">--!strict
--! UserState / Snapshot shapes shared with the relay, including the size
--! limits the relay enforces so a state is never rejected for being too big.

local Json = require(script.Parent.Json)
local Crypto = require(script.Parent.Crypto)

local Schema = {}

Schema.VERSION = 2
Schema.MAX_SELECTION = 100
Schema.MAX_EDITS = 20
Schema.MAX_TEXT = 512
Schema.PALETTE = { &quot;#e8590c&quot;, &quot;#1c7ed6&quot;, &quot;#2f9e44&quot;, &quot;#ae3ec9&quot;, &quot;#f08c00&quot;, &quot;#0c8599&quot;, &quot;#e03131&quot;, &quot;#7048e8&quot; }

-- FNV-1a over the decimal digits; the prime 16777619 is 2^24 + 403, which
-- keeps every intermediate product exact in a double.
function Schema.colorSlot(userId: number): number
	local h = 2166136261
	for _, byte in ipairs({ string.byte(string.format(&quot;%.0f&quot;, userId), 1, -1) }) do
		h = bit32.bxor(h, byte)
		h = (bit32.lshift(h, 24) + h * 403) % 4294967296
	end
	return h % 8
end

function Schema.colorFor(userId: number): string
	return Schema.PALETTE[Schema.colorSlot(userId) + 1]
end

function Schema.assignColors(room: {number}, extra: {number}?): {[number]: string}
	local ordered: {number} = {}
	local seen: {[number]: boolean} = {}
	local function add(ids: {number})
		local sorted = table.clone(ids)
		table.sort(sorted)
		for _, id in ipairs(sorted) do
			if not seen[id] then
				seen[id] = true
				table.insert(ordered, id)
			end
		end
	end
	add(room)
	if extra then
		add(extra)
	end

	local taken: {[number]: boolean} = {}
	local count = 0
	local colors: {[number]: string} = {}
	for _, id in ipairs(ordered) do
		local slot = Schema.colorSlot(id)
		if count &lt; 8 then
			while taken[slot] do
				slot = (slot + 1) % 8
			end
			taken[slot] = true
			count += 1
		end
		colors[id] = Schema.PALETTE[slot + 1]
	end
	return colors
end

local function clampText(s: string): string
	if #s &lt;= Schema.MAX_TEXT then
		return s
	end
	local cut = Schema.MAX_TEXT
	-- Step back so a multi-byte character is never split.
	while cut &gt; 0 do
		local b = string.byte(s, cut + 1)
		if b == nil or b &lt; 0x80 or b &gt;= 0xC0 then
			break
		end
		cut -= 1
	end
	return s:sub(1, cut)
end

local function clampList(list: {any}?, max: number, map: (any) -&gt; any): {any}
	local out = Json.array()
	if list then
		for i = 1, math.min(#list, max) do
			table.insert(out, map(list[i]))
		end
	end
	return out
end

function Schema.encode(state: any): string
	local out: {[string]: any} = {
		v = Schema.VERSION,
		userId = state.userId,
		name = clampText(state.name),
		color = state.color,
		client = state.client,
		selection = clampList(state.selection, Schema.MAX_SELECTION, clampText),
		edits = clampList(state.edits, Schema.MAX_EDITS, function(edit: any): any
			local value = edit.value
			if type(value) == &quot;string&quot; then
				value = clampText(value)
			end
			return {
				path = clampText(edit.path),
				property = clampText(edit.property),
				value = value,
				at = edit.at,
			}
		end),
		seen = state.seen or 0,
	}
	if state.camera ~= nil then
		out.camera = Json.array(table.clone(state.camera))
	end
	if state.script ~= nil then
		out.script = clampText(state.script)
	end
	return Json.encode(out)
end

local function present(value: any): any
	if value == Json.null then
		return nil
	end
	return value
end

local function toState(obj: any): any
	if type(obj) ~= &quot;table&quot; then
		error(&quot;state must be an object&quot;)
	end
	local state: {[string]: any} = {
		v = obj.v or Schema.VERSION,
		userId = obj.userId,
		name = obj.name,
		color = obj.color,
		client = obj.client,
		selection = Json.array(),
		edits = Json.array(),
		seen = obj.seen or 0,
	}
	local selection = present(obj.selection)
	if selection then
		for _, path in ipairs(selection) do
			table.insert(state.selection, path)
		end
	end
	local edits = present(obj.edits)
	if edits then
		for _, edit in ipairs(edits) do
			table.insert(state.edits, edit)
		end
	end
	state.camera = present(obj.camera)
	state.script = present(obj.script)
	return state
end

function Schema.decodeState(text: string): any
	return toState(Json.decode(text))
end

function Schema.decodeSnapshot(text: string): any
	local obj = Json.decode(text)
	if type(obj) ~= &quot;table&quot; then
		error(&quot;snapshot must be an object&quot;)
	end
	local users: {any} = {}
	local list = present(obj.users)
	if list then
		for _, user in ipairs(list) do
			table.insert(users, toState(user))
		end
	end
	return { cursor = obj.cursor or 0, users = users }
end

-- The state as the relay sees it: `ct` is the state JSON, `j` one sealed
-- journal entry per edit (its display value included). `nonceFor` returns 12 raw bytes
-- and is called once per ciphertext.
function Schema.sealState(encKey: string, room: string, state: any, nonceFor: () -&gt; string): string
	local client: string = state.client
	local ct = Crypto.sealB64(encKey, nonceFor(), Crypto.stateAad(room, state.userId, client), Schema.encode(state))
	local name = clampText(state.name)
	local j = Json.array()
	local edits: {any} = state.edits or {}
	for i = 1, math.min(#edits, Schema.MAX_EDITS) do
		local edit = edits[i]
		local path, property = clampText(edit.path), clampText(edit.property)
		local plain = Json.encode({ name = name, path = path, property = property, value = clampText(edit.value or &quot;&quot;) })
		table.insert(j, {
			at = edit.at,
			tag = Crypto.journalTag(encKey, path, property, edit.at),
			ct = Crypto.sealB64(encKey, nonceFor(), Crypto.journalAad(room, state.userId, edit.at), plain),
		})
	end
	return Json.encode({
		v = Schema.VERSION,
		userId = state.userId,
		client = client,
		ct = ct,
		j = j,
		seen = 0,
	})
end

function Schema.openState(encKey: string, room: string, sealed: any): any?
	if type(sealed) ~= &quot;table&quot; then
		return nil
	end
	local userId, client, ct = sealed.userId, sealed.client, sealed.ct
	if type(userId) ~= &quot;number&quot; or type(client) ~= &quot;string&quot; or type(ct) ~= &quot;string&quot; then
		return nil
	end
	local plain = Crypto.openB64(encKey, Crypto.stateAad(room, userId, client), ct)
	if plain == nil then
		return nil
	end
	local ok, state = pcall(Schema.decodeState, plain)
	if not ok or type(state) ~= &quot;table&quot; then
		return nil
	end
	if state.v ~= Schema.VERSION or state.userId ~= userId or state.client ~= client then
		return nil
	end
	local seen = sealed.seen
	state.seen = if type(seen) == &quot;number&quot; then seen else 0
	return state
end

function Schema.openSnapshot(encKey: string, room: string, text: string): any
	local obj = Json.decode(text)
	if type(obj) ~= &quot;table&quot; then
		error(&quot;snapshot must be an object&quot;)
	end
	local users: {any} = {}
	local list = present(obj.users)
	if list then
		for _, sealed in ipairs(list) do
			local state = Schema.openState(encKey, room, sealed)
			if state ~= nil then
				table.insert(users, state)
			end
		end
	end
	return { cursor = obj.cursor or 0, users = users }
end

function Schema.openJournal(encKey: string, room: string, entry: any): any?
	if type(entry) ~= &quot;table&quot; then
		return nil
	end
	local userId, at, ct = entry.userId, entry.at, entry.ct
	if type(userId) ~= &quot;number&quot; or type(at) ~= &quot;number&quot; or type(ct) ~= &quot;string&quot; then
		return nil
	end
	local plain = Crypto.openB64(encKey, Crypto.journalAad(room, userId, at), ct)
	if plain == nil then
		return nil
	end
	local ok, obj = pcall(Json.decode, plain)
	if not ok or type(obj) ~= &quot;table&quot; then
		return nil
	end
	if type(obj.name) ~= &quot;string&quot; or type(obj.path) ~= &quot;string&quot; or type(obj.property) ~= &quot;string&quot; then
		return nil
	end
	local value = if type(obj.value) == &quot;string&quot; then obj.value else &quot;&quot;
	return { userId = userId, name = obj.name, path = obj.path, property = obj.property, value = value, at = at }
end

return Schema
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX25">
      <Properties>
        <string name="Name">Secret</string>
        <ProtectedString name="Source">--!strict
--! Shared presence secret stored as an attribute under ServerStorage, so Team Create replicates it to collaborators.

local ChangeHistoryService = game:GetService(&quot;ChangeHistoryService&quot;)
local HttpService = game:GetService(&quot;HttpService&quot;)
local ServerStorage = game:GetService(&quot;ServerStorage&quot;)

local FOLDER = &quot;RbxNativePresence&quot;
local ATTRIBUTE = &quot;PresenceSecret&quot;
local RELAY_KIND = &quot;RelayKind&quot;
local RELAY_URL = &quot;RelayUrl&quot;

local Secret = {}

local function ensureFolder(): Folder
	local folder = ServerStorage:FindFirstChild(FOLDER)
	if folder == nil then
		local created = Instance.new(&quot;Folder&quot;)
		created.Name = FOLDER
		created.Parent = ServerStorage
		folder = created
	end
	return folder :: Folder
end

function Secret.read(): string?
	local folder = ServerStorage:FindFirstChild(FOLDER)
	if folder == nil then
		return nil
	end
	local value = folder:GetAttribute(ATTRIBUTE)
	if type(value) == &quot;string&quot; and #value == 64 and string.match(value, &quot;^[0-9a-f]+$&quot;) then
		return value
	end
	return nil
end

function Secret.create(): string
	local secret = string.lower(
		string.gsub(HttpService:GenerateGUID(false), &quot;-&quot;, &quot;&quot;) .. string.gsub(HttpService:GenerateGUID(false), &quot;-&quot;, &quot;&quot;)
	)
	local id = ChangeHistoryService:TryBeginRecording(&quot;Create presence key&quot;)
	ensureFolder():SetAttribute(ATTRIBUTE, secret)
	if id then
		ChangeHistoryService:FinishRecording(id, Enum.FinishRecordingOperation.Commit)
	end
	return secret
end

-- The relay the place names, if any: a known kind and a non-empty URL.
function Secret.readRelay(): { kind: string, url: string }?
	local folder = ServerStorage:FindFirstChild(FOLDER)
	if folder == nil then
		return nil
	end
	local kind = folder:GetAttribute(RELAY_KIND)
	local url = folder:GetAttribute(RELAY_URL)
	if (kind == &quot;hosted&quot; or kind == &quot;worker&quot; or kind == &quot;ntfy&quot;) and type(url) == &quot;string&quot; and url ~= &quot;&quot; then
		return { kind = kind :: string, url = url }
	end
	return nil
end

-- Owner setup: writes the relay into the place for every collaborator.
function Secret.writeRelay(kind: string, url: string)
	local id = ChangeHistoryService:TryBeginRecording(&quot;Set presence relay&quot;)
	local folder = ensureFolder()
	folder:SetAttribute(RELAY_KIND, kind)
	folder:SetAttribute(RELAY_URL, url)
	if id then
		ChangeHistoryService:FinishRecording(id, Enum.FinishRecordingOperation.Commit)
	end
end

function Secret.clearRelay()
	local folder = ServerStorage:FindFirstChild(FOLDER)
	if folder == nil then
		return
	end
	local id = ChangeHistoryService:TryBeginRecording(&quot;Clear presence relay&quot;)
	folder:SetAttribute(RELAY_KIND, nil)
	folder:SetAttribute(RELAY_URL, nil)
	if id then
		ChangeHistoryService:FinishRecording(id, Enum.FinishRecordingOperation.Commit)
	end
end

return Secret
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX26">
      <Properties>
        <string name="Name">Sha256</string>
        <ProtectedString name="Source">--!strict
-- SHA-256 (FIPS 180-4) over a string's bytes, using only bit32 so it runs in
-- Studio and in plain Luau alike.

local K: {number} = {
	0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
	0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
	0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
	0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
	0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
	0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
	0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
	0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
}

local Sha256 = {}

local function digestWords(msg: string): {number}
	local len = #msg
	local padLen = (55 - len) % 64
	local hi = math.floor(len / 0x20000000)
	local lo = (len * 8) % 0x100000000
	local tail = &quot;\128&quot;
		.. string.rep(&quot;\0&quot;, padLen)
		.. string.char(
			bit32.rshift(hi, 24) % 256, bit32.rshift(hi, 16) % 256, bit32.rshift(hi, 8) % 256, hi % 256,
			bit32.rshift(lo, 24), bit32.rshift(lo, 16) % 256, bit32.rshift(lo, 8) % 256, lo % 256
		)
	local data = msg .. tail

	local h: {number} = {
		0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
	}
	local w: {number} = table.create(64, 0)

	for base = 1, #data, 64 do
		for i = 1, 16 do
			local a, b, c, d = string.byte(data, base + (i - 1) * 4, base + (i - 1) * 4 + 3)
			w[i] = a * 0x1000000 + b * 0x10000 + c * 0x100 + d
		end
		for i = 17, 64 do
			local x = w[i - 15]
			local y = w[i - 2]
			local s0 = bit32.bxor(bit32.rrotate(x, 7), bit32.rrotate(x, 18), bit32.rshift(x, 3))
			local s1 = bit32.bxor(bit32.rrotate(y, 17), bit32.rrotate(y, 19), bit32.rshift(y, 10))
			w[i] = (w[i - 16] + s0 + w[i - 7] + s1) % 0x100000000
		end

		local a, b, c, d, e, f, g, hh = h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]
		for i = 1, 64 do
			local s1 = bit32.bxor(bit32.rrotate(e, 6), bit32.rrotate(e, 11), bit32.rrotate(e, 25))
			local ch = bit32.bxor(bit32.band(e, f), bit32.band(bit32.bnot(e), g))
			local t1 = (hh + s1 + ch + K[i] + w[i]) % 0x100000000
			local s0 = bit32.bxor(bit32.rrotate(a, 2), bit32.rrotate(a, 13), bit32.rrotate(a, 22))
			local maj = bit32.bxor(bit32.band(a, b), bit32.band(a, c), bit32.band(b, c))
			local t2 = (s0 + maj) % 0x100000000
			hh = g
			g = f
			f = e
			e = (d + t1) % 0x100000000
			d = c
			c = b
			b = a
			a = (t1 + t2) % 0x100000000
		end
		h[1] = (h[1] + a) % 0x100000000
		h[2] = (h[2] + b) % 0x100000000
		h[3] = (h[3] + c) % 0x100000000
		h[4] = (h[4] + d) % 0x100000000
		h[5] = (h[5] + e) % 0x100000000
		h[6] = (h[6] + f) % 0x100000000
		h[7] = (h[7] + g) % 0x100000000
		h[8] = (h[8] + hh) % 0x100000000
	end
	return h
end

function Sha256.hex(msg: string): string
	local h = digestWords(msg)
	local parts: {string} = {}
	for i = 1, 8 do
		parts[i] = string.format(&quot;%08x&quot;, h[i])
	end
	return table.concat(parts)
end

function Sha256.raw(msg: string): string
	local h = digestWords(msg)
	local parts: {string} = {}
	for i = 1, 8 do
		local v = h[i]
		parts[i] = string.char(
			bit32.rshift(v, 24), bit32.rshift(v, 16) % 256, bit32.rshift(v, 8) % 256, v % 256
		)
	end
	return table.concat(parts)
end

return Sha256
</ProtectedString>
      </Properties>
    </Item>
