<roblox version="4">
  <Meta name="ExplicitAutoJoints">true</Meta>
  <Item class="Script" referent="RBX0">
    <Properties>
      <string name="Name">TeamPresence</string>
      <ProtectedString name="Source">--!strict
-- Plugin entry point: wires the toolbar button, settings and the publish/poll loops.

local Auth = require(script.Auth)
local Coedit = require(script.Coedit)
local Capture = require(script.Capture)
local Catchup = require(script.Catchup)
local Crypto = require(script.Crypto)
local Defaults =require(script.Defaults)
local DiffWindow = require(script.DiffWindow)
local Markers = require(script.Markers)
local Relay = require(script.Relay)
local Schema = require(script.Schema)
local Secret = require(script.Secret)
local Widget = require(script.Widget)

local Players = game:GetService(&quot;Players&quot;)

local HEARTBEAT = 5
-- How often the last-seen time is saved while connected: what arrives while
-- connected is seen live, so the next catch-up starts after it.
local LAST_SEEN_EVERY = 30
local TICK = 0.2
local BACKOFF_MIN = 1
local BACKOFF_MAX = 30

local toolbar = plugin:CreateToolbar(&quot;rbx-native&quot;)
local button = toolbar:CreateButton(&quot;Presence&quot;, &quot;Show rbx-native team presence&quot;, &quot;&quot;)
button.ClickableWhenViewportHidden = true
local coeditButton = toolbar:CreateButton(&quot;Co-edit&quot;, &quot;Live co-editing (beta): share edits with rbx-native&quot;, &quot;&quot;)
coeditButton.ClickableWhenViewportHidden = true

local generation = 0
local coedit: any = nil
local coeditEnabled = plugin:GetSetting(&quot;coeditEnabled&quot;) == true
local capture: any = nil
local markers: any = nil
local relay: any = nil
local widget: any = nil
local diffWindow: any = nil
-- The journal the last &quot;While you were away&quot; came from, for View changes.
local lastEntries: { any } = {}

local function userId(): number
	local id = Players.LocalPlayer and Players.LocalPlayer.UserId or 0
	if id == 0 then
		local ok, studioId = pcall(function()
			return game:GetService(&quot;StudioService&quot;):GetUserId()
		end)
		if ok and typeof(studioId) == &quot;number&quot; then
			id = studioId
		end
	end
	return id
end

local function lastSeenKey(): string
	return &quot;LastSeen_&quot; .. tostring(game.PlaceId)
end

local function saveLastSeen()
	if game.PlaceId ~= 0 then
		plugin:SetSetting(lastSeenKey(), DateTime.now().UnixTimestampMillis)
	end
end

local function stop()
	if relay then
		saveLastSeen()
	end
	generation += 1
	if coedit then
		coedit:stop()
		coedit = nil
	end
	if relay then
		relay:leave()
		relay = nil
	end
	if capture then
		capture:destroy()
		capture = nil
	end
	if markers then
		markers:destroy()
		markers = nil
	end
	if widget then
		widget:setCatchup(nil)
	end
end

local function nextBackoff(current: number): number
	if current == 0 then
		return BACKOFF_MIN
	end
	return math.min(current * 2, BACKOFF_MAX)
end

local function start()
	stop()
	if game.PlaceId == 0 then
		widget:setStatus(&quot;Publish the place first&quot;)
		return
	end

	-- Zero-config: the first connector mints the place's secret, everyone
	-- else reads it. Writing it needs a Save/Publish to reach collaborators.
	local secret = Secret.read()
	if not secret then
		secret = Secret.create()
		widget:setStatus(&quot;Shared a key — Save or Publish once to share it&quot;)
	end

	-- The place names the relay; collaborators read it. A place that names
	-- none falls back to the best-effort community instance.
	local placeRelay = Secret.readRelay()
	local kind = if placeRelay then placeRelay.kind else Defaults.communityKind
	local url = if placeRelay then placeRelay.url else Defaults.communityUrl
	widget:setRelay(kind, url, placeRelay == nil)

	local key = Auth.deriveKey(secret :: string, game.PlaceId)
	local encKey = Crypto.encKey(secret :: string, game.PlaceId)
	local ownId = userId()
	local myRelay = Relay.new({
		kind = kind,
		url = url,
		key = key,
		encKey = encKey,
		room = Auth.roomId(key),
		userId = ownId,
	})
	local myCapture = Capture.new()
	local myMarkers = Markers.new()
	relay, capture, markers = myRelay, myCapture, myMarkers
	generation += 1
	local myGen = generation
	widget:setStatus(&quot;Connecting…&quot;)

	if coeditEnabled then
		local myCoedit = Coedit.new({
			relay = myRelay,
			userId = ownId,
			room = Auth.roomId(key),
			encKey = encKey,
			name = if Players.LocalPlayer then Players.LocalPlayer.Name else tostring(ownId),
			onNote = function(note: string)
				warn(&quot;[Co-edit] &quot; .. note)
				if generation == myGen then
					widget:setStatus(&quot;Co-edit: &quot; .. note)
				end
			end,
		})
		coedit = myCoedit
		myCoedit:start()
	end

	-- &quot;While you were away&quot;: fetch the value-less journal once, scoped to
	-- edits since this client last left this place (kept in plugin settings
	-- per place, mirroring rbx-native's on-disk last-seen).
	task.spawn(function()
		local since = tonumber(plugin:GetSetting(lastSeenKey())) or 0
		local entries = myRelay:journal(since)
		if generation ~= myGen then
			return
		end
		if entries then
			lastEntries = entries
			widget:setCatchup(Catchup.summarize(entries))
		end
		-- From here on, changes arrive live; keep the mark moving.
		while generation == myGen do
			saveLastSeen()
			task.wait(LAST_SEEN_EVERY)
		end
	end)

	task.spawn(function()
		local lastPublish = 0.0
		local backoff = 0
		while generation == myGen do
			if myCapture:isDirty() or os.clock() - lastPublish &gt;= HEARTBEAT then
				myCapture:clearDirty()
				local ok, err = myRelay:publish(myCapture:state())
				if generation ~= myGen then
					return
				end
				if ok then
					lastPublish = os.clock()
					backoff = 0
				else
					widget:setStatus(err or &quot;Publish failed&quot;, not myRelay:waiting())
					backoff = nextBackoff(backoff)
					lastPublish = os.clock()
					task.wait(backoff)
				end
			end
			task.wait(TICK)
		end
	end)

	task.spawn(function()
		local cursor = 0
		local backoff = 0
		while generation == myGen do
			local snapshot, err = myRelay:poll(cursor)
			if generation ~= myGen then
				return
			end
			if snapshot then
				backoff = 0
				cursor = snapshot.cursor
				local ids = { ownId }
				for _, user in snapshot.users do
					table.insert(ids, user.userId)
				end
				local colors = Schema.assignColors(ids)
				for _, user in snapshot.users do
					user.color = colors[user.userId] or user.color
				end
				local native = {}
				for _, user in snapshot.users do
					if user.client == &quot;rbx-native&quot; then
						if user.userId == ownId then
							user.name = `{user.name} (you, in rbx-native)`
						end
						table.insert(native, user)
					end
				end
				myMarkers:render(snapshot.users)
				widget:setUsers(native)
				widget:setStatus(`Connected · {#native} rbx-native`)
				-- ntfy polls return at once; pace them so we don't spin.
				task.wait(myRelay:pollDelay())
			else
				widget:setStatus(err or &quot;Poll failed&quot;, not myRelay:waiting())
				backoff = nextBackoff(backoff)
				task.wait(backoff)
			end
		end
	end)
end

-- Presence on or off is the plugin setting, apart from whether the widget
-- is showing: closing the widget keeps presence running.
local enabled = false

local function apply(on: boolean)
	enabled = on
	plugin:SetSetting(&quot;Enabled&quot;, on)
	widget:setEnabled(on)
	if on then
		if not plugin:GetSetting(&quot;SeenHttpNote&quot;) then
			widget:showHttpNote(true)
			plugin:SetSetting(&quot;SeenHttpNote&quot;, true)
		end
		start()
	else
		stop()
		widget:setStatus(&quot;Off&quot;)
	end
end

widget = Widget.new(plugin, {
	onToggle = function()
		apply(not enabled)
	end,
	onViewChanges = function()
		if not diffWindow then
			diffWindow = DiffWindow.new(plugin)
		end
		diffWindow:show(lastEntries)
	end,
	onSaveRelay = function(kind: string, url: string)
		-- Owner setup: write the relay into the place (empty URL clears it).
		if url == &quot;&quot; then
			Secret.clearRelay()
		else
			Secret.writeRelay(kind, url)
		end
		if enabled then
			start()
		end
	end,
})

button.Click:Connect(function()
	widget.gui.Enabled = not widget.gui.Enabled
end)

coeditButton:SetActive(coeditEnabled)
coeditButton.Click:Connect(function()
	coeditEnabled = not coeditEnabled
	plugin:SetSetting(&quot;coeditEnabled&quot;, coeditEnabled)
	coeditButton:SetActive(coeditEnabled)
	if coeditEnabled and enabled then
		start()
	elseif coedit then
		coedit:stop()
		coedit = nil
	end
end)

widget.gui:GetPropertyChangedSignal(&quot;Enabled&quot;):Connect(function()
	button:SetActive(widget.gui.Enabled)
end)

plugin.Unloading:Connect(stop)

local savedRelay = Secret.readRelay()
if savedRelay then
	widget:setRelay(savedRelay.kind, savedRelay.url, false)
else
	widget:setRelay(Defaults.communityKind, Defaults.communityUrl, true)
end
apply(plugin:GetSetting(&quot;Enabled&quot;) == true)
</ProtectedString>
    </Properties>
    <Item class="ModuleScript" referent="RBX1">
      <Properties>
        <string name="Name">Announce</string>
        <ProtectedString name="Source">--!strict
--! Where the room's host is, mirrored from crates/rbx_presence/src/announce.rs.
--! In a &quot;hosted&quot; room an rbx-native collaborator runs the relay behind a
--! Cloudflare quick tunnel and posts its address, signed with the place key,
--! to the room's announce topic on ntfy; the plugin reads the newest genuine
--! one and talks to that relay. An empty url is the host saying goodbye.
--! Pure (no HttpService): the Luau tests check it against the Rust encoder.

local Auth = require(script.Parent.Auth)
local Json = require(script.Parent.Json)
local Ntfy = require(script.Parent.Ntfy)

local Announce = {}

Announce.MAX_AGE_MS = 12 * 60 * 60 * 1000
Announce.CLOCK_SKEW_MS = 60000

function Announce.topic(room: string): string
	return Ntfy.topic(room) .. &quot;-host&quot;
end

local function canonical(room: string, url: string, at: number): string
	return string.format(&quot;rbx-presence/announce/v1\n%s\n%s\n%.0f&quot;, room, url, at)
end

-- Whether `url` may be connected to: public HTTPS, or this machine.
function Announce.allowedUrl(url: string): boolean
	return string.sub(url, 1, 8) == &quot;https://&quot; or string.sub(url, 1, 17) == &quot;http://127.0.0.1:&quot;
end

-- `text` decoded if it is a genuine, current announcement for `room`.
function Announce.verify(key: string, room: string, now: number, text: string): any?
	local ok, message = pcall(Json.decode, text)
	if not ok or type(message) ~= &quot;table&quot; then
		return nil
	end
	local url, at, sig = message.url, message.at, message.sig
	if message.v ~= 1 or type(url) ~= &quot;string&quot; or type(at) ~= &quot;number&quot; or type(sig) ~= &quot;string&quot; then
		return nil
	end
	if at &gt; now + Announce.CLOCK_SKEW_MS or now - at &gt; Announce.MAX_AGE_MS then
		return nil
	end
	if url ~= &quot;&quot; and not Announce.allowedUrl(url) then
		return nil
	end
	if Auth.sign(key, canonical(room, url, at)) ~= sig then
		return nil
	end
	return { url = url, at = at }
end

-- The host's URL from a run of announcement texts: the newest genuine one,
-- nil when there is none or the newest says the host left.
function Announce.newest(key: string, room: string, now: number, texts: { string }): string?
	local best: any = nil
	for _, text in texts do
		local message = Announce.verify(key, room, now, text)
		if message and (best == nil or message.at &gt; best.at) then
			best = message
		end
	end
	if best == nil or best.url == &quot;&quot; then
		return nil
	end
	return best.url
end

return Announce
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX2">
      <Properties>
        <string name="Name">Auth</string>
        <ProtectedString name="Source">--!strict
-- Key derivation and request signing for the presence relay protocol.

local Sha256 = require(script.Parent.Sha256)
local Hmac = require(script.Parent.Hmac)

local Auth = {}

local function int(n: number): string
	return string.format(&quot;%.0f&quot;, n)
end

function Auth.deriveKey(secret: string, placeId: number): string
	return Hmac.sha256Hex(secret, &quot;rbx-presence/key/v1/&quot; .. int(placeId))
end

function Auth.roomId(key: string): string
	return string.sub(Sha256.hex(&quot;rbx-presence/room/v1/&quot; .. key), 1, 32)
end

function Auth.canonical(method: string, path: string, userId: number, ts: number, body: string): string
	return method .. &quot;\n&quot; .. path .. &quot;\n&quot; .. int(userId) .. &quot;\n&quot; .. int(ts) .. &quot;\n&quot; .. Sha256.hex(body)
end

function Auth.sign(key: string, canonical: string): string
	return Hmac.sha256Hex(key, canonical)
end

function Auth.headers(
	key: string,
	method: string,
	path: string,
	userId: number,
	ts: number,
	body: string,
	withKey: boolean
): { [string]: string }
	local headers: { [string]: string } = {
		[&quot;X-Presence-User&quot;] = int(userId),
		[&quot;X-Presence-Time&quot;] = int(ts),
		[&quot;X-Presence-Sig&quot;] = Auth.sign(key, Auth.canonical(method, path, userId, ts, body)),
	}
	if withKey then
		headers[&quot;X-Presence-Key&quot;] = key
	end
	return headers
end

return Auth
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX3">
      <Properties>
        <string name="Name">Capture</string>
        <ProtectedString name="Source">--!strict
--! Collects the local user's presence (camera, selection, open script, recent edits) and tracks when it changed.

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local Selection = game:GetService(&quot;Selection&quot;)
local StudioService = game:GetService(&quot;StudioService&quot;)

local ChangeHistoryService = game:GetService(&quot;ChangeHistoryService&quot;)

local Edits = require(script.Parent.Edits)
local Paths = require(script.Parent.Paths)
local Schema = require(script.Parent.Schema)

local SAMPLE_INTERVAL = 0.2
local MOVE_STUDS = 0.05
local TURN_RADIANS = math.rad(0.5)
local MAX_WATCHED = 50
local VALUE_CUT = 80

local Capture = {}
Capture.__index = Capture

local function nowMs(): number
	return DateTime.now().UnixTimestampMillis
end

function Capture.new()
	local userId = StudioService:GetUserId()
	local name = &quot;User &quot; .. tostring(userId)
	local ok, fetched = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if ok and type(fetched) == &quot;string&quot; and fetched ~= &quot;&quot; then
		name = fetched
	end

	local self = setmetatable({
		userId = userId,
		name = name,
		color = Schema.colorFor(userId),
		dirty = true,
		camera = nil :: { number }?,
		lastCFrame = nil :: CFrame?,
		lastSample = 0,
		tracker = Edits.new(),
		watchers = {} :: { RBXScriptConnection },
		connections = {} :: { RBXScriptConnection },
	}, Capture)

	local function markDirty()
		self.dirty = true
	end

	table.insert(
		self.connections,
		Selection.SelectionChanged:Connect(function()
			self:_watchSelection()
			markDirty()
		end)
	)
	table.insert(self.connections, StudioService:GetPropertyChangedSignal(&quot;ActiveScript&quot;):Connect(markDirty))
	table.insert(
		self.connections,
		ChangeHistoryService.OnRecordingStarted:Connect(function()
			self.tracker:recordingStarted(nowMs())
		end)
	)
	table.insert(
		self.connections,
		ChangeHistoryService.OnRecordingFinished:Connect(
			function(_name: string, _displayName: string?, _identifier: string?, operation: Enum.FinishRecordingOperation)
				self.tracker:recordingFinished(operation ~= Enum.FinishRecordingOperation.Cancel, nowMs())
				markDirty()
			end
		)
	)
	local function onUndoRedo()
		self.tracker:undoRedo(nowMs())
		markDirty()
	end
	table.insert(self.connections, ChangeHistoryService.OnUndo:Connect(onUndoRedo))
	table.insert(self.connections, ChangeHistoryService.OnRedo:Connect(onUndoRedo))
	table.insert(
		self.connections,
		RunService.Heartbeat:Connect(function()
			self:_sampleCamera()
		end)
	)
	self:_watchSelection()
	self:_sampleCamera()
	return self
end

function Capture:_sampleCamera()
	local clock = os.clock()
	if clock - self.lastSample &lt; SAMPLE_INTERVAL then
		return
	end
	self.lastSample = clock
	local camera = workspace.CurrentCamera
	if camera == nil then
		return
	end
	local cf = camera.CFrame
	local last: CFrame? = self.lastCFrame
	local moved = last == nil
	if last ~= nil then
		local _, angle = last:ToObjectSpace(cf):ToAxisAngle()
		moved = (cf.Position - last.Position).Magnitude &gt; MOVE_STUDS or math.abs(angle) &gt; TURN_RADIANS
	end
	if moved then
		self.lastCFrame = cf
		self.camera = { cf:GetComponents() }
		self.dirty = true
	end
end

function Capture:_disconnectWatchers()
	for _, connection in self.watchers do
		connection:Disconnect()
	end
	table.clear(self.watchers)
end

function Capture:_recordEdit(instance: Instance, property: string)
	local path = Paths.pathOf(instance)
	if path == nil then
		return
	end
	local ok, raw = pcall(function()
		return (instance :: any)[property]
	end)
	if not ok then
		return
	end
	local value = string.sub(tostring(raw), 1, VALUE_CUT)
	self.tracker:changed(path, property, value, nowMs())
end

function Capture:_watchSelection()
	self:_disconnectWatchers()
	for index, instance in Selection:Get() do
		if index &gt; MAX_WATCHED then
			break
		end
		table.insert(
			self.watchers,
			instance.Changed:Connect(function(property: string)
				self:_recordEdit(instance, property)
			end)
		)
	end
end

function Capture:state()
	local selection = {}
	for _, instance in Selection:Get() do
		if #selection &gt;= Schema.MAX_SELECTION then
			break
		end
		local path = Paths.pathOf(instance)
		if path ~= nil then
			table.insert(selection, path)
		end
	end

	local edits = self.tracker:recent(nowMs())

	local scriptPath: string? = nil
	local active = StudioService.ActiveScript
	if active ~= nil then
		scriptPath = Paths.pathOf(active)
	end

	return {
		v = Schema.VERSION,
		userId = self.userId,
		name = self.name,
		color = self.color,
		client = &quot;studio&quot;,
		camera = self.camera,
		selection = selection,
		script = scriptPath,
		edits = edits,
		seen = 0,
	}
end

function Capture:isDirty(): boolean
	return self.dirty
end

function Capture:clearDirty()
	self.dirty = false
end

function Capture:destroy()
	self:_disconnectWatchers()
	for _, connection in self.connections do
		connection:Disconnect()
	end
	table.clear(self.connections)
end

return Capture
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX4">
      <Properties>
        <string name="Name">Catchup</string>
        <ProtectedString name="Source">--!strict
--! The offline catch-up summary, mirrored from
--! crates/rbx_presence/src/catchup.rs: a value-less journal of property
--! edits, aggregated per author and in total, shown as &quot;While you were
--! away&quot; when a collaborator reconnects. Pure (no HttpService), so it runs
--! in the shared Luau golden tests and is pinned by the same
--! fixtures/catchup.json the Rust side uses.
--!
--! Neither transport carries edit *values*, and neither records instance
--! add/remove: a worker journal returns the entries directly, while ntfy's
--! retained messages are the peers' states, whose edits are lifted out here.

local Schema = require(script.Parent.Schema)

local Catchup = {}

export type JournalEntry = {
	userId: number,
	name: string,
	path: string,
	property: string,
	-- The edited value as display text (&quot;&quot; from an older peer).
	value: string?,
	at: number,
}

export type AuthorChange = {
	userId: number,
	name: string,
	instances: number,
	properties: number,
	edits: number,
}

export type Summary = {
	authors: { AuthorChange },
	instances: number,
	properties: number,
	edits: number,
}

-- Aggregates `entries`. Authors are ordered by edits descending, then name
-- case-insensitively, then user id; an author's name is the one on their
-- newest entry. `instances` counts distinct paths, `properties` distinct
-- (path, property) pairs, `edits` the entry count.
function Catchup.summarize(entries: { JournalEntry }): Summary
	local paths: { [string]: boolean } = {}
	local props: { [string]: boolean } = {}
	local pathCount, propCount = 0, 0
	type Tally = {
		name: string,
		latest: number,
		paths: { [string]: boolean },
		pathN: number,
		props: { [string]: boolean },
		propN: number,
		edits: number,
	}
	local byUser: { [number]: Tally } = {}

	local total = 0
	for _, entry in entries do
		total += 1
		if not paths[entry.path] then
			paths[entry.path] = true
			pathCount += 1
		end
		local pair = entry.path .. &quot;\0&quot; .. entry.property
		if not props[pair] then
			props[pair] = true
			propCount += 1
		end
		local tally = byUser[entry.userId]
		if not tally then
			tally = { name = entry.name, latest = entry.at, paths = {}, pathN = 0, props = {}, propN = 0, edits = 0 }
			byUser[entry.userId] = tally
		end
		if tally.edits == 0 or entry.at &gt;= tally.latest then
			tally.name = entry.name
			tally.latest = entry.at
		end
		if not tally.paths[entry.path] then
			tally.paths[entry.path] = true
			tally.pathN += 1
		end
		if not tally.props[pair] then
			tally.props[pair] = true
			tally.propN += 1
		end
		tally.edits += 1
	end

	local authors: { AuthorChange } = {}
	for userId, tally in byUser do
		table.insert(authors, {
			userId = userId,
			name = tally.name,
			instances = tally.pathN,
			properties = tally.propN,
			edits = tally.edits,
		})
	end
	table.sort(authors, function(a, b)
		if a.edits ~= b.edits then
			return a.edits &gt; b.edits
		end
		local an, bn = string.lower(a.name), string.lower(b.name)
		if an ~= bn then
			return an &lt; bn
		end
		return a.userId &lt; b.userId
	end)

	return { authors = authors, instances = pathCount, properties = propCount, edits = total }
end

-- The journal entries lifted out of a list of peer states (the
-- ntfy transport's catch-up: retained messages are the peers' states).
function Catchup.fromStates(states: { any }): { JournalEntry }
	local entries: { JournalEntry } = {}
	for _, state in states do
		for _, edit in state.edits or {} do
			table.insert(entries, {
				userId = state.userId,
				name = state.name,
				path = edit.path,
				property = edit.property,
				value = edit.value,
				at = edit.at,
			})
		end
	end
	return entries
end

-- The journal entries a relay's sealed journal reply holds, opened; entries
-- that fail to authenticate are dropped.
function Catchup.fromSealed(encKey: string, room: string, entries: { any }): { JournalEntry }
	local opened: { JournalEntry } = {}
	for _, entry in entries do
		local plain = Schema.openJournal(encKey, room, entry)
		if plain ~= nil then
			table.insert(opened, plain)
		end
	end
	return opened
end

-- One author's line: &quot;Ada made 3 edits to 2 properties across 1 instance&quot;,
-- with singulars, mirroring the rbx-native dock's wording.
function Catchup.authorLine(author: AuthorChange): string
	local function plural(n: number, one: string, many: string): string
		return if n == 1 then one else many
	end
	return string.format(
		&quot;%s made %d %s to %d %s across %d %s&quot;,
		author.name,
		author.edits,
		plural(author.edits, &quot;edit&quot;, &quot;edits&quot;),
		author.properties,
		plural(author.properties, &quot;property&quot;, &quot;properties&quot;),
		author.instances,
		plural(author.instances, &quot;instance&quot;, &quot;instances&quot;)
	)
end

return Catchup
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX5">
      <Properties>
        <string name="Name">Changes</string>
        <ProtectedString name="Source">--!strict
--! The catch-up journal as the diff window lists it: one change per
--! instance, its edited properties under it, each with who edited it and
--! when last. Pure (no Studio services), so it runs in the Luau golden tests.
--!
--! The journal records property edits only, so every change here is an
--! update; each property keeps the value its newest edit set (display text,
--! &quot;&quot; from an older peer, when the window reads the place instead).

local Paths = require(script.Parent.Paths)

local Changes = {}

export type PropertyEdit = {
	property: string,
	-- Distinct author names, most recent editor first.
	authors: { string },
	edits: number,
	at: number,
	value: string,
}

export type Change = {
	path: string,
	name: string,
	-- The parent's path, `game` for a service.
	parent: string,
	properties: { PropertyEdit },
	at: number,
}

-- Groups `entries` (Catchup.JournalEntry) by instance path. Changes are
-- ordered by their newest edit, newest first; properties by name.
function Changes.fromJournal(entries: { any }): { Change }
	local byPath: { [string]: Change } = {}
	local order: { Change } = {}
	type Tally = { edit: PropertyEdit, latest: { [string]: number } }
	local tallies: { [string]: { [string]: Tally } } = {}

	for _, entry in entries do
		local change = byPath[entry.path]
		if not change then
			local names = Paths.split(entry.path) or { entry.path }
			local name = names[#names] or entry.path
			local parentNames = table.clone(names)
			table.remove(parentNames)
			change = {
				path = entry.path,
				name = name,
				parent = if #parentNames == 0 then &quot;game&quot; else Paths.join(parentNames),
				properties = {},
				at = 0,
			}
			byPath[entry.path] = change
			tallies[entry.path] = {}
			table.insert(order, change)
		end
		local c = change :: Change
		c.at = math.max(c.at, entry.at)
		local tally = tallies[entry.path][entry.property]
		if not tally then
			tally = {
				edit = { property = entry.property, authors = {}, edits = 0, at = 0, value = &quot;&quot; },
				latest = {},
			}
			tallies[entry.path][entry.property] = tally
			table.insert(c.properties, tally.edit)
		end
		local t = tally :: Tally
		t.edit.edits += 1
		if entry.at &gt;= t.edit.at then
			t.edit.at = entry.at
			t.edit.value = entry.value or &quot;&quot;
		end
		t.latest[entry.name] = math.max(t.latest[entry.name] or 0, entry.at)
	end

	for path, byProperty in tallies do
		for _, tally in byProperty do
			local names: { string } = {}
			for name in tally.latest do
				table.insert(names, name)
			end
			table.sort(names, function(a, b)
				if tally.latest[a] ~= tally.latest[b] then
					return tally.latest[a] &gt; tally.latest[b]
				end
				return a &lt; b
			end)
			tally.edit.authors = names
		end
		table.sort(byPath[path].properties, function(a, b)
			return a.property &lt; b.property
		end)
	end

	table.sort(order, function(a, b)
		if a.at ~= b.at then
			return a.at &gt; b.at
		end
		return a.path &lt; b.path
	end)
	return order
end

-- &quot;just now&quot;, &quot;4 min ago&quot;, &quot;2 h ago&quot;, &quot;3 d ago&quot;.
function Changes.ago(at: number, now: number): string
	local seconds = math.max(0, (now - at) // 1000)
	if seconds &lt; 60 then
		return &quot;just now&quot;
	elseif seconds &lt; 3600 then
		return `{seconds // 60} min ago`
	elseif seconds &lt; 86400 then
		return `{seconds // 3600} h ago`
	end
	return `{seconds // 86400} d ago`
end

return Changes
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX6">
      <Properties>
        <string name="Name">Coedit</string>
        <ProtectedString name="Source">-- Live co-editing in Studio: captures local edits under the tracked roots
-- (CoeditCollect turns them into ops), sends them to the relay op log and
-- applies every batch of the log, our own included, in log order through
-- CoeditApply (CoeditSync does the traffic).

local Apply = require(script.Parent.CoeditApply)
local Collect = require(script.Parent.CoeditCollect)
local CoeditCore = require(script.Parent.CoeditCore)
local Kept = require(script.Parent.CoeditKept)
local Paths = require(script.Parent.Paths)
local Sync = require(script.Parent.CoeditSync)

local FLUSH_EVERY = 0.3
local POLL_EVERY = 0.5

local ROOTS = {
	&quot;Workspace&quot;,
	&quot;Lighting&quot;,
	&quot;ReplicatedFirst&quot;,
	&quot;ReplicatedStorage&quot;,
	&quot;ServerScriptService&quot;,
	&quot;ServerStorage&quot;,
	&quot;StarterGui&quot;,
	&quot;StarterPack&quot;,
	&quot;StarterPlayer&quot;,
	&quot;SoundService&quot;,
	&quot;Teams&quot;,
	&quot;Chat&quot;,
	&quot;TextChatService&quot;,
	&quot;MaterialService&quot;,
}

export type Options = {
	relay: any,
	userId: number,
	room: string,
	encKey: string,
	name: string,
	onNote: (string) -&gt; (),
}

local Coedit = {}
Coedit.__index = Coedit
Coedit.collect = Collect.collect
Coedit.send = Sync.send
Coedit.flush = Sync.flush
Coedit.authorOf = Sync.authorOf
Coedit.poll = Sync.poll

function Coedit.new(options: Options)
	local actor = string.format(&quot;%.0f&quot;, options.userId) .. &quot;:studio:&quot; .. CoeditCore.session()
	local state = {
		idOf = setmetatable({}, { __mode = &quot;k&quot; }),
		byId = setmetatable({}, { __mode = &quot;v&quot; }),
		registers = CoeditCore.Registers.new(),
		log = CoeditCore.Log.new(),
		marks = setmetatable({}, { __mode = &quot;k&quot; }),
		ignore = setmetatable({}, { __mode = &quot;k&quot; }),
		counter = 0,
	}
	return setmetatable({
		options = options,
		actor = actor,
		state = state,
		apply = Apply.new(state),
		running = false,
		connections = {} :: { RBXScriptConnection },
		watched = {} :: { [Instance]: { RBXScriptConnection } },
		tagsHooked = {} :: { [string]: boolean },
		roots = {} :: { [Instance]: boolean },
		secret = nil :: Instance?,
		added = {} :: { [Instance]: boolean },
		dirty = {} :: { [Instance]: { [string]: boolean } },
		dirtySrc = {} :: { [Instance]: boolean },
		removed = {} :: { { inst: Instance, id: string, p: string } },
		resend = {} :: { any },
		paths = setmetatable({}, { __mode = &quot;k&quot; }),
		moved = setmetatable({}, { __mode = &quot;k&quot; }),
		since = 0,
		kept = Kept.new(),
		batchCount = 0,
	}, Coedit)
end

function Coedit.note(self: any, text: string)
	pcall(self.options.onNote, text)
end

function Coedit.isTracked(self: any, inst: Instance): boolean
	local current: Instance? = inst
	while current ~= nil do
		-- The camera is each editor's own view, and holds the presence
		-- markers: none of it is shared.
		if current == self.secret or current:IsA(&quot;Camera&quot;) then
			return false
		end
		if self.roots[current] then
			return current ~= inst
		end
		current = current.Parent
	end
	return false
end

function Coedit.scriptKey(self: any, inst: Instance): string
	return Apply.keyOf(Apply.targetOf(self.state, inst))
end

function Coedit.onChanged(self: any, inst: Instance, prop: string)
	if not self.running or self.state.ignore[inst] then
		return
	end
	if prop == &quot;Name&quot; or prop == &quot;Parent&quot; then
		-- Peers find an instance whose id they don't know by its path, so a
		-- rename or move is sent at the path it had before.
		if self.moved[inst] == nil then
			self.moved[inst] = self.paths[inst]
		end
		if inst.Parent ~= nil then
			self.paths[inst] = Paths.pathOf(inst)
		end
	end
	if prop == &quot;Source&quot; then
		self.dirtySrc[inst] = true
		return
	end
	if prop ~= &quot;Name&quot; and prop ~= &quot;Parent&quot; and Apply.valueType(inst.ClassName, prop) == nil then
		return
	end
	local marks = self.state.marks[inst]
	if marks ~= nil and marks[prop] ~= nil then
		local mark = marks[prop]
		marks[prop] = nil
		if Apply.encodeProp(self.state, inst, prop) == mark then
			return
		end
	end
	if prop == &quot;Parent&quot; and (inst.Parent == nil or not self:isTracked(inst)) then
		return
	end
	local props = self.dirty[inst]
	if props == nil then
		props = {}
		self.dirty[inst] = props
	end
	props[prop] = true
end

function Coedit.watch(self: any, inst: Instance)
	if self.watched[inst] ~= nil or not self:isTracked(inst) then
		return
	end
	self.watched[inst] = {
		inst.Changed:Connect(function(prop: string)
			self:onChanged(inst, prop)
		end),
		inst.AttributeChanged:Connect(function(name: string)
			self:onChanged(inst, &quot;@&quot; .. name)
		end),
	}
	self.paths[inst] = Paths.pathOf(inst)
	if inst:IsA(&quot;LuaSourceContainer&quot;) then
		self.state.log:hash(self:scriptKey(inst), Apply.editorSource(inst))
	end
end

function Coedit.unwatch(self: any, inst: Instance)
	local conns = self.watched[inst]
	if conns ~= nil then
		for _, conn in conns do
			conn:Disconnect()
		end
		self.watched[inst] = nil
	end
end

function Coedit.onAdded(self: any, inst: Instance)
	if self.state.ignore[inst] then
		self.state.ignore[inst] = nil
		self:watch(inst)
		return
	end
	if not self:isTracked(inst) then
		return
	end
	self:watch(inst)
	self.added[inst] = true
end

function Coedit.onRemoving(self: any, inst: Instance)
	if self.state.ignore[inst] then
		self.state.ignore[inst] = nil
		self:unwatch(inst)
		return
	end
	if self.watched[inst] == nil then
		return
	end
	if self.added[inst] then
		self.added[inst] = nil
	else
		table.insert(self.removed, {
			inst = inst,
			id = self.state.idOf[inst] or &quot;&quot;,
			p = self.paths[inst] or Paths.pathOf(inst) or &quot;&quot;,
		})
	end
	self.dirty[inst] = nil
	self.dirtySrc[inst] = nil
	self:unwatch(inst)
end

function Coedit.onDocumentChanged(self: any, document: any)
	local ok, inst = pcall(function()
		if document:IsCommandBar() then
			return nil
		end
		return document:GetScript()
	end)
	if ok and inst ~= nil and self.watched[inst] ~= nil then
		self.dirtySrc[inst] = true
	end
end

function Coedit.clock(self: any): { any }
	self.state.counter += 1
	return { self.state.counter, self.actor }
end

function Coedit.start(self: any)
	if self.running then
		return
	end
	self.running = true
	self.reassembler = CoeditCore.Reassembler.new()
	local ok, secret = pcall(function()
		return game:GetService(&quot;ServerStorage&quot;):FindFirstChild(&quot;RbxNativePresence&quot;)
	end)
	self.secret = if ok then secret else nil
	for _, name in ROOTS do
		local okRoot, root = pcall(function()
			return game:GetService(name)
		end)
		if okRoot and root ~= nil then
			self.roots[root] = true
		end
	end
	for root in self.roots do
		table.insert(self.connections, root.DescendantAdded:Connect(function(d)
			if self.running then
				self:onAdded(d)
			end
		end))
		table.insert(self.connections, root.DescendantRemoving:Connect(function(d)
			if self.running then
				self:onRemoving(d)
			end
		end))
		for _, d in root:GetDescendants() do
			self:watch(d)
		end
	end
	if self.roots[game:GetService(&quot;ServerStorage&quot;)] then
		table.insert(self.connections, game:GetService(&quot;ServerStorage&quot;).ChildAdded:Connect(function(child)
			if child.Name == &quot;RbxNativePresence&quot; and self.secret == nil then
				self.secret = child
				self:unwatch(child)
				self.added[child] = nil
			end
		end))
	end
	local tags = game:GetService(&quot;CollectionService&quot;)
	local function hookTag(tag: string)
		if self.tagsHooked[tag] then
			return nil
		end
		self.tagsHooked[tag] = true
		local function changed(inst: Instance)
			if self.running and self.watched[inst] ~= nil then
				self:onChanged(inst, &quot;#&quot; .. tag)
			end
		end
		table.insert(self.connections, tags:GetInstanceAddedSignal(tag):Connect(changed))
		table.insert(self.connections, tags:GetInstanceRemovedSignal(tag):Connect(changed))
		return changed
	end
	for _, tag in tags:GetAllTags() do
		hookTag(tag)
	end
	-- A tag's first use fires TagAdded only after the instance has it, so
	-- the instances already tagged are picked up here.
	table.insert(self.connections, tags.TagAdded:Connect(function(tag: string)
		local changed = hookTag(tag)
		if changed ~= nil then
			for _, inst in tags:GetTagged(tag) do
				changed(inst)
			end
		end
	end))
	pcall(function()
		local editor = game:GetService(&quot;ScriptEditorService&quot;)
		table.insert(self.connections, editor.TextDocumentDidChange:Connect(function(document)
			if self.running then
				self:onDocumentChanged(document)
			end
		end))
	end)
	task.spawn(function()
		while self.running do
			task.wait(FLUSH_EVERY)
			if self.running then
				local okFlush, flushErr = pcall(self.flush, self)
				if not okFlush then
					self:note(&quot;Co-edit: &quot; .. tostring(flushErr))
				end
			end
		end
	end)
	task.spawn(function()
		while self.running do
			local okPoll, pollErr = pcall(self.poll, self)
			if not okPoll then
				self:note(&quot;Co-edit: &quot; .. tostring(pollErr))
			end
			task.wait(POLL_EVERY)
		end
	end)
end

function Coedit.stop(self: any)
	self.running = false
	for _, conn in self.connections do
		conn:Disconnect()
	end
	self.connections = {}
	for _, conns in self.watched do
		for _, conn in conns do
			conn:Disconnect()
		end
	end
	self.watched = {}
	self.tagsHooked = {}
	self.roots = {}
	self.added = {}
	self.dirty = {}
	self.dirtySrc = {}
	self.removed = {}
end

return Coedit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX7">
      <Properties>
        <string name="Name">CoeditApply</string>
        <ProtectedString name="Source">-- Applies co-edit batches from the relay log to the place, in log order,
-- inside one undo recording per batch. Shares `state` with Coedit.luau:
-- idOf/byId identity maps, LWW registers, the script text log, echo marks
-- and the set of instances whose add/remove events must be ignored.

local CoeditClasses = require(script.Parent.CoeditClasses)
local CoeditCore = require(script.Parent.CoeditCore)
local CoeditValue = require(script.Parent.CoeditValue)
local Json = require(script.Parent.Json)
local Paths = require(script.Parent.Paths)

local EXISTS = &quot;\0exists&quot;

local Apply = {}
Apply.__index = Apply

-- Attributes travel as `@&lt;name&gt;` and tags as `#&lt;tag&gt;` (one property each,
-- see crates/rbx_presence/src/coedit/attrs.rs); an absent one is `null`.
function Apply.isEntry(prop: string): boolean
	local first = string.sub(prop, 1, 1)
	return first == &quot;@&quot; or first == &quot;#&quot;
end

function Apply.valueType(className: string, prop: string): string?
	if Apply.isEntry(prop) then
		return &quot;Attribute&quot;
	end
	local cls = CoeditClasses[className]
	while cls ~= nil do
		local t = cls.p and cls.p[prop]
		if t ~= nil then
			return t
		end
		cls = cls.s and CoeditClasses[cls.s] or nil
	end
	if prop == &quot;Parent&quot; then
		return &quot;Ref&quot;
	elseif prop == &quot;Name&quot; then
		return &quot;String&quot;
	end
	return nil
end

-- Every scripting property of the class, inherited ones included.
function Apply.propsOf(className: string): { [string]: string }
	local out: { [string]: string } = {}
	local cls = CoeditClasses[className]
	while cls ~= nil do
		if cls.p then
			for prop, t in cls.p do
				if out[prop] == nil then
					out[prop] = t
				end
			end
		end
		cls = cls.s and CoeditClasses[cls.s] or nil
	end
	return out
end

function Apply.targetOf(state: any, inst: Instance): { id: string, p: string }
	return { id = state.idOf[inst] or &quot;&quot;, p = Paths.pathOf(inst) or &quot;&quot; }
end

function Apply.resolve(state: any, target: any): Instance?
	if type(target) ~= &quot;table&quot; then
		return nil
	end
	local id = type(target.id) == &quot;string&quot; and target.id or &quot;&quot;
	local inst = if id ~= &quot;&quot; then state.byId[id] else nil
	if inst == nil and type(target.p) == &quot;string&quot; and target.p ~= &quot;&quot; then
		inst = Paths.resolve(game, target.p)
	end
	if inst ~= nil and id ~= &quot;&quot; then
		state.idOf[inst] = id
		state.byId[id] = inst
	end
	return inst
end

function Apply.keyOf(target: any): string
	local id = type(target.id) == &quot;string&quot; and target.id or &quot;&quot;
	if id ~= &quot;&quot; then
		return id
	end
	return &quot;p:&quot; .. tostring(target.p or &quot;&quot;)
end

-- The property's current value as a JSON string, the form echo marks hold.
local function read(inst: Instance, prop: string): (boolean, any)
	local first, rest = string.sub(prop, 1, 1), string.sub(prop, 2)
	if first == &quot;@&quot; then
		return pcall(inst.GetAttribute, inst, rest)
	elseif first == &quot;#&quot; then
		return true, if inst:HasTag(rest) then true else nil
	end
	return pcall(function()
		return (inst :: any)[prop]
	end)
end

function Apply.encodeProp(state: any, inst: Instance, prop: string): string?
	local ok, value = read(inst, prop)
	if not ok then
		return nil
	end
	if value == nil and Apply.isEntry(prop) then
		return &quot;null&quot;
	end
	local encoded = CoeditValue.encode(value, Apply.valueType(inst.ClassName, prop), function(i: Instance)
		return Apply.targetOf(state, i)
	end)
	if encoded == nil then
		return nil
	end
	local okJson, text = pcall(Json.encode, encoded)
	return if okJson then text else nil
end

function Apply.mark(state: any, inst: Instance, prop: string, encoded: string)
	local marks = state.marks[inst]
	if marks == nil then
		marks = {}
		state.marks[inst] = marks
	end
	marks[prop] = encoded
end

function Apply.editorSource(inst: Instance): string
	local ok, text = pcall(function()
		return game:GetService(&quot;ScriptEditorService&quot;):GetEditorSource(inst)
	end)
	if ok and type(text) == &quot;string&quot; then
		return text
	end
	local okSource, source = pcall(function()
		return (inst :: any).Source
	end)
	return if okSource and type(source) == &quot;string&quot; then source else &quot;&quot;
end

function Apply.writeSource(state: any, inst: Instance, text: string)
	Apply.mark(state, inst, &quot;Source&quot;, text)
	local ok = pcall(function()
		game:GetService(&quot;ScriptEditorService&quot;):UpdateSourceAsync(inst, function()
			return text
		end)
	end)
	if not ok then
		pcall(function()
			(inst :: any).Source = text
		end)
	end
end

function Apply.new(state: any)
	return setmetatable({ state = state }, Apply)
end

local function assign(inst: Instance, prop: string, value: any): boolean
	local first, rest = string.sub(prop, 1, 1), string.sub(prop, 2)
	if first == &quot;@&quot; then
		return pcall(inst.SetAttribute, inst, rest, value)
	elseif first == &quot;#&quot; then
		return pcall(if value then inst.AddTag else inst.RemoveTag, inst, rest)
	end
	return pcall(function()
		(inst :: any)[prop] = value
	end)
end

local function writeProp(state: any, inst: Instance, prop: string, json: any, notes: { string }): boolean
	local _, current = read(inst, prop)
	local ok, value = true, nil
	if not (Apply.isEntry(prop) and json == Json.null) then
		ok, value = CoeditValue.decode(json, current, Apply.valueType(inst.ClassName, prop), function(t)
			return Apply.resolve(state, t)
		end)
	end
	if not ok then
		table.insert(notes, string.format(&quot;Co-edit: could not read %s.%s&quot;, inst:GetFullName(), prop))
		return false
	end
	local okSet = assign(inst, prop, value)
	if not okSet then
		return false
	end
	local encoded = Apply.encodeProp(state, inst, prop)
	if encoded ~= nil then
		Apply.mark(state, inst, prop, encoded)
	end
	return true
end

local function ignoreSubtree(state: any, inst: Instance)
	state.ignore[inst] = true
	for _, d in inst:GetDescendants() do
		state.ignore[d] = true
	end
end

function Apply.batch(self: any, batch: any, own: boolean, authorName: string)
	local state = self.state
	local notes: { string } = {}
	local resend: { any } = {}
	local applied = 0
	local history = game:GetService(&quot;ChangeHistoryService&quot;)
	local okRec, recording = pcall(function()
		return history:TryBeginRecording(&quot;Co-edit&quot;, &quot;Co-edit from &quot; .. authorName)
	end)
	if not okRec then
		recording = nil
	end

	for _, op in (type(batch.ops) == &quot;table&quot; and batch.ops or {}) do
		if type(op) ~= &quot;table&quot; or type(op.c) ~= &quot;table&quot; or type(op.c[1]) ~= &quot;number&quot; then
			continue
		end
		state.counter = math.max(state.counter or 0, op.c[1])
		local target = { id = op.id or &quot;&quot;, p = op.p or &quot;&quot; }
		local key = Apply.keyOf(target)
		local inst = Apply.resolve(state, target)
		if op.k == &quot;set&quot; and type(op.n) == &quot;string&quot; then
			if state.registers:claim(key .. &quot;\0&quot; .. op.n, op.c) and not own then
				if inst == nil then
					table.insert(notes, &quot;Co-edit: no instance at &quot; .. tostring(op.p))
				elseif op.v ~= nil and writeProp(state, inst, op.n, op.v, notes) then
					applied += 1
				end
			end
		elseif op.k == &quot;add&quot; and type(op.cls) == &quot;string&quot; then
			if state.registers:claim(key .. &quot;\0&quot; .. EXISTS, op.c) and not own then
				local exists = target.id ~= &quot;&quot; and state.byId[target.id] ~= nil
				local parent = if type(op.parent) == &quot;table&quot; then Apply.resolve(state, op.parent) else nil
				if not exists and parent ~= nil then
					local okNew, created = pcall(Instance.new, op.cls)
					if okNew then
						state.ignore[created] = true
						if target.id ~= &quot;&quot; then
							state.idOf[created] = target.id
							state.byId[target.id] = created
						end
						local source: string? = nil
						for prop, value in (type(op.props) == &quot;table&quot; and op.props or {}) do
							if prop == &quot;Parent&quot; then
								continue
							elseif prop == &quot;Source&quot; and type(value) == &quot;table&quot; and type(value.v) == &quot;string&quot; then
								source = value.v
							end
							writeProp(state, created, prop, value, notes)
						end
						if source ~= nil then
							state.log:hash(key, source)
						end
						local okParent = pcall(function()
							created.Parent = parent
						end)
						if okParent then
							applied += 1
						else
							state.ignore[created] = nil
							created:Destroy()
							table.insert(notes, &quot;Co-edit: could not add &quot; .. op.cls .. &quot; at &quot; .. tostring(op.p))
						end
					else
						table.insert(notes, &quot;Co-edit: Studio cannot create &quot; .. op.cls)
					end
				elseif not exists then
					table.insert(notes, &quot;Co-edit: no parent for &quot; .. tostring(op.p))
				end
			end
		elseif op.k == &quot;del&quot; then
			if state.registers:claim(key .. &quot;\0&quot; .. EXISTS, op.c) and not own and inst ~= nil then
				ignoreSubtree(state, inst)
				if pcall(inst.Destroy, inst) then
					applied += 1
				end
			end
		elseif op.k == &quot;src&quot; and type(op.text) == &quot;string&quot; and type(op.base) == &quot;string&quot; then
			if inst ~= nil and inst:IsA(&quot;LuaSourceContainer&quot;) then
				local current = Apply.editorSource(inst)
				local result = state.log:src(key, current, op, own)
				if result.write ~= nil then
					Apply.writeSource(state, inst, result.write)
					applied += 1
				end
				if result.conflicted then
					table.insert(notes, &quot;Co-edit: conflicting edits merged with markers in &quot; .. inst:GetFullName())
				end
				if result.resend ~= nil then
					local logged = state.log.texts[key] or current
					table.insert(resend, {
						k = &quot;src&quot;,
						id = target.id,
						p = target.p,
						base = CoeditCore.textHash(logged),
						text = result.resend,
					})
				end
			elseif inst == nil then
				table.insert(notes, &quot;Co-edit: no script at &quot; .. tostring(op.p))
			end
		end
	end

	if recording ~= nil then
		pcall(function()
			history:FinishRecording(
				recording,
				if applied &gt; 0 then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel
			)
		end)
	end
	return { applied = applied, notes = notes, resend = resend }
end

return Apply
