        <string name="Name">Config</string>
        <ProtectedString name="Source">--!strict
-- The donation place's settings. Product ids come from the experience's
-- developer products (donations/README.md lists them); prices come from
-- Roblox at run time.
return {
	-- The quick buttons, cheapest first. One button each.
	products = { 3733101617, 3733101622, 3733101623, 3733101624, 3733101628 } :: { number },
	-- Price -&gt; product id, for a custom amount. Roblox can only charge a
	-- product's own price, so a custom amount is split into these (biggest
	-- first) and bought one after another.
	denominations = {
		[1] = 3733110798,
		[2] = 3733110804,
		[5] = 3733110807,
		[10] = 3733110812,
		[20] = 3733110816,
		[50] = 3733110819,
		[100] = 3733101622,
		[200] = 3733110823,
		[500] = 3733101623,
		[1000] = 3733101624,
		[2000] = 3733110826,
		[5000] = 3733101628,
		[10000] = 3733110832,
	} :: { [number]: number },
	-- Most purchases one custom amount may take.
	maxSplit = 8,
	-- How many donors the board lists (Roblox reads at most 100 at once).
	boardSize = 100,
	-- How often the server re-reads the board, in seconds.
	boardEvery = 60,
	-- Background music: &quot;Calm down, everything is fine. (ambient)&quot; by
	-- DistrokidOfficial, licensed for any experience.
	music = &quot;rbxassetid://93955641826556&quot;,
	musicVolume = 0.35,
}
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX6">
